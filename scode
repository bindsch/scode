error() {
  printf '%b%s%b\n' "${RED}${PROGRAM_NAME}: " "$(terminal_escape "$*")" "${NC}" >&2
}

warning() {
  printf '%b%s%b\n' "${YELLOW}${PROGRAM_NAME}: " "$(terminal_escape "$*")" "${NC}" >&2
}

info() {
  printf '%b%s%b\n' "${GREEN}${PROGRAM_NAME}: " "$(terminal_escape "$*")" "${NC}" >&2
}

# Ensure the parent directory for a log file exists.
ensure_log_parent_dir() {
  local log_file="$1"
  if [[ -d "$log_file" && ! -L "$log_file" ]]; then
    error "log path is a directory: ${log_file}"
    exit 1
  fi
  local log_dir
  log_dir="$(dirname "${log_file}")"
  if [[ -d "${log_dir}" ]]; then
    return 0
  fi
  if ! mkdir -p "${log_dir}"; then
    error "failed to create log directory: ${log_dir}"
    exit 1
  fi
}

# Run a command and mirror its stderr to both terminal and log file without
# process substitution (works in restricted runtimes where /dev/fd is blocked).
run_with_stderr_log() {
  local log_file="$1"
  shift

  if ! { : >&9; } 2>/dev/null; then
    error "log descriptor is not open: ${log_file}"
    return 1
  fi

  local tmp_dir
  if ! tmp_dir="$(mktemp -d "/tmp/scode-log.XXXXXX")"; then
    error "failed to create temporary log directory"
    exec 9>&-
    return 1
  fi

  local stderr_pipe="${tmp_dir}/stderr.pipe"
  if ! mkfifo "${stderr_pipe}"; then
    error "failed to create temporary stderr pipe"
    rmdir "${tmp_dir}" 2>/dev/null || true
    exec 9>&-
    return 1
  fi

  # write_log_header_json opened fd 9 on the same temporary inode before
  # installing it at log_file. Stream through that descriptor so a sandboxed
  # command cannot redirect logging by replacing the path.
  tee /dev/fd/9 < "${stderr_pipe}" >&2 &
  local tee_pid=$!

  local rc=0
  local signal_rc=0
  local command_pid=""
  "$@" 2>"${stderr_pipe}" &
  command_pid=$!

  # Bash defers traps while waiting on a foreground command. Running the
  # sandbox engine as a child lets us forward termination promptly and reap
  # both the engine and logger before returning the conventional signal code.
  trap 'signal_rc=130; kill -INT "$command_pid" "$tee_pid" 2>/dev/null || true' INT
  trap 'signal_rc=143; kill -TERM "$command_pid" "$tee_pid" 2>/dev/null || true' TERM
  trap 'signal_rc=129; kill -HUP "$command_pid" "$tee_pid" 2>/dev/null || true' HUP

  if wait "${command_pid}"; then
    rc=0
  else
    rc=$?
  fi
  if [[ "$signal_rc" -ne 0 ]]; then
    wait "${command_pid}" 2>/dev/null || true
    rc="$signal_rc"
  fi

  local tee_rc=0
  if wait "${tee_pid}"; then
    tee_rc=0
  else
    tee_rc=$?
  fi
  if [[ "$tee_rc" -ne 0 && "$signal_rc" -eq 0 ]]; then
    error "log writer failed — requested log is incomplete"
    [[ "$rc" -eq 0 ]] && rc=1
  fi
  exec 9>&-
  rm -f "${stderr_pipe}"
  rmdir "${tmp_dir}" 2>/dev/null || true
  trap - INT TERM HUP
  return "${rc}"
}

# sandbox-exec has no close-fds option. Start it through a fixed privileged Bash
# that closes every inherited descriptor except standard input/output/error,
# then replaces itself with the engine. The -c program is a trusted constant;
# all engine/profile/command values remain positional argv entries.
run_macos_sandbox_engine() {
  # shellcheck disable=SC2016  # expanded by the fixed inner Bash, not this one
  /usr/bin/env "PATH=${SCODE_CALLER_PATH}" /bin/bash -p -c '
    for fd_path in /dev/fd/[0-9]*; do
      fd=${fd_path##*/}
      case "$fd" in 0|1|2) continue ;; esac
      [[ "$fd" =~ ^[0-9]+$ ]] || continue
      eval "exec ${fd}>&-"
    done
    exec "$@"
  ' scode-fd-guard "$@"
}

# Check if arg is a known harness
is_known_harness() {
  local cmd="${1##*/}"
  for h in "${KNOWN_HARNESSES[@]}"; do
    [[ "$cmd" == "$h" ]] && return 0
  done
  return 1
}

_strip_outer_quotes() {
  local tok="$1"
  if [[ ${#tok} -ge 2 ]]; then
    local first="${tok:0:1}"
    local last="${tok: -1}"
    if [[ ("$first" == '"' && "$last" == '"') || ("$first" == "'" && "$last" == "'") ]]; then
      printf '%s\n' "${tok:1:${#tok}-2}"
      return
    fi
  fi
  printf '%s\n' "$tok"
}

_is_assignment_token() {
  local tok
  tok="$(_strip_outer_quotes "$1")"
  [[ "$tok" =~ ^[A-Za-z_][A-Za-z_0-9]*=.*$ ]]
}

_is_timeout_duration_token() {
  local tok="$1"
  [[ "$tok" =~ ^([0-9]+([.][0-9]+)?|[.][0-9]+)[sSmMhHdD]?$ || "$tok" =~ ^inf(inity)?$ ]]
}

_is_taskset_mask_token() {
  local tok="$1"
  [[ "$tok" =~ ^0x[0-9A-Fa-f]+$ || "$tok" =~ ^[0-9]+$ || "$tok" =~ ^[0-9]+(-[0-9]+)?(,[0-9]+(-[0-9]+)?)*$ ]]
}

_should_consume_wrapper_positional() {
  local wrapper="$1"
  local tok="$2"
  case "$wrapper" in
    nice)
      [[ "$tok" =~ ^[-+]?[0-9]+$ ]]
      ;;
    timeout)
      _is_timeout_duration_token "$tok"
      ;;
    taskset)
      _is_taskset_mask_token "$tok"
      ;;
    *)
      return 1
      ;;
  esac
}

# Split a shell command string into tokens without executing it.
# Handles quotes, backslash escapes, and shell control operators.
SHELL_SPLIT_WORDS=()
_shell_split_words() {
  local input="$1"
  SHELL_SPLIT_WORDS=()
  local token=""
  local in_single=0
  local in_double=0
  local escaped=0
  local i ch next

  for (( i=0; i<${#input}; i++ )); do
    ch="${input:$i:1}"

    if [[ "$escaped" -eq 1 ]]; then
      token+="$ch"
      escaped=0
      continue
    fi

    if [[ "$in_single" -eq 1 ]]; then
      token+="$ch"
      [[ "$ch" == "'" ]] && in_single=0
      continue
    fi

    if [[ "$in_double" -eq 1 ]]; then
      token+="$ch"
      if [[ "$ch" == "\\" ]]; then
        escaped=1
      elif [[ "$ch" == '"' ]]; then
        in_double=0
      fi
      continue
    fi

    case "$ch" in
      [[:space:]])
        if [[ -n "$token" ]]; then
          SHELL_SPLIT_WORDS+=("$token")
          token=""
        fi
        ;;
      "'")
        token+="$ch"
        in_single=1
        ;;
      '"')
        token+="$ch"
        in_double=1
        ;;
      "\\")
        token+="$ch"
        escaped=1
        ;;
      "&"|"|")
        if [[ -n "$token" ]]; then
          SHELL_SPLIT_WORDS+=("$token")
          token=""
        fi
        next="${input:$((i + 1)):1}"
        if [[ "$next" == "$ch" ]]; then
          SHELL_SPLIT_WORDS+=("${ch}${ch}")
          (( i++ ))
        else
          SHELL_SPLIT_WORDS+=("$ch")
        fi
        ;;
      ";"|"("|")")
        if [[ -n "$token" ]]; then
          SHELL_SPLIT_WORDS+=("$token")
          token=""
        fi
        SHELL_SPLIT_WORDS+=("$ch")
        ;;
      *)
        token+="$ch"
        ;;
    esac
  done

  if [[ -n "$token" ]]; then
    SHELL_SPLIT_WORDS+=("$token")
  fi
}

# Detect harness from argv-like tokens. Checks argv[0] first; if it is a
# transparent wrapper (env, timeout, etc.) it resolves the wrapped command.
# Does NOT scan arbitrary arguments — `echo claude` won't trigger.
_detect_harness_from_args() {
  local -a argv=("$@")
  [[ ${#argv[@]} -eq 0 ]] && return 1

  # Skip leading passthrough shell keywords and assignment prefixes.
  local start=0
  while [[ $start -lt ${#argv[@]} ]]; do
    local tok
    tok="$(_strip_outer_quotes "${argv[$start]}")"
    if [[ "$tok" == "--" ]]; then
      (( start++ )); continue
    fi
    if [[ "$tok" == "exec" ]]; then
      (( start++ )); continue
    fi
    _is_assignment_token "$tok" && { (( start++ )); continue; }
    break
  done
  [[ $start -ge ${#argv[@]} ]] && return 1

  # Rebuild argv past any exec/assignment prefix
  if [[ $start -gt 0 ]]; then
    argv=("${argv[@]:$start}")
  fi

  local base
  base="$(_strip_outer_quotes "${argv[0]}")"
  base="${base##*/}"
  if is_known_harness "$base"; then
    echo "$base"
    return 0
  fi

  # Shell wrappers execute the argument following a -c-style flag. Resolve
  # that command string here so wrapper recursion (env/nice -> shell) works.
  case "$base" in
    sh|bash|zsh|dash|ksh)
      local shell_i
      for (( shell_i=1; shell_i<${#argv[@]}; shell_i++ )); do
        local shell_tok="${argv[$shell_i]}"
        if [[ "$shell_tok" =~ ^-[A-Za-z]*c[A-Za-z]*$ ]]; then
          local shell_cmd_i=$((shell_i + 1))
          if [[ "$shell_cmd_i" -lt ${#argv[@]} && "${argv[$shell_cmd_i]}" == "--" ]]; then
            (( shell_cmd_i++ ))
          fi
          [[ "$shell_cmd_i" -ge ${#argv[@]} ]] && break
          _shell_split_words "${argv[$shell_cmd_i]}"
          if [[ ${#SHELL_SPLIT_WORDS[@]} -gt 0 ]] && \
             _detect_harness_from_shell_words "${SHELL_SPLIT_WORDS[@]}"; then
            return 0
          fi
          break
        fi
      done
      ;;
  esac

  # Transparent wrappers: the real command is the next positional arg.
  # Skip flags, assignments, and wrapper-specific positional args to find it.
  case "$base" in
    env)
      # env supports KEY=VALUE, flags, and flags-with-values (-u VAR, -S STR).
      local i
      for (( i=1; i<${#argv[@]}; i++ )); do
        local tok
        tok="$(_strip_outer_quotes "${argv[$i]}")"
        if [[ "$tok" == "--" ]]; then
          (( i++ ))
          if [[ $i -lt ${#argv[@]} ]]; then
            if _detect_harness_from_args "${argv[@]:$i}"; then
              return 0
            fi
          fi
          break
        fi
        case "$tok" in -u|--unset|-S|--split-string) (( i++ )); continue ;; esac
        [[ "$tok" == -* ]] && continue
        _is_assignment_token "$tok" && continue
        if _detect_harness_from_args "${argv[@]:$i}"; then
          return 0
        fi
        break
      done
      ;;
    nice|time|timeout|stdbuf|command|ionice|taskset)
      # Wrappers that may take flags-with-values or a positional arg before
      # the real command. Mirror the logic in no-sandbox.js.
      local i consumed_positional=0
      for (( i=1; i<${#argv[@]}; i++ )); do
        local tok
        tok="$(_strip_outer_quotes "${argv[$i]}")"
        if [[ "$tok" == "--" ]]; then
          (( i++ ))
          # timeout and taskset still require their duration/mask positional
          # after the option delimiter.
          if [[ $i -lt ${#argv[@]} && ( "$base" == "timeout" || "$base" == "taskset" ) ]] && \
             _should_consume_wrapper_positional "$base" "$(_strip_outer_quotes "${argv[$i]}")"; then
            (( i++ ))
          fi
          if [[ $i -lt ${#argv[@]} ]]; then
            if _detect_harness_from_args "${argv[@]:$i}"; then
              return 0
            fi
          fi
          break
        fi
        # ionice: -c/--class/--classdata take a value argument
        case "$base" in
          ionice) case "$tok" in -c|--class|--classdata) (( i++ )); continue ;; esac ;;
        esac
        # Common wrapper flags with values (-n, -k, -s, etc.)
        # Note: -p is NOT here — command/time/timeout treat -p as boolean.
        # sudo has its own handling in its dedicated case branch.
        case "$tok" in -n|--adjustment|-k|--kill-after|-s|--signal) (( i++ )); continue ;; esac
        [[ "$tok" == -* ]] && continue
        if [[ "$consumed_positional" -eq 0 ]] && _should_consume_wrapper_positional "$base" "$tok"; then
          consumed_positional=1
          continue
        fi
        if _detect_harness_from_args "${argv[@]:$i}"; then
          return 0
        fi
        break
      done
      ;;
  esac

  return 1
}

# Detect harness in shell command words by scanning each command segment
# separated by shell control operators (&&, ||, ;, |, &, parentheses).
_detect_harness_from_shell_words() {
  local -a words=("$@")
  [[ ${#words[@]} -eq 0 ]] && return 1

  local -a segment=()
  local tok
  for tok in "${words[@]}"; do
    if [[ "$tok" == "&&" || "$tok" == "||" || "$tok" == "|" || "$tok" == ";" || "$tok" == "&" || "$tok" == "(" || "$tok" == ")" ]]; then
      if [[ ${#segment[@]} -gt 0 ]]; then
        if _detect_harness_from_args "${segment[@]}"; then
          return 0
        fi
        segment=()
      fi
      continue
    fi
    segment+=("$tok")
  done

  if [[ ${#segment[@]} -gt 0 ]]; then
    if _detect_harness_from_args "${segment[@]}"; then
      return 0
    fi
  fi
  return 1
}

# Detect harness from COMMAND. Checks direct/wrapper forms, and shell wrappers
# (bash/sh/zsh -c "...") so strict auto-allow works for common launch patterns.
detect_harness() {
  if _detect_harness_from_args "${COMMAND[@]}"; then
    return 0
  fi

  local base="${COMMAND[0]##*/}"
  case "$base" in
    sh|bash|zsh|dash|ksh)
      local i
      for (( i=1; i<${#COMMAND[@]}; i++ )); do
        local tok="${COMMAND[$i]}"
        # Shell command string flag forms: -c, -lc, -ic, etc.
        if [[ "$tok" =~ ^-[A-Za-z]*c[A-Za-z]*$ ]]; then
          local cmd_idx=$((i + 1))
          # Skip optional -- between -c and the command string
          if [[ "$cmd_idx" -lt ${#COMMAND[@]} && "${COMMAND[$cmd_idx]}" == "--" ]]; then
            (( cmd_idx++ ))
          fi
          [[ "$cmd_idx" -ge ${#COMMAND[@]} ]] && break
          local shell_cmd="${COMMAND[$cmd_idx]}"
          _shell_split_words "$shell_cmd"
          if [[ ${#SHELL_SPLIT_WORDS[@]} -gt 0 ]]; then
            if _detect_harness_from_shell_words "${SHELL_SPLIT_WORDS[@]}"; then
              return 0
            fi
          fi
          break
        fi
      done
      ;;
  esac

  return 1
}

# Populate HARNESS_CONFIG_PATHS with a harness's default user config/state paths.
get_harness_config_paths() {
  HARNESS_CONFIG_PATHS=()
  case "$1" in
    opencode)     HARNESS_CONFIG_PATHS=("$HOME/.config/opencode" "$HOME/.local/share/opencode") ;;
    claude)       HARNESS_CONFIG_PATHS=("$HOME/.claude") ;;
    codex)        HARNESS_CONFIG_PATHS=("$HOME/.codex") ;;
    goose)        HARNESS_CONFIG_PATHS=("$HOME/.config/goose") ;;
    gemini)       HARNESS_CONFIG_PATHS=("$HOME/.gemini") ;;
    droid)        HARNESS_CONFIG_PATHS=("$HOME/.factory") ;;
    qwen)         HARNESS_CONFIG_PATHS=("$HOME/.qwen") ;;
    codemux)      HARNESS_CONFIG_PATHS=("$HOME/.codemux" "$HOME/.config/codemux") ;;
    pi)           HARNESS_CONFIG_PATHS=("$HOME/.pi/agent") ;;
    aider)        HARNESS_CONFIG_PATHS=("$HOME/.aider" "$HOME/.aider.conf.yml") ;;
    amp)          HARNESS_CONFIG_PATHS=("$HOME/.config/amp" "$HOME/.amp") ;;
    crush)        HARNESS_CONFIG_PATHS=("$HOME/.config/crush" "$HOME/.local/share/crush") ;;
    cursor-agent) HARNESS_CONFIG_PATHS=("$HOME/.cursor") ;;
    copilot)      HARNESS_CONFIG_PATHS=("$HOME/.copilot" "$HOME/.cache/copilot") ;;
    cn)           HARNESS_CONFIG_PATHS=("$HOME/.continue") ;;
    kimi)         HARNESS_CONFIG_PATHS=("$HOME/.kimi-code" "$HOME/.kimi") ;;
    openhands)    HARNESS_CONFIG_PATHS=("$HOME/.openhands") ;;
    cline)        HARNESS_CONFIG_PATHS=("$HOME/.cline") ;;
    kiro-cli)     HARNESS_CONFIG_PATHS=("$HOME/.kiro") ;;
    auggie)       HARNESS_CONFIG_PATHS=("$HOME/.augment") ;;
    # Environment-controlled config roots are not auto-allowed: GROK_HOME=/
    # must never turn strict mode into a full-filesystem allow. A non-default
    # location requires an explicit --allow from the caller.
    grok)         HARNESS_CONFIG_PATHS=("$HOME/.grok") ;;
    *)            return 1 ;;
  esac
}

_contains_control_character() {
  local LC_ALL=C
  [[ "$1" =~ [[:cntrl:]] ]]
}

# Validate a path is safe for use in sandbox profiles and terminal output.
# NUL bytes cannot exist in bash variables; all other control bytes are rejected.
validate_path() {
  local p="$1"
  if [[ -z "$p" ]]; then
    error "invalid path (empty)"
    exit 1
  fi
  if _contains_control_character "$p"; then
    error "invalid path (contains control characters)"
    exit 1
  fi
}

# Escape a path for safe interpolation into SBPL (sandbox-exec) profiles.
# SBPL strings are "double-quoted"; backslash and double-quote need escaping.
sbpl_escape() {
  local p="$1"
  validate_path "$p"
  p="${p//\\/\\\\}"
  p="${p//\"/\\\"}"
  printf '%s\n' "$p"
}

# Expand ~ and resolve path in the current shell context.
# Used for --cwd, --config, --log, and SCODE_CONFIG.
expand_path() {
  local p="$1"
  validate_path "$p"
  if [[ "$p" =~ ^~(/|$) ]]; then
    p="${HOME}${p:1}"
  fi
  if [[ "$p" != /* ]]; then
    p="${PWD}/${p}"
  fi
  _realpath "$p"
}

# Resolve an output path without following its final component. Log creation
# must be able to replace a pre-existing symlink instead of truncating its target.
expand_output_path() {
  local p="$1"
  validate_path "$p"
  if [[ "$p" =~ ^~(/|$) ]]; then
    p="${HOME}${p:1}"
  fi
  if [[ "$p" != /* ]]; then
    p="${PWD}/${p}"
  fi
  local parent base
  parent="$(_realpath "$(dirname "$p")")"
  base="$(basename "$p")"
  printf '%s/%s\n' "${parent%/}" "$base"
}

# Resolve sandbox access paths (--block/--allow and config blocked/allowed).
# Relative paths are anchored to PROJECT_DIR so results do not depend on caller PWD.
resolve_access_path() {
  local p="$1"
  local base_dir="$2"
  validate_path "$p"
  if [[ "$p" =~ ^~(/|$) ]]; then
    p="${HOME}${p:1}"
  elif [[ "$p" != /* ]]; then
    p="${base_dir}/${p}"
  fi
  p="$(_realpath "$p")"
  normalize_match_path "$p"
}

# Parse a scalar/list YAML value with optional inline comments.
# Rules:
# - Unquoted: strip " <spaces>#comment" and trailing whitespace.
# - Double-quoted: keep literal content (including " # "), allow trailing comment.
# - Single-quoted: keep literal content (including " # "), allow trailing comment.
# Returns non-zero for malformed quoted values.
parse_yaml_value() {
  local raw="$1"
  local double_quoted_re='^"(([^"\\]|\\.)*)"[[:space:]]*(#.*)?$'
  local single_quoted_re="^'(([^']|'')*)'[[:space:]]*(#.*)?$"

  # Keep behavior stable for list parsing where leading whitespace can be present.
  raw="${raw#"${raw%%[![:space:]]*}"}"

  if [[ "$raw" == \"* ]]; then
    if [[ "$raw" =~ $double_quoted_re ]]; then
      printf '%s\n' "${BASH_REMATCH[1]}"
      return 0
    fi
    return 1
  fi

  if [[ "$raw" == \'* ]]; then
    if [[ "$raw" =~ $single_quoted_re ]]; then
      local _sqval="${BASH_REMATCH[1]}"
      _sqval="$(printf '%s' "$_sqval" | /usr/bin/sed "s/''/'/g")"
      printf '%s\n' "$_sqval"
      return 0
    fi
    return 1
  fi

  raw="${raw%%[[:space:]]#*}"
  raw="${raw%"${raw##*[![:space:]]}"}"
  printf '%s\n' "$raw"
}

# Parse YAML config (simple key: value and list parsing).
# Usage: parse_config <file> <prefix>
#   Writes scalars to <PREFIX>_NET, <PREFIX>_STRICT, etc.
#   Appends list items to <PREFIX>_BLOCKED and <PREFIX>_ALLOWED arrays.
# Safety: eval is used below to set dynamic variables (for example,
# CONFIG_NET or PROJECT_STRICT). The prefix is always a hardcoded literal
# ("CONFIG" or "PROJECT") passed by the
# caller, and val/value are validated against fixed sets or path-sanitized.
# No user-controlled data reaches the eval target variable name.
parse_config() {
  local cfg_file="$1"
  local prefix="$2"
  local cfg_fd="${3:-}"
  local cfg_input="$cfg_file"

  if [[ -z "$cfg_fd" && ! -f "${cfg_file}" ]]; then
    return
  fi
  if [[ -n "$cfg_fd" ]]; then
    cfg_input="/dev/fd/${cfg_fd}"
  fi

  local cfg_size
  if [[ -n "$cfg_fd" ]]; then
    cfg_size="$(stat -f '%z' "$cfg_input" 2>/dev/null || stat -Lc '%s' "$cfg_input" 2>/dev/null || true)"
  else
    cfg_size="$(/usr/bin/wc -c < "${cfg_file}" | tr -d '[:space:]')"
  fi
  if [[ ! "$cfg_size" =~ ^[0-9]+$ || "$cfg_size" -gt "$MAX_CONFIG_FILE_BYTES" ]]; then
    error "config file exceeds ${MAX_CONFIG_FILE_BYTES} bytes: ${cfg_file}"
    exit 1
  fi

  local current_section=""
  local line_no=0
  while IFS= read -r line || [[ -n "$line" ]]; do
    line_no=$((line_no + 1))
    # Strip trailing carriage return (CRLF files)
    line="${line%$'\r'}"
    [[ "$line" =~ ^[[:space:]]*# ]] && continue
    [[ -z "${line//[[:space:]]/}" ]] && continue

    if [[ "$line" =~ ^[[:space:]]*([a-z_]+):[[:space:]]*(#.*)?$ ]]; then
      current_section="${BASH_REMATCH[1]}"
      case "$current_section" in
        blocked|allowed) ;;
        *)
          error "invalid config at line ${line_no}: unknown section '${current_section}' (${cfg_file})"
          exit 1
          ;;
      esac
      continue
    fi

    # Scalar key: value (e.g., net: off, strict: true)
    # Parsed regardless of current_section so scalars work after list blocks.
    if [[ "$line" =~ ^[[:space:]]*([a-z_]+):[[:space:]]+(.+)$ ]]; then
      local key="${BASH_REMATCH[1]}"
      local val="${BASH_REMATCH[2]}"
      if ! val="$(parse_yaml_value "$val")"; then
        error "invalid config at line ${line_no}: malformed quoted value (${cfg_file})"
        exit 1
      fi
      case "$key" in
        net)
          case "$val" in
            on|off) eval "${prefix}_NET=\"$val\"" ;;
            *) error "invalid config: net: $val (expected 'on' or 'off') (${cfg_file})"; exit 1 ;;
          esac
          ;;
        fs_mode)
          case "$val" in
            rw|ro) eval "${prefix}_FS_MODE=\"$val\"" ;;
            *) error "invalid config: fs_mode: $val (expected 'rw' or 'ro') (${cfg_file})"; exit 1 ;;
          esac
          ;;
        strict)
          case "$val" in
            true|false)
              if [[ "$val" == "true" ]]; then
                eval "${prefix}_STRICT=1"
              else
                eval "${prefix}_STRICT=0"
              fi
              ;;
            *) error "invalid config: strict: $val (expected 'true' or 'false') (${cfg_file})"; exit 1 ;;
          esac
          ;;
        scrub_env)
          case "$val" in
            true|false)
              if [[ "$val" == "true" ]]; then
                eval "${prefix}_SCRUB_ENV=1"
              else
                eval "${prefix}_SCRUB_ENV=0"
              fi
              ;;
            *) error "invalid config: scrub_env: $val (expected 'true' or 'false') (${cfg_file})"; exit 1 ;;
          esac
          ;;
        grok_defense)
          case "$val" in
            true|false)
              if [[ "$val" == "true" ]]; then
                eval "${prefix}_GROK_DEFENSE=1"
              else
                eval "${prefix}_GROK_DEFENSE=0"
              fi
              ;;
            *) error "invalid config: grok_defense: $val (expected 'true' or 'false') (${cfg_file})"; exit 1 ;;
          esac
          ;;
        *)
          error "invalid config at line ${line_no}: unknown key '${key}' (${cfg_file})"
          exit 1
          ;;
      esac
      current_section=""
      continue
    fi

    if [[ "$line" =~ ^[[:space:]]*-[[:space:]]*(.+)$ ]]; then
      if [[ -z "$current_section" ]]; then
        error "invalid config at line ${line_no}: list item outside a section (${cfg_file})"
        exit 1
      fi
      local value="${BASH_REMATCH[1]}"
      # Trim leading whitespace first so comment-only list items are detected.
      value="${value#"${value%%[![:space:]]*}"}"
      if [[ "$value" =~ ^# ]]; then
        value=""
      else
        if [[ "$value" != \"* && "$value" != \'* && "$value" == *[[:space:]]#* ]]; then
          error "invalid config at line ${line_no}: unquoted list item contains ' #' (quote the value to include '#') (${cfg_file})"
          exit 1
        fi
        if ! value="$(parse_yaml_value "$value")"; then
          error "invalid config at line ${line_no}: malformed quoted list item (${cfg_file})"
          exit 1
        fi
      fi
      if [[ -z "$value" ]]; then
        error "invalid config at line ${line_no}: empty list item (${cfg_file})"
        exit 1
      fi
      validate_path "$value"
      # Safe: \$value defers expansion past eval; value is never interpolated during eval.
      # Scalars above are validated against fixed sets before eval.
      case "$current_section" in
        blocked)
          eval "${prefix}_BLOCKED+=(\"\$value\")"
          ;;
        allowed)
          eval "${prefix}_ALLOWED+=(\"\$value\")"
          ;;
      esac
      continue
    fi

    error "invalid config at line ${line_no}: unsupported syntax (${cfg_file})"
    exit 1
  done < "${cfg_input}"
}

# Check whether a path is covered by an allow list.
# Firewall-style behavior: allowing a parent path allows all descendants.
is_allowed_in_list() {
  local check="$1"
  shift
  local a
  for a in "$@"; do
    [[ -z "$a" ]] && continue
    if is_same_or_descendant_path "$check" "$a"; then
      return 0
    fi
  done
  return 1
}

# Any allow (config or CLI)
is_allowed() {
  [[ ${ALL_ALLOWED[0]+_} ]] || return 1
  is_allowed_in_list "$1" "${ALL_ALLOWED[@]}"
}

# CLI allow only (used to keep CLI --block higher precedence than config allows)
is_cli_allowed() {
  [[ ${#RESOLVED_CLI_ALLOWED[@]} -eq 0 ]] && return 1
  is_allowed_in_list "$1" "${RESOLVED_CLI_ALLOWED[@]}"
}

# Scrub sensitive env vars
scrub_env() {
  local scrubbed=()
  local varname pattern
  while IFS= read -r varname; do
    [[ -z "$varname" ]] && continue
    for pattern in "${SCRUB_PATTERNS[@]}"; do
      # shellcheck disable=SC2053
      [[ "$varname" == $pattern ]] || continue
      local already=0 existing
      for existing in "${scrubbed[@]+"${scrubbed[@]}"}"; do
        if [[ "$existing" == "$varname" ]]; then
          already=1
          break
        fi
      done
      if [[ "$already" -eq 0 ]]; then
        scrubbed+=("$varname")
        unset "$varname" 2>/dev/null || true
      fi
      break
    done
  done < <(compgen -e || true)
  if [[ ${#scrubbed[@]} -gt 0 ]]; then
    warning "scrubbed env vars: ${scrubbed[*]}"
  fi
}

# Escape a string for JSON value embedding (no surrounding quotes).
# Handles backslash, double quote, and C0 control characters (U+0001–U+001F)
# as required by RFC 8259 §7. U+0000 (NUL) cannot appear in bash strings.
json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"        # backslash first (before other escapes add backslashes)
  s="${s//\"/\\\"}"        # double quote
  s="${s//$'\n'/\\n}"      # newline
  s="${s//$'\r'/\\r}"      # carriage return
  s="${s//$'\t'/\\t}"      # tab
  s="${s//$'\b'/\\b}"      # backspace
  s="${s//$'\f'/\\f}"      # form feed
  # Remaining C0 controls (0x00-0x1F) that lack short escapes → \uXXXX
  local result="" i ch ord hex
  for (( i=0; i<${#s}; i++ )); do
    ch="${s:i:1}"
    printf -v ord '%d' "'$ch"
    if (( ord >= 0 && ord <= 0x1F )); then
      printf -v hex '\\u%04x' "$ord"
      result+="$hex"
    else
      result+="$ch"
    fi
  done
  printf '%s' "$result"
}

# Escape controls for the human-readable single-line log header without
# otherwise changing ordinary quotes or backslashes.
legacy_log_escape() {
  terminal_escape "$1"
}

# Write a JSON header line to the log file, followed by the legacy comment
# header. The JSON line is prefixed with `#json:` so it's treated as a comment
# by the legacy parser (starts with `#`, not matching any metadata pattern).
# External tools can read it with: head -1 log | sed 's/^#json://' | jq .
#
# Usage: write_log_header_json <log_file> [extra_comment_lines...]
# Expects these globals: REQUESTED_COMMAND[], PROJECT_DIR, ALL_BLOCKED[],
# ALL_BLOCKED_SOURCES[], ALL_ALLOWED[], HARNESS_STRICT_RO[]
write_log_header_json() {
  local log_file="$1"
  shift
  local timestamp command_str command_legacy cwd_str log_dir tmp_log

  timestamp="$(date '+%Y-%m-%dT%H:%M:%S%z')"
  command_str="$(json_escape "${REQUESTED_COMMAND[*]}")"
  command_legacy="$(legacy_log_escape "${REQUESTED_COMMAND[*]}")"
  cwd_str="$(json_escape "${PROJECT_DIR}")"

  log_dir="$(dirname "${log_file}")"
  if ! tmp_log="$(umask 077; mktemp "${log_dir}/.scode-log.XXXXXX")"; then
    error "failed to create log file in: ${log_dir}"
    return 1
  fi

  if ! {
    # JSON header line
    printf '#json:{"version":1,"session":"%s","command":"%s","argv":[' \
      "$timestamp" "$command_str"
    local argv_first=1
    for _arg in "${REQUESTED_COMMAND[@]}"; do
      [[ "$argv_first" -eq 1 ]] && argv_first=0 || printf ','
      printf '"%s"' "$(json_escape "$_arg")"
    done
    printf '],"cwd":"%s"' "$cwd_str"

    # blocked array
    printf ',"blocked":['
    local first=1
    for _i in "${!ALL_BLOCKED[@]}"; do
      [[ "$first" -eq 1 ]] && first=0 || printf ','
      printf '{"source":"%s","path":"%s"}' \
        "$(json_escape "${ALL_BLOCKED_SOURCES[$_i]}")" \
        "$(json_escape "${ALL_BLOCKED[$_i]}")"
    done
    printf ']'

    # allowed array
    printf ',"allowed":['
    first=1
    for _i in "${!ALL_ALLOWED[@]}"; do
      [[ "$first" -eq 1 ]] && first=0 || printf ','
      printf '"%s"' "$(json_escape "${ALL_ALLOWED[$_i]}")"
    done
    for _i in "${!HARNESS_STRICT_RO[@]}"; do
      [[ "$first" -eq 1 ]] && first=0 || printf ','
      printf '"%s"' "$(json_escape "${HARNESS_STRICT_RO[$_i]}")"
    done
    printf ']'

    printf '}\n'

    # Legacy comment header (human-readable, parsed by audit_log/audit_watch)
    echo "# scode session: ${timestamp}"
    echo "# command: ${command_legacy}"
    echo "# cwd: ${PROJECT_DIR}"
    for _i in "${!ALL_BLOCKED[@]}"; do
      echo "# blocked: ${ALL_BLOCKED_SOURCES[$_i]} ${ALL_BLOCKED[$_i]}"
    done
    for _i in "${!ALL_ALLOWED[@]}"; do
      echo "# allowed: ${ALL_ALLOWED[$_i]}"
    done
    for _i in "${!HARNESS_STRICT_RO[@]}"; do
      echo "# allowed: ${HARNESS_STRICT_RO[$_i]}"
    done

    # Extra comment lines (e.g. profile dump, bwrap args)
    for _line in "$@"; do
      echo "$_line"
    done

    echo "#---"
  } > "$tmp_log"; then
    rm -f "$tmp_log"
    error "failed to write log header: ${log_file}"
    return 1
  fi

  if ! chmod 600 "$tmp_log"; then
    rm -f "$tmp_log"
    error "failed to secure log file permissions: ${log_file}"
    return 1
  fi
  # Keep an append descriptor on the exact inode that will become log_file.
  # This removes the path lookup between header installation and stderr
  # streaming, closing the symlink-replacement race against the child process.
  if ! exec 9>>"$tmp_log"; then
    rm -f "$tmp_log"
    error "failed to open log file: ${log_file}"
    return 1
  fi
  # GNU mv uses -T and BSD mv uses -h to replace a destination symlink itself
  # instead of treating its target as the destination.
  if mv -fT "$tmp_log" "$log_file" 2>/dev/null; then
    :
  elif mv -fh "$tmp_log" "$log_file" 2>/dev/null; then
    :
  else
    exec 9>&-
    rm -f "$tmp_log"
    error "failed to install log file: ${log_file}"
    return 1
  fi
  if [[ ! -f "$log_file" || -L "$log_file" ]]; then
    exec 9>&-
    error "log destination changed during installation: ${log_file}"
    return 1
  fi
}

# Extract a denied path from a single log line. Prints the path on match,
# nothing on no match. Shared by audit_log and audit_watch.
_extract_denied_path() {
  local line="$1"
  # macOS sandbox-exec: deny(file-read-data) /path/to/file
  if [[ "$line" =~ deny\(file-[a-z*-]+\)[[:space:]]+(.+) ]]; then
    printf '%s\n' "${BASH_REMATCH[1]}"
  # Generic Unix:
  #   /path/to/file: Permission denied
  #   cat: /path/to/file: Permission denied
  elif [[ "$line" =~ ^(([^:]+):[[:space:]]+)?(.+):[[:space:]]*Permission\ denied$ ]]; then
    printf '%s\n' "${BASH_REMATCH[3]}"
  # Generic Unix:
  #   /path/to/file: Operation not permitted
  #   tool: /path/to/file: Operation not permitted
  elif [[ "$line" =~ ^(([^:]+):[[:space:]]+)?(.+):[[:space:]]*Operation\ not\ permitted$ ]]; then
    printf '%s\n' "${BASH_REMATCH[3]}"
  # Node.js EACCES: permission denied, open '/path/to/file'
  elif [[ "$line" =~ permission\ denied,\ [a-z]+\ \'(.+)\' ]]; then
    printf '%s\n' "${BASH_REMATCH[1]}"
  # Python OSError: Permission denied: '/path/to/file'
  elif [[ "$line" =~ Permission\ denied:\ \'(.+)\' ]]; then
    printf '%s\n' "${BASH_REMATCH[1]}"
  fi
}

# Normalize denied paths for audit categorization:
# - trims surrounding whitespace
# - resolves relative paths against log header "# cwd:" when available
_normalize_denied_path() {
  local path="$1"
  local log_cwd="${2:-}"

  path="${path#"${path%%[![:space:]]*}"}"
  path="${path%"${path##*[![:space:]]}"}"
  [[ -z "$path" ]] && return 1
  _contains_control_character "$path" && return 1

  if [[ "$path" =~ ^~(/|$) ]]; then
    path="${HOME}${path:1}"
  fi
  if [[ "$path" != /* ]]; then
    [[ -n "$log_cwd" && "$log_cwd" == /* ]] || return 1
    if [[ "$path" == ./* ]]; then
      path="${path#./}"
    fi
    path="${log_cwd%/}/${path}"
  fi
  _contains_control_character "$path" && return 1
  _realpath "$path"
}

# Parse denial patterns from a log file, categorize against blocked lists,
# and suggest --allow flags. Uses indexed arrays only (bash 3.2 compat).
# If the log contains "# blocked:" metadata, uses that for categorization
# instead of built-in defaults, enabling policy-aware audit output.
audit_log() {
  local log_file="$1"
  if [[ ! -f "$log_file" ]]; then
    error "log file not found: $log_file"
    return 1
  fi
  if [[ ! -s "$log_file" ]]; then
    error "log file is empty: $log_file"
    return 1
  fi

  # Collect unique denied paths
  local denied_paths=()
  local seen_paths=()
  local line _cwd_candidate _aval

  # Parse "# blocked:" metadata from log header (if present)
  local log_blocked_cats=()
  local log_allowed=()
  local has_log_blocked=0
  local log_cwd=""
  while IFS= read -r line; do
    # Stop scanning at the header delimiter
    [[ "$line" == "#---" ]] && break
    # Stop at first non-comment line
    [[ "$line" != \#* ]] && break
    if [[ "$line" =~ ^#\ cwd:\ (.+)$ ]]; then
      _cwd_candidate="${BASH_REMATCH[1]}"
      if [[ "$_cwd_candidate" == /* ]] && ! _contains_control_character "$_cwd_candidate"; then
        log_cwd="$_cwd_candidate"
      fi
    fi
    if [[ "$line" =~ ^#\ blocked:\ (default|platform|config|project|cli|defense)\ (.+)$ ]]; then
      local src="${BASH_REMATCH[1]}"
      local bpath="${BASH_REMATCH[2]}"
      [[ "$bpath" == /* ]] || continue
      _contains_control_character "$bpath" && continue
      bpath="$(_realpath "$bpath")"
      # Map config/project/cli sources to "custom" category
      local cat="$src"
      if [[ "$src" == "config" || "$src" == "project" || "$src" == "cli" || "$src" == "defense" ]]; then
        cat="custom"
      fi
      log_blocked_cats+=("${cat}:${bpath}")
      has_log_blocked=1
    fi
    if [[ "$line" =~ ^#\ allowed:\ (.+)$ ]]; then
      _aval="${BASH_REMATCH[1]}"
      [[ "$_aval" == /* ]] || continue
      _contains_control_character "$_aval" && continue
      _aval="${_aval%/}"
      _aval="$(_realpath "$_aval")"
      log_allowed+=("$_aval")
    fi
  done < "$log_file"

  while IFS= read -r line; do
    local path=""
    path="$(_extract_denied_path "$line")"

    # Skip empty/invalid paths.
    [[ -z "$path" ]] && continue
    path="$(_normalize_denied_path "$path" "$log_cwd")" || continue

    local already_seen=0
    for s in "${seen_paths[@]+"${seen_paths[@]}"}"; do
      if [[ "$s" == "$path" ]]; then
        already_seen=1
        break
      fi
    done
    [[ "$already_seen" -eq 1 ]] && continue

    seen_paths+=("$path")
    denied_paths+=("$path")
  done < "$log_file"

  if [[ ${#denied_paths[@]} -eq 0 ]]; then
    info "no denial patterns found in $log_file"
    return 0
  fi

  # Build combined blocked list for categorization.
  # If log has "# blocked:" metadata, use it; otherwise fall back to built-in defaults.
  local all_blocked_cats=()
  if [[ "$has_log_blocked" -eq 1 ]]; then
    all_blocked_cats=("${log_blocked_cats[@]}")
  else
    for dir in "${DEFAULT_BLOCKED[@]}"; do
      all_blocked_cats+=("default:$dir")
    done
    if [[ "$PLATFORM" == "darwin" ]]; then
      for dir in "${DARWIN_EXTRA_BLOCKED[@]}"; do
        all_blocked_cats+=("platform:$dir")
      done
    elif [[ "$PLATFORM" == "linux" ]]; then
      for dir in "${LINUX_EXTRA_BLOCKED[@]}"; do
        all_blocked_cats+=("platform:$dir")
      done
    fi
  fi

  # Categorize each denied path
  local cat_default=()
  local cat_custom=()
  local uncategorized=()
  for path in "${denied_paths[@]}"; do
    # Prefer custom policy matches over default/platform matches.
    # Within each class, use the most specific (longest) matching parent.
    local matched_custom=""
    local matched_default_parent=""
    local matched_default_cat=""
    for entry in "${all_blocked_cats[@]}"; do
      local cat="${entry%%:*}"
      local bdir="${entry#*:}"
      if is_same_or_descendant_path "$path" "$bdir"; then
        if [[ "$cat" == "custom" ]]; then
          if [[ -z "$matched_custom" || ${#bdir} -gt ${#matched_custom} ]]; then
            matched_custom="$bdir"
          fi
        else
          if [[ -z "$matched_default_parent" || ${#bdir} -gt ${#matched_default_parent} ]]; then
            matched_default_parent="$bdir"
            matched_default_cat="$cat"
          fi
        fi
      fi
    done

    # If metadata says this path is allowed, do not classify it as blocked by
    # default/platform ancestors. Keep custom-block precedence.
    if [[ "$has_log_blocked" -eq 1 && ${#log_allowed[@]} -gt 0 ]]; then
      if [[ -z "$matched_custom" ]] && is_allowed_in_list "$path" "${log_allowed[@]}"; then
        uncategorized+=("$path")
        continue
      fi
    fi

    if [[ -n "$matched_custom" ]]; then
      cat_custom+=("custom${AUDIT_RECORD_SEPARATOR}${matched_custom}${AUDIT_RECORD_SEPARATOR}${path}")
    elif [[ -n "$matched_default_parent" ]]; then
      cat_default+=("${matched_default_cat}${AUDIT_RECORD_SEPARATOR}${matched_default_parent}${AUDIT_RECORD_SEPARATOR}${path}")
    else
      uncategorized+=("$path")
    fi
  done

  # Print summary
  echo ""
  echo "=== scode audit: ${#denied_paths[@]} unique denied path(s) ==="
  echo ""

  if [[ ${#cat_default[@]} -gt 0 ]]; then
    echo "Blocked by scode defaults:"
    # Group by blocked parent (global dedup, not just adjacent)
    local seen_default_parents=()
    for entry in "${cat_default[@]}"; do
      local cat parent path
      IFS="$AUDIT_RECORD_SEPARATOR" read -r cat parent path <<< "$entry"
      local parent_seen=0
      for s in "${seen_default_parents[@]+"${seen_default_parents[@]}"}"; do
        [[ "$s" == "$parent" ]] && { parent_seen=1; break; }
      done
      if [[ "$parent_seen" -eq 0 ]]; then
        echo "  ${parent} (${cat}):"
        seen_default_parents+=("$parent")
      fi
      echo "    $path"
    done
    echo ""
    echo "Suggested --allow flags:"
    for dir in "${seen_default_parents[@]}"; do
      printf '  --allow %q\n' "$dir"
    done
  fi

  if [[ ${#cat_custom[@]} -gt 0 ]]; then
    echo ""
    echo "Blocked by custom policy:"
    local seen_custom_parents=()
    for entry in "${cat_custom[@]}"; do
      local _category parent path
      IFS="$AUDIT_RECORD_SEPARATOR" read -r _category parent path <<< "$entry"
      local parent_seen=0
      for s in "${seen_custom_parents[@]+"${seen_custom_parents[@]}"}"; do
        [[ "$s" == "$parent" ]] && { parent_seen=1; break; }
      done
      if [[ "$parent_seen" -eq 0 ]]; then
        echo "  ${parent}:"
        seen_custom_parents+=("$parent")
      fi
      echo "    $path"
    done
    # No --allow suggestions for custom-blocked paths — the user blocked them intentionally.
  fi

  if [[ ${#uncategorized[@]} -gt 0 ]]; then
    echo ""
    echo "Not covered by scode defaults (sandbox or OS-level denials):"
    for path in "${uncategorized[@]}"; do
      echo "  $path"
    done
    echo ""
    echo "Suggested --allow flags:"
    for path in "${uncategorized[@]}"; do
      printf '  --allow %q\n' "$path"
    done
  fi

  if [[ ${#uncategorized[@]} -gt 0 ]]; then
    echo ""
    if [[ "$has_log_blocked" -eq 1 ]]; then
      echo "Note: these paths were not in the logged blocked list. They may be"
      echo "OS-level denials or the log metadata may be incomplete."
    else
      echo "Note: audit only considers scode built-in defaults. If you intentionally"
      echo "blocked custom paths (via --block or config), review suggestions carefully."
    fi
  fi

  echo ""
  return 0
}

# Watch a log file for denial patterns in real-time.
# Deduplicates paths across the session; Ctrl-C to stop.
audit_watch() {
  local log_file="$1"
  if [[ ! -f "$log_file" ]]; then
    error "log file not found: $log_file"
    return 1
  fi

  # Snapshot before parsing metadata so a line appended during parsing is not
  # mistaken for pre-existing content and skipped.
  local initial_line_count
  initial_line_count="$(wc -l < "$log_file" | tr -d '[:space:]')"
  [[ "$initial_line_count" =~ ^[0-9]+$ ]] || initial_line_count=0

  # Parse "# cwd:" metadata from log header (same as audit_log).
  local log_cwd=""
  local line
  while IFS= read -r line; do
    [[ "$line" == "#---" ]] && break
    [[ "$line" != \#* ]] && break
    if [[ "$line" =~ ^#\ cwd:\ (.+)$ ]]; then
      log_cwd="${BASH_REMATCH[1]}"
    fi
  done < "$log_file"

  local seen_paths=()
  local count=0
  info "watching $log_file for denial patterns (Ctrl-C to stop)..."
  echo ""

  # Follow only lines appended after the snapshot above. `tail -n 0` has a
  # race between metadata parsing and opening the file; starting at the first
  # post-snapshot line closes that gap. -F follows rotation by name.
  tail -n "+$((initial_line_count + 1))" -F "$log_file" | while IFS= read -r line; do
    local path=""
    path="$(_extract_denied_path "$line")"

    [[ -z "$path" ]] && continue
    path="$(_normalize_denied_path "$path" "$log_cwd")" || continue

    local already_seen=0
    for s in "${seen_paths[@]+"${seen_paths[@]}"}"; do
      if [[ "$s" == "$path" ]]; then
        already_seen=1
        break
      fi
    done
    [[ "$already_seen" -eq 1 ]] && continue

    seen_paths+=("$path")
    count=$((count + 1))
    echo "[${count}] DENIED: ${path}"
  done
}

# Seatbelt uses last-match precedence. Reassert custom blocks after broad
# carve-outs/automatic allows, then restore only authoritative CLI/user child
# allows. Finally cap the project at read-only when requested.
emit_macos_final_guards() {
  local project_dir="$1"
  local fs_mode="$2"
  local emitted=0 i dir source bdir under_custom esc_dir esc_project

  for i in "${!ALL_BLOCKED[@]}"; do
    source="${ALL_BLOCKED_SOURCES[$i]}"
    case "$source" in config|project|cli|defense) ;; *) continue ;; esac
    if [[ "$emitted" -eq 0 ]]; then
      echo ""
      echo "; Final custom-policy blocks"
      emitted=1
    fi
    esc_dir="$(sbpl_escape "${ALL_BLOCKED[$i]}")"
    cat <<EOF
(deny file-read* file-write* process-exec
  (subpath "${esc_dir}")
)
EOF
  done

  if [[ "$emitted" -eq 1 && ${ALL_ALLOWED[0]+_} ]]; then
    for i in "${!ALL_ALLOWED[@]}"; do
      source="${ALL_ALLOWED_SOURCES[$i]}"
      case "$source" in cli|config) ;; *) continue ;; esac
      dir="${ALL_ALLOWED[$i]}"
      under_custom=0
      for bdir in "${ALL_BLOCKED[@]}"; do
        if is_descendant_path "$dir" "$bdir"; then
          under_custom=1
          break
        fi
      done
      [[ "$under_custom" -eq 0 ]] && continue
      esc_dir="$(sbpl_escape "$dir")"
      cat <<EOF
(allow file-read* file-write* process-exec
  (subpath "${esc_dir}")
)
EOF
    done
  fi

  if [[ "$fs_mode" == "ro" ]]; then
    esc_project="$(sbpl_escape "$project_dir")"
    cat <<EOF

; Final read-only project invariant
(deny file-write*
  (subpath "${esc_project}")
)
EOF
  fi
}

# Generate macOS sandbox profile (default mode: allow default, deny specific)
generate_profile() {
  local project_dir="$1"
  local fs_mode="$2"
  local net_mode="$3"
  shift 3
  local -a blocked=()
  if [[ $# -gt 0 ]]; then
    blocked=("$@")
  fi

  cat <<EOF
(version 1)

; Allow everything by default, then deny specific things
(allow default)

; Network
EOF

  if [[ "$net_mode" != "on" ]]; then
    cat <<EOF
; Network disabled
(deny network*)
EOF
  fi

  # Privilege escalation prevention
  cat <<'EOF'

; Privilege escalation prevention
(deny process-exec (regex #"(/|^)(sudo|su|login|doas|pkexec)$"))
EOF

  # Read-only project
  if [[ "$fs_mode" == "ro" ]]; then
    local esc_project
    esc_project="$(sbpl_escape "$project_dir")"
    cat <<EOF

; Project directory is read-only
(deny file-write*
  (subpath "${esc_project}")
)
EOF
  fi

  # Blocked directories
  if [[ ${#blocked[@]} -gt 0 ]]; then
    echo ""
    echo "; Blocked directories"
    for dir in "${blocked[@]}"; do
      if [[ -n "$dir" ]]; then
        local esc_dir
        esc_dir="$(sbpl_escape "$dir")"
        cat <<EOF
(deny file-read* file-write* process-exec
  (subpath "${esc_dir}")
)
EOF
      fi
    done
  fi

  # macOS ~/Library carve-outs: re-allow specific subdirs after the
  # blanket ~/Library deny. In sandbox-exec, later rules override earlier ones.
  if [[ "$PLATFORM" == "darwin" ]]; then
    # Only emit carve-outs if ~/Library is actually blocked
    local library_blocked=0
    if [[ ${#blocked[@]} -gt 0 ]]; then
      for dir in "${blocked[@]}"; do
        [[ "$dir" == "$HOME/Library" ]] && library_blocked=1 && break
      done
    fi
    if [[ "$library_blocked" -eq 1 && $(( ${#DARWIN_LIBRARY_ALLOWED_RW[@]} + ${#DARWIN_LIBRARY_ALLOWED_RO[@]} )) -gt 0 ]]; then
      echo ""
      echo "; ~/Library carve-outs (read-write)"
      for dir in ${DARWIN_LIBRARY_ALLOWED_RW[@]+"${DARWIN_LIBRARY_ALLOWED_RW[@]}"}; do
        if ! is_allowed "$dir"; then
          local esc_dir
          esc_dir="$(sbpl_escape "$dir")"
          cat <<EOF
(allow file-read* file-write* process-exec
  (subpath "${esc_dir}")
)
EOF
        fi
      done
      echo ""
      echo "; ~/Library carve-outs (read-only)"
      for dir in ${DARWIN_LIBRARY_ALLOWED_RO[@]+"${DARWIN_LIBRARY_ALLOWED_RO[@]}"}; do
        if ! is_allowed "$dir"; then
          local esc_dir
          esc_dir="$(sbpl_escape "$dir")"
          cat <<EOF
(allow file-read* process-exec
  (subpath "${esc_dir}")
)
EOF
        fi
      done
    fi
  fi

  # Project directory override: if the project dir falls under a blocked
  # parent (e.g. ~/Documents/myproject), re-allow it here. In sandbox-exec,
  # later rules override earlier ones. Skip if no blocked dirs exist.
  # After re-allowing the project subtree, any blocked[] entries that fall
  # under project_dir are re-denied so --block on project subdirs still works.
  if [[ ${#blocked[@]} -gt 0 ]]; then
    local under_block=0
    for bdir in "${blocked[@]}"; do
      if [[ "$project_dir" == "$bdir"/* || "$project_dir" == "$bdir" ]]; then
        under_block=1
        break
      fi
    done
    if [[ "$under_block" -eq 1 ]]; then
      local esc_project
      esc_project="$(sbpl_escape "$project_dir")"
      if [[ "$fs_mode" == "ro" ]]; then
        cat <<EOF

; Project directory (override blocked parent, read-only)
(allow file-read* process-exec
  (subpath "${esc_project}")
)
EOF
      else
        cat <<EOF

; Project directory (override blocked parent)
(allow file-read* file-write* process-exec
  (subpath "${esc_project}")
)
EOF
      fi
      # Re-deny blocked subdirectories within the project (later rules win)
      for bdir in "${blocked[@]}"; do
        if [[ "$bdir" == "$project_dir"/* ]]; then
          local esc_bdir
          esc_bdir="$(sbpl_escape "$bdir")"
          cat <<EOF
(deny file-read* file-write* process-exec
  (subpath "${esc_bdir}")
)
EOF
        fi
      done
    fi
  fi

  # User-specified --allow overrides: re-allow child paths that fall under
  # blocked parents. In sandbox-exec, later rules override earlier ones.
  # Only emit when the allowed path is actually under a blocked ancestor
  # (otherwise it's already allowed by the default-allow policy).
  if [[ ${ALL_ALLOWED[0]+_} && ${blocked[0]+_} ]]; then
    local emitted_header=0
    for dir in "${ALL_ALLOWED[@]}"; do
      [[ -z "$dir" ]] && continue
      # Check if this allowed path falls under any blocked dir
      local under_block=0
      for bdir in "${blocked[@]}"; do
        if [[ "$dir" == "$bdir"/* ]]; then
          under_block=1
          break
        fi
      done
      if [[ "$under_block" -eq 1 ]]; then
        if [[ "$emitted_header" -eq 0 ]]; then
          echo ""
          echo "; Explicitly allowed directories (override blocked parents)"
          emitted_header=1
        fi
        local esc_dir
        esc_dir="$(sbpl_escape "$dir")"
        cat <<EOF
(allow file-read* file-write* process-exec
  (subpath "${esc_dir}")
)
EOF
      fi
    done
  fi

  emit_macos_final_guards "$project_dir" "$fs_mode"
}

# Generate macOS sandbox profile (strict mode: deny default, allow specific)
generate_strict_profile() {
  local project_dir="$1"
  local fs_mode="$2"
  local net_mode="$3"
  shift 3
  local -a blocked=()
  if [[ $# -gt 0 ]]; then
    blocked=("$@")
  fi

  cat <<EOF
(version 1)

; Strict mode: deny by default, allow only essentials
(deny default)
; Baseline runtime allowances needed for stable process startup on modern macOS.
(import "system.sb")

; System essentials (read-only)
(allow file-read*
  (subpath "/usr")
  (subpath "/opt")
  (subpath "/System")
  (subpath "/Library")
  (subpath "/private/var/db")
  (subpath "/private/var/run")
  (subpath "/private/var/select")
  (subpath "/private/etc")
  (subpath "/dev")
  (subpath "/bin")
  (subpath "/sbin")
  (subpath "/etc")
)

; Allow process execution
(allow process-exec)
(allow process-fork)

; Privilege escalation prevention
(deny process-exec (regex #"(/|^)(sudo|su|login|doas|pkexec)$"))

; Runtime compatibility services. system.sb and the blanket Mach lookup remain
; a documented limitation of Apple's deprecated sandbox-exec interface.
(allow sysctl-read)
(allow mach-lookup)

; Shared temp storage is denied; a private per-invocation directory is allowed
; below after this parent rule.
(deny file-read* file-write*
  (subpath "/tmp")
  (subpath "/private/tmp")
)
EOF

  if [[ -n "${SAFE_DARWIN_TMPDIR:-}" ]]; then
    local esc_tmpdir
    esc_tmpdir="$(sbpl_escape "$SAFE_DARWIN_TMPDIR")"
    cat <<EOF
(allow file-read* file-write*
  (subpath "${esc_tmpdir}")
)
EOF
  fi

  # Project directory
  local esc_project
  esc_project="$(sbpl_escape "$project_dir")"
  if [[ "$fs_mode" == "ro" ]]; then
    cat <<EOF

; Project directory (read-only)
(allow file-read*
  (subpath "${esc_project}")
)
EOF
  else
    cat <<EOF

; Project directory (read-write)
(allow file-read* file-write*
  (subpath "${esc_project}")
)
EOF
  fi

  # Network
  if [[ "$net_mode" == "on" ]]; then
    cat <<EOF

; Network access
(allow network*)
EOF
  fi

  # Allow only the exact preload file; exposing the containing directory would
  # reopen sibling files hidden by a custom block.
  if [[ -n "${SCODE_NO_SANDBOX_JS:-}" && -f "${SCODE_NO_SANDBOX_JS}" ]]; then
    local esc_preload
    esc_preload="$(sbpl_escape "$SCODE_NO_SANDBOX_JS")"
    cat <<EOF

; scode Node.js preload (read-only)
(allow file-read*
  (literal "${esc_preload}")
)
EOF
  fi

  # Blocked directories — emitted BEFORE allows so that later allow rules
  # take precedence (sandbox-exec "later rules win" semantics).  This lets
  # --allow children of a blocked parent work correctly.
  if [[ ${#blocked[@]} -gt 0 ]]; then
    local emitted_header=0
    local i source
    for i in "${!blocked[@]}"; do
      dir="${blocked[$i]}"
      [[ -z "$dir" ]] && continue
      source="${ALL_BLOCKED_SOURCES[$i]:-default}"
      case "$source" in config|project|cli|defense) ;; *) continue ;; esac
      if [[ "$emitted_header" -eq 0 ]]; then
        echo ""
        echo "; Blocked directories"
        emitted_header=1
      fi
      local esc_dir
      esc_dir="$(sbpl_escape "$dir")"
      cat <<EOF
(deny file-read* file-write* process-exec
  (subpath "${esc_dir}")
)
EOF
    done
  fi

  # Allowed directories (explicit overrides — emitted after blocked so they win)
  if [[ ${ALL_ALLOWED[0]+_} ]]; then
    echo ""
    echo "; Explicitly allowed directories"
    for dir in "${ALL_ALLOWED[@]}"; do
      if [[ -n "$dir" ]]; then
        local esc_dir
        esc_dir="$(sbpl_escape "$dir")"
        cat <<EOF
(allow file-read* file-write* process-exec
  (subpath "${esc_dir}")
)
EOF
      fi
    done
  fi

  # Reserved for narrowly scoped harness read-only directories.
  if [[ ${HARNESS_STRICT_RO[0]+_} ]]; then
    echo ""
    echo "; Harness auto-allowed directories (read-only)"
    for dir in "${HARNESS_STRICT_RO[@]}"; do
      if [[ -n "$dir" ]]; then
        local esc_dir
        esc_dir="$(sbpl_escape "$dir")"
        cat <<EOF
(allow file-read*
  (subpath "${esc_dir}")
)
EOF
      fi
    done
  fi

  emit_macos_final_guards "$project_dir" "$fs_mode"
}

# Append one fail-closed bubblewrap mask. Directories use an empty tmpfs;
# existing non-directories (regular files, sockets, FIFOs, devices, and links)
# use an inert file bind so sandbox startup does not fail on the node type.
append_bwrap_block() {
  local path="$1"
  if [[ -d "$path" && ! -L "$path" ]]; then
    BWRAP_ARGS+=(--tmpfs "$path")
  elif [[ -e "$path" || -L "$path" ]]; then
    BWRAP_ARGS+=(--ro-bind /dev/null "$path")
  elif [[ -d "$(dirname "$path")" ]]; then
    BWRAP_ARGS+=(--tmpfs "$path")
  fi
}

append_bwrap_allow() {
  local path="$1"
  local project_dir="$2"
  local fs_mode="$3"
  [[ -e "$path" || -L "$path" ]] || return 0
  if [[ "$fs_mode" == "ro" ]] && is_same_or_descendant_path "$path" "$project_dir"; then
    BWRAP_ARGS+=(--ro-bind "$path" "$path")
  else
    BWRAP_ARGS+=(--bind "$path" "$path")
  fi
}

# Reassert authoritative custom blocks after project/internal mounts, then add
# only explicit child exceptions. A final project bind preserves --ro even when
# an allowed ancestor was mounted read-write.
append_bwrap_final_policy() {
  local project_dir="$1"
  local fs_mode="$2"
  local strict_mode="$3"
  local i source path bdir under_bound

  for i in "${!ALL_BLOCKED[@]}"; do
    source="${ALL_BLOCKED_SOURCES[$i]}"
    case "$source" in config|project|cli|defense) ;; *) continue ;; esac
    path="${ALL_BLOCKED[$i]}"
    if [[ "$strict_mode" -eq 1 ]]; then
      under_bound=0
      is_same_or_descendant_path "$path" "$project_dir" && under_bound=1
      if [[ "$under_bound" -eq 0 && ${ALL_ALLOWED[0]+_} ]]; then
        for bdir in "${ALL_ALLOWED[@]}"; do
          if is_same_or_descendant_path "$path" "$bdir"; then
            under_bound=1
            break
          fi
        done
      fi
      [[ "$under_bound" -eq 0 ]] && continue
    fi
    append_bwrap_block "$path"
  done

  if [[ ${ALL_ALLOWED[0]+_} && ${ALL_BLOCKED[0]+_} ]]; then
    for path in "${ALL_ALLOWED[@]}"; do
      [[ -z "$path" ]] && continue
      for bdir in "${ALL_BLOCKED[@]}"; do
        if is_descendant_path "$path" "$bdir"; then
          append_bwrap_allow "$path" "$project_dir" "$fs_mode"
          break
        fi
      done
    done
  fi

  if [[ "$fs_mode" == "ro" ]]; then
    BWRAP_ARGS+=(--ro-bind "$project_dir" "$project_dir")
  fi
}

# Build bwrap args for Linux (default mode: allow home, block specific dirs).
# Populates global BWRAP_ARGS array (not a string — safe for paths with spaces).
build_bwrap_args() {
  local project_dir="$1"
  local fs_mode="$2"
  local net_mode="$3"
  shift 3
  local -a blocked=()
  if [[ $# -gt 0 ]]; then
    blocked=("$@")
  fi

  BWRAP_ARGS=()

  # Security flags
  BWRAP_ARGS+=(--new-session --die-with-parent --unshare-user --unshare-ipc --unshare-pid --close-fds)

  # System essentials (read-only)
  for sysdir in /usr /opt /lib /lib64 /bin /sbin /etc; do
    if [[ -d "$sysdir" ]]; then
      BWRAP_ARGS+=(--ro-bind "$sysdir" "$sysdir")
    fi
  done

  # /proc and /dev
  BWRAP_ARGS+=(--proc /proc --dev /dev)

  # Temp dirs
  BWRAP_ARGS+=(--tmpfs /tmp)
  if [[ "$net_mode" == "on" && -n "${XDG_RUNTIME_DIR:-}" ]]; then
    local runtime_dir runtime_owner runtime_mode
    runtime_dir="$(_realpath "$XDG_RUNTIME_DIR")"
    runtime_owner="$(stat -c '%u' "$runtime_dir" 2>/dev/null || stat -f '%u' "$runtime_dir" 2>/dev/null || true)"
    runtime_mode="$(stat -c '%a' "$runtime_dir" 2>/dev/null || stat -f '%Lp' "$runtime_dir" 2>/dev/null || true)"
    if [[ "$runtime_dir" == "/run/user/${UID}" && -d "$runtime_dir" && \
          "$runtime_owner" == "$UID" && "$runtime_mode" == "700" ]]; then
      BWRAP_ARGS+=(--bind "$runtime_dir" "$runtime_dir")
    else
      warning "ignoring unsafe XDG_RUNTIME_DIR (expected /run/user/${UID}, user-owned and mode 0700)"
    fi
  fi

  # Home directory (read-write) — mirrors macOS default-allow model
  BWRAP_ARGS+=(--bind "$HOME" "$HOME")

  # Privilege escalation prevention
  for priv in /usr/bin/sudo /usr/bin/su /usr/bin/login /usr/bin/doas /usr/bin/pkexec; do
    [[ -f "$priv" ]] && BWRAP_ARGS+=(--ro-bind /dev/null "$priv")
  done

  # Block specific directories/files.
  # bwrap applies mounts in order; later mounts override earlier ones.
  # Directories get tmpfs overlay; files get /dev/null bind.
  # Non-existent paths get tmpfs pre-block (prevents creation inside sandbox).
  for dir in "${blocked[@]}"; do
    [[ -z "$dir" ]] && continue
    append_bwrap_block "$dir"
  done

  # Project directory (override in case it falls under a blocked path).
  # bwrap mounts in order; this bind comes after blocked tmpfs overlays,
  # so it re-exposes the project subtree. After re-exposing the project,
  # any blocked[] entries under project_dir are overlaid with tmpfs to
  # re-block them.
  if [[ "$fs_mode" == "ro" ]]; then
    BWRAP_ARGS+=(--ro-bind "$project_dir" "$project_dir")
  else
    BWRAP_ARGS+=(--bind "$project_dir" "$project_dir")
  fi
  # Re-block subdirectories/files within the project (overlays after project bind)
  for bdir in "${blocked[@]}"; do
    if [[ "$bdir" == "$project_dir"/* ]]; then
      append_bwrap_block "$bdir"
    fi
  done

  # Bind only the exact preload file. Final custom-policy masks are applied
  # afterward, so an explicit block can never be reopened internally.
  if [[ -n "${SCODE_NO_SANDBOX_JS:-}" && -e "${SCODE_NO_SANDBOX_JS}" ]]; then
    BWRAP_ARGS+=(--ro-bind "$SCODE_NO_SANDBOX_JS" "$SCODE_NO_SANDBOX_JS")
  fi

  append_bwrap_final_policy "$project_dir" "$fs_mode" 0

  # Network
  if [[ "$net_mode" != "on" ]]; then
    BWRAP_ARGS+=(--unshare-net)
  fi

  # Set working directory
  BWRAP_ARGS+=(--chdir "$project_dir")
}

# Build bwrap args for Linux (strict mode: only system + project + explicit allows).
# Populates global BWRAP_ARGS array.
build_strict_bwrap_args() {
  local project_dir="$1"
  local fs_mode="$2"
  local net_mode="$3"
  shift 3
  local -a blocked=()
  if [[ $# -gt 0 ]]; then
    blocked=("$@")
  fi

  BWRAP_ARGS=()

  # Security flags
  BWRAP_ARGS+=(--new-session --die-with-parent --unshare-user --unshare-ipc --unshare-pid --close-fds)

  # System essentials only (read-only)
  for sysdir in /usr /opt /lib /lib64 /bin /sbin /etc; do
    if [[ -d "$sysdir" ]]; then
      BWRAP_ARGS+=(--ro-bind "$sysdir" "$sysdir")
    fi
  done

  # /proc and /dev
  BWRAP_ARGS+=(--proc /proc --dev /dev)

  # Temp
  BWRAP_ARGS+=(--tmpfs /tmp)

  # XDG_RUNTIME_DIR (e.g. /run/user/1000) is intentionally NOT bound in strict
  # mode. It contains sockets (Wayland, PulseAudio, D-Bus) that expand attack
  # surface. Tools needing it should use --allow /run/user/$UID explicitly.

  # Privilege escalation prevention
  for priv in /usr/bin/sudo /usr/bin/su /usr/bin/login /usr/bin/doas /usr/bin/pkexec; do
    [[ -f "$priv" ]] && BWRAP_ARGS+=(--ro-bind /dev/null "$priv")
  done

  # Project directory
  if [[ "$fs_mode" == "ro" ]]; then
    BWRAP_ARGS+=(--ro-bind "$project_dir" "$project_dir")
  else
    BWRAP_ARGS+=(--bind "$project_dir" "$project_dir")
  fi

  # Bind only the exact preload file.
  if [[ -n "${SCODE_NO_SANDBOX_JS:-}" && -e "${SCODE_NO_SANDBOX_JS}" ]]; then
    BWRAP_ARGS+=(--ro-bind "$SCODE_NO_SANDBOX_JS" "$SCODE_NO_SANDBOX_JS")
  fi

  # Allowed dirs/files (explicit overrides)
  if [[ ${ALL_ALLOWED[0]+_} ]]; then
    for dir in "${ALL_ALLOWED[@]}"; do
      if [[ -n "$dir" && -e "$dir" ]]; then
        append_bwrap_allow "$dir" "$project_dir" "$fs_mode"
      fi
    done
  fi

  # Harness strict read-only directories
  if [[ ${HARNESS_STRICT_RO[0]+_} ]]; then
    for dir in "${HARNESS_STRICT_RO[@]}"; do
      if [[ -n "$dir" && -e "$dir" ]]; then
        BWRAP_ARGS+=(--ro-bind "$dir" "$dir")
      fi
    done
  fi

  append_bwrap_final_policy "$project_dir" "$fs_mode" 1

  # Network
  if [[ "$net_mode" != "on" ]]; then
    BWRAP_ARGS+=(--unshare-net)
  fi

  # Set working directory
  BWRAP_ARGS+=(--chdir "$project_dir")
}

# -------- Defaults --------

NET_MODE="${SCODE_NET:-on}"
FS_MODE="${SCODE_FS_MODE:-rw}"

# Internal paths must never be inherited from the caller. In particular, the
# EXIT cleanup handler must only remove files created by this invocation.
SCODE_LIB_DIR=""
SCODE_NO_SANDBOX_JS=""
SCODE_NO_SANDBOX_LINK=""
SCODE_NO_SANDBOX_TMPDIR=""
SAFE_DARWIN_TMPDIR=""
SCODE_DARWIN_TMPDIR=""

# Validate env-sourced values early
case "$NET_MODE" in
  on|off) ;;
  *) error "invalid SCODE_NET value: '$NET_MODE' (expected 'on' or 'off')"; exit 1 ;;
esac
case "$FS_MODE" in
  rw|ro) ;;
  *) error "invalid SCODE_FS_MODE value: '$FS_MODE' (expected 'rw' or 'ro')"; exit 1 ;;
esac

DRY_RUN=0
STRICT=0
SCRUB_ENV=0
GROK_DEFENSE=0
LOG_FILE=""
PROJECT_DIR=""

COMMAND=()
CLI_BLOCKED=()
CLI_ALLOWED=()
CONFIG_BLOCKED=()
CONFIG_ALLOWED=()
# String configs init to "" (unset means "use default"); boolean configs also
# init to "" so explicit false can be distinguished from "not configured".
# parse_config() sets these via eval with a CONFIG_ prefix.
CONFIG_NET=""
CONFIG_FS_MODE=""
CONFIG_STRICT=""
CONFIG_SCRUB_ENV=""
CONFIG_GROK_DEFENSE=""

# Track CLI-explicit flags (so config doesn't override them)
CLI_NET=0
CLI_FS_MODE=0
CLI_STRICT=0
CLI_SCRUB_ENV=0
CLI_TRUST=""
CLI_CONFIG_SEEN=0
CLI_CWD_SEEN=0
CLI_LOG_SEEN=0

# -------- Option parsing --------

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    -V|--version)
      version
      exit 0
      ;;
    -n|--no-net)
      NET_MODE="off"
      CLI_NET=1
      shift
      ;;
    --strict)
      STRICT=1
      CLI_STRICT=1
      shift
      ;;
    --trust)
      if [[ $# -lt 2 ]]; then
        error "missing argument for $1"
        exit 1
      fi
      if [[ -n "$CLI_TRUST" ]]; then
        error "--trust specified more than once (was '$CLI_TRUST', got '$2')"
        exit 1
      fi
      CLI_TRUST="$2"
      case "$2" in
        trusted)
          # Minimal sandbox: rw, net on, no strict, no scrub.
          # Sets CLI_* flags so config files cannot override these values.
          if [[ "$CLI_FS_MODE" -eq 0 ]]; then FS_MODE="rw"; CLI_FS_MODE=1; fi
          if [[ "$CLI_NET" -eq 0 ]]; then NET_MODE="on"; CLI_NET=1; fi
          if [[ "$CLI_STRICT" -eq 0 ]]; then STRICT=0; CLI_STRICT=1; fi
          if [[ "$CLI_SCRUB_ENV" -eq 0 ]]; then SCRUB_ENV=0; CLI_SCRUB_ENV=1; fi
          ;;
        standard)
          # Default behavior — no changes needed
          ;;
        untrusted)
          # Maximum lockdown: strict + no-net + scrub-env + ro.
          # Sets CLI_* flags so config files cannot weaken the lockdown.
          if [[ "$CLI_STRICT" -eq 0 ]]; then STRICT=1; CLI_STRICT=1; fi
          if [[ "$CLI_NET" -eq 0 ]]; then NET_MODE="off"; CLI_NET=1; fi
          if [[ "$CLI_SCRUB_ENV" -eq 0 ]]; then SCRUB_ENV=1; CLI_SCRUB_ENV=1; fi
          if [[ "$CLI_FS_MODE" -eq 0 ]]; then FS_MODE="ro"; CLI_FS_MODE=1; fi
          ;;
        *)
          error "unknown trust level: $2 (expected: trusted, standard, untrusted)"
          exit 1
          ;;
      esac
      shift 2
      ;;
    --config)
      if [[ $# -lt 2 ]]; then
        error "missing argument for $1"
        exit 1
      fi
      if [[ "$CLI_CONFIG_SEEN" -eq 1 ]]; then
        error "--config specified more than once"
        exit 1
      fi
      CONFIG_FILE="$(expand_path "$2")"
      CONFIG_FILE_EXPLICIT=1
      CLI_CONFIG_SEEN=1
      shift 2
      ;;
    --scrub-env)
      SCRUB_ENV=1
      CLI_SCRUB_ENV=1
      shift
      ;;
    -C|--cwd)
      if [[ $# -lt 2 ]]; then
        error "missing argument for $1"
        exit 1
      fi
      if [[ "$CLI_CWD_SEEN" -eq 1 ]]; then
        error "--cwd specified more than once"
        exit 1
      fi
      PROJECT_DIR="$(expand_path "$2")"
      CLI_CWD_SEEN=1
      shift 2
      ;;
    --ro)
      FS_MODE="ro"
      CLI_FS_MODE=1
      shift
      ;;
    --rw)
      FS_MODE="rw"
      CLI_FS_MODE=1
      shift
      ;;
    --block)
      if [[ $# -lt 2 ]]; then
        error "missing argument for $1"
        exit 1
      fi
      validate_path "$2"
      CLI_BLOCKED+=("$2")
      shift 2
      ;;
    --allow)
      if [[ $# -lt 2 ]]; then
        error "missing argument for $1"
        exit 1
      fi
      validate_path "$2"
      CLI_ALLOWED+=("$2")
      shift 2
      ;;
    --log)
      if [[ $# -lt 2 ]]; then
        error "missing argument for $1"
        exit 1
      fi
      if [[ "$CLI_LOG_SEEN" -eq 1 ]]; then
        error "--log specified more than once"
        exit 1
      fi
      LOG_FILE="$(expand_output_path "$2")"
      CLI_LOG_SEEN=1
      shift 2
      ;;
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    --)
      shift
      COMMAND=("$@")
      break
      ;;
    -*)
      error "unknown option: $1"
      echo "Try '${PROGRAM_NAME} --help' for more information." >&2
      exit 1
      ;;
    audit)
      shift
      _audit_watch=0
      if [[ "${1:-}" == "--watch" || "${1:-}" == "-w" ]]; then
        _audit_watch=1
        shift
      fi
      if [[ $# -ne 1 ]]; then
        error "usage: ${PROGRAM_NAME} audit [--watch|-w] <logfile>"
        exit 1
      fi
      detect_platform
      if [[ "$_audit_watch" -eq 1 ]]; then
        audit_watch "$(expand_path "$1")"
      else
        audit_log "$(expand_path "$1")"
      fi
      exit $?
      ;;
    *)
      # Check if it's a known harness or start of command
      COMMAND=("$@")
      break
      ;;
  esac
done

# Default command
if [[ ${#COMMAND[@]} -eq 0 ]]; then
  COMMAND=("opencode")
fi
validate_path "${COMMAND[0]}"
REQUESTED_COMMAND=("${COMMAND[@]}")

# Default project dir
if [[ -z "${PROJECT_DIR}" ]]; then
  PROJECT_DIR="${PWD}"
fi

validate_path "${PROJECT_DIR}"

if [[ ! -d "${PROJECT_DIR}" ]]; then
  error "project directory does not exist: ${PROJECT_DIR}"
  exit 1
fi

PROJECT_DIR="$(_realpath "${PROJECT_DIR}")"

# Resolve command paths from the requested working directory. Relative command
# paths and relative PATH entries otherwise resolve against the caller's PWD,
# even though execution happens from PROJECT_DIR.
COMMAND_BINARY_PATH=""
_command_lookup=""
if [[ "${COMMAND[0]}" == */* ]]; then
  if [[ "${COMMAND[0]}" == /* ]]; then
    _command_lookup="${COMMAND[0]}"
  else
    _command_lookup="${PROJECT_DIR}/${COMMAND[0]}"
  fi
else
  # shellcheck disable=SC2015  # `|| true` only forces an empty lookup on failure
  _command_lookup="$(cd "${PROJECT_DIR}" && PATH="$SCODE_CALLER_PATH" type -P -- "${COMMAND[0]}" 2>/dev/null || true)"
  case "$_command_lookup" in
    /*) ;;
    ./*|../*|*/*) _command_lookup="${PROJECT_DIR}/${_command_lookup}" ;;
    *) _command_lookup="" ;;
  esac
fi
if [[ -n "$_command_lookup" && -e "$_command_lookup" ]]; then
  validate_path "$_command_lookup"
  COMMAND_BINARY_PATH="$(_realpath "$_command_lookup")"
  validate_path "$COMMAND_BINARY_PATH"
  # Execute the same canonical object that passed validation. A second PATH
  # lookup after policy construction would reintroduce a TOCTOU substitution.
  # Dry-run keeps the requested spelling so its rendered command stays useful.
  if [[ "$DRY_RUN" -eq 0 || "${COMMAND[0]}" == */* ]]; then
    COMMAND[0]="$COMMAND_BINARY_PATH"
  fi
fi

# -------- Platform detection & validation --------

detect_platform

# macOS allocates a private per-user temporary directory below /var/folders.
# Strict mode may write only to that canonical, owner-only directory—not the
# entire shared /var/folders tree. An attacker-controlled TMPDIR outside that
# namespace is ignored.
if [[ "$PLATFORM" == "darwin" ]]; then
  _tmp_root="/private/tmp"
  if [[ -n "${TMPDIR:-}" && ! "$TMPDIR" =~ [[:cntrl:]] ]]; then
    _tmp_candidate="$(_realpath "$TMPDIR")"
    _tmp_owner="$(stat -f '%u' "$_tmp_candidate" 2>/dev/null || true)"
    _tmp_mode="$(stat -f '%Lp' "$_tmp_candidate" 2>/dev/null || true)"
    if [[ "$_tmp_candidate" == /private/var/folders/*/T && -d "$_tmp_candidate" && \
          "$_tmp_owner" == "$UID" && "$_tmp_mode" == "700" ]]; then
      _tmp_root="$_tmp_candidate"
    fi
  fi
  if [[ "$DRY_RUN" -eq 1 ]]; then
    SAFE_DARWIN_TMPDIR="${_tmp_root%/}/scode.${UID}.dry-run"
  elif SCODE_DARWIN_TMPDIR="$(mktemp -d "${_tmp_root%/}/scode.${UID}.XXXXXX")"; then
    chmod 700 "$SCODE_DARWIN_TMPDIR"
    SAFE_DARWIN_TMPDIR="$SCODE_DARWIN_TMPDIR"
    TMPDIR="${SCODE_DARWIN_TMPDIR}/"
    export TMPDIR
  else
    error "failed to create a private macOS temporary directory"
    exit 1
  fi
fi

SANDBOX_ENGINE=""
case "$PLATFORM" in
  darwin) SANDBOX_ENGINE="/usr/bin/sandbox-exec" ;;
  linux) SANDBOX_ENGINE="/usr/bin/bwrap" ;;
esac

# Validate sandbox engine exists (skip for dry-run since we won't exec)
if [[ "${DRY_RUN}" -eq 0 ]]; then
  if [[ "$PLATFORM" == "darwin" ]]; then
    if [[ ! -x "$SANDBOX_ENGINE" ]]; then
      error "sandbox-exec not found (are you on macOS?)"
      exit 1
    fi
  elif [[ "$PLATFORM" == "linux" ]]; then
    if [[ ! -x "$SANDBOX_ENGINE" ]]; then
      error "bwrap not found. Install bubblewrap:"
      error "  Debian/Ubuntu: apt install bubblewrap"
      error "  Fedora/RHEL:   dnf install bubblewrap"
      exit 1
    fi
  fi
fi

if [[ "${DRY_RUN}" -eq 0 ]]; then
  if [[ "${COMMAND[0]}" == */* ]]; then
    if [[ -z "$COMMAND_BINARY_PATH" || ! -f "$COMMAND_BINARY_PATH" || ! -x "$COMMAND_BINARY_PATH" ]]; then
      error "command not found or not executable: ${COMMAND[0]}"
      exit 1
    fi
  elif [[ -z "$COMMAND_BINARY_PATH" || ! -f "$COMMAND_BINARY_PATH" || ! -x "$COMMAND_BINARY_PATH" ]]; then
    error "command not found: ${COMMAND[0]}"
    exit 1
  fi
fi

DETECTED_HARNESS=""
if DETECTED_HARNESS="$(detect_harness)"; then
  :
else
  warning "'${COMMAND[0]}' is not a known harness — sandbox behavior has not been tested for this command"
fi

# -------- Resolve config file --------

# Priority: --config flag > SCODE_CONFIG env var > default path
if [[ -z "${CONFIG_FILE}" ]]; then
  if [[ -n "${SCODE_CONFIG:-}" ]]; then
    CONFIG_FILE="$(expand_path "${SCODE_CONFIG}")"
    CONFIG_FILE_EXPLICIT=1
  else
    CONFIG_FILE="${DEFAULT_CONFIG_FILE}"
  fi
fi

if [[ "${CONFIG_FILE_EXPLICIT}" -eq 1 && ! -f "${CONFIG_FILE}" ]]; then
  error "config file not found: ${CONFIG_FILE}"
  exit 1
fi

# -------- Load config and merge --------

# Load user config (highest config priority)
parse_config "${CONFIG_FILE}" "CONFIG"

# Load per-project config (lower priority than user config)
PROJECT_CONFIG_FILE="${PROJECT_DIR%/}/.scode.yaml"
PROJECT_BLOCKED=()
PROJECT_ALLOWED=()
PROJECT_NET=""
PROJECT_FS_MODE=""
PROJECT_STRICT=""
PROJECT_SCRUB_ENV=""
PROJECT_GROK_DEFENSE=""
if [[ -L "${PROJECT_CONFIG_FILE}" ]]; then
  error "refusing symbolic-link project config: ${PROJECT_CONFIG_FILE}"
  exit 1
fi
if [[ -f "${PROJECT_CONFIG_FILE}" ]]; then
  # Pin the repository-controlled config to one verified descriptor so a
  # concurrent rename/symlink swap cannot redirect host-side reads.
  if ! exec 8<"${PROJECT_CONFIG_FILE}"; then
    error "failed to open project config: ${PROJECT_CONFIG_FILE}"
    exit 1
  fi
  _project_cfg_path_identity="$(stat -f '%i' "$PROJECT_CONFIG_FILE" 2>/dev/null || stat -Lc '%i' "$PROJECT_CONFIG_FILE" 2>/dev/null || true)"
  _project_cfg_fd_identity="$(stat -f '%i' /dev/fd/8 2>/dev/null || stat -Lc '%i' /dev/fd/8 2>/dev/null || true)"
  _project_cfg_owner_links="$(stat -f '%u:%l' /dev/fd/8 2>/dev/null || stat -Lc '%u:%h' /dev/fd/8 2>/dev/null || true)"
  _project_cfg_canonical="$(_realpath "$PROJECT_CONFIG_FILE")"
  if [[ -z "$_project_cfg_path_identity" || "$_project_cfg_path_identity" != "$_project_cfg_fd_identity" || \
        "$_project_cfg_owner_links" != "${UID}:1" || \
        "$_project_cfg_canonical" != "$PROJECT_CONFIG_FILE" ]]; then
    exec 8<&-
    error "refusing unsafe project config (must be an owned, single-link regular file in the project root): ${PROJECT_CONFIG_FILE}"
    exit 1
  fi
  parse_config "${PROJECT_CONFIG_FILE}" "PROJECT" 8
  exec 8<&-
fi

# Apply config scalars where CLI didn't override. Project configuration is
# untrusted and may only make the inherited/default posture more restrictive.
if [[ "$CLI_NET" -eq 0 ]]; then
  if [[ -n "$CONFIG_NET" ]]; then
    NET_MODE="$CONFIG_NET"
  elif [[ "$PROJECT_NET" == "off" ]]; then
    NET_MODE="off"
  fi
fi
if [[ "$CLI_FS_MODE" -eq 0 ]]; then
  if [[ -n "$CONFIG_FS_MODE" ]]; then
    FS_MODE="$CONFIG_FS_MODE"
  elif [[ "$PROJECT_FS_MODE" == "ro" ]]; then
    FS_MODE="ro"
  fi
fi
if [[ "$CLI_STRICT" -eq 0 ]]; then
  if [[ -n "$CONFIG_STRICT" ]]; then
    STRICT="$CONFIG_STRICT"
  elif [[ "$PROJECT_STRICT" == "1" ]]; then
    STRICT=1
  fi
fi
if [[ "$CLI_SCRUB_ENV" -eq 0 ]]; then
  if [[ -n "$CONFIG_SCRUB_ENV" ]]; then
    SCRUB_ENV="$CONFIG_SCRUB_ENV"
  elif [[ "$PROJECT_SCRUB_ENV" == "1" ]]; then
    SCRUB_ENV=1
  fi
fi
if [[ -n "$CONFIG_GROK_DEFENSE" ]]; then
  GROK_DEFENSE="$CONFIG_GROK_DEFENSE"
elif [[ "$PROJECT_GROK_DEFENSE" == "1" ]]; then
  GROK_DEFENSE=1
fi

# Grok's July 2026 collector uploaded complete Git bundles, including history,
# independently of which files the model read. This mode keeps inference usable
# but makes the proved bulk-history channel unavailable at the OS boundary.
if [[ "$GROK_DEFENSE" -eq 1 && "$DETECTED_HARNESS" == "grok" ]]; then
  _account_home_real="$(_realpath "$ACCOUNT_HOME")"
  _effective_home_real="$(_realpath "$HOME")"
  if [[ "$PROJECT_DIR" == "/" || "$PROJECT_DIR" == "$_account_home_real" || "$PROJECT_DIR" == "$_effective_home_real" ]]; then
    error "grok_defense refuses a project rooted at ${PROJECT_DIR}"
    error "choose a dedicated repository directory; the project itself is readable by Grok"
    exit 1
  fi
  STRICT=1
  SCRUB_ENV=1
  info "grok defense: strict mode, environment scrubbing, Git-history and dotenv blocks enabled"
fi

# Resolve CLI/config blocked+allowed paths relative to project dir.
# This keeps --block/--allow semantics stable regardless of caller PWD.
RESOLVED_CLI_ALLOWED=()
for dir in ${CLI_ALLOWED[@]+"${CLI_ALLOWED[@]}"}; do
  RESOLVED_CLI_ALLOWED+=("$(resolve_access_path "$dir" "$PROJECT_DIR")")
done
RESOLVED_CONFIG_ALLOWED=()
for dir in ${CONFIG_ALLOWED[@]+"${CONFIG_ALLOWED[@]}"}; do
  RESOLVED_CONFIG_ALLOWED+=("$(resolve_access_path "$dir" "$PROJECT_DIR")")
done
RESOLVED_CLI_BLOCKED=()
for dir in ${CLI_BLOCKED[@]+"${CLI_BLOCKED[@]}"}; do
  RESOLVED_CLI_BLOCKED+=("$(resolve_access_path "$dir" "$PROJECT_DIR")")
done
RESOLVED_CONFIG_BLOCKED=()
for dir in ${CONFIG_BLOCKED[@]+"${CONFIG_BLOCKED[@]}"}; do
  RESOLVED_CONFIG_BLOCKED+=("$(resolve_access_path "$dir" "$PROJECT_DIR")")
done
GROK_MANDATORY_BLOCKED=()
if [[ "$GROK_DEFENSE" -eq 1 && "$DETECTED_HARNESS" == "grok" ]]; then
  GROK_MANDATORY_BLOCKED=(
    "$PROJECT_DIR/.git"
    "$PROJECT_DIR/.grok"
    "$PROJECT_DIR/.env"
    "$PROJECT_DIR/.envrc"
    "$PROJECT_DIR/.env.local"
    "$PROJECT_DIR/.env.development"
    "$PROJECT_DIR/.env.development.local"
    "$PROJECT_DIR/.env.production"
    "$PROJECT_DIR/.env.production.local"
    "$PROJECT_DIR/.env.staging"
    "$PROJECT_DIR/.env.staging.local"
    "$PROJECT_DIR/.env.test"
    "$PROJECT_DIR/.env.test.local"
  )
fi
RESOLVED_PROJECT_ALLOWED=()
for dir in ${PROJECT_ALLOWED[@]+"${PROJECT_ALLOWED[@]}"}; do
  RESOLVED_PROJECT_ALLOWED+=("$(resolve_access_path "$dir" "$PROJECT_DIR")")
done
RESOLVED_PROJECT_BLOCKED=()
for dir in ${PROJECT_BLOCKED[@]+"${PROJECT_BLOCKED[@]}"}; do
  RESOLVED_PROJECT_BLOCKED+=("$(resolve_access_path "$dir" "$PROJECT_DIR")")
done

# Project allow rules are never authoritative. An allow already covered by a
# CLI/user allow is harmless and redundant; every other project allow is ignored.
_report_ignored_project_allows() {
  [[ ${#RESOLVED_PROJECT_ALLOWED[@]} -eq 0 ]] && return
  local pdir
  for pdir in "${RESOLVED_PROJECT_ALLOWED[@]}"; do
    if is_allowed_in_list "$pdir" \
         "${RESOLVED_CLI_ALLOWED[@]+"${RESOLVED_CLI_ALLOWED[@]}"}" \
         "${RESOLVED_CONFIG_ALLOWED[@]+"${RESOLVED_CONFIG_ALLOWED[@]}"}"; then
      continue
    fi
    warning "ignoring project config (.scode.yaml) allowed path (project config is restrictive-only): ${pdir}"
  done
}
_report_ignored_project_allows

# Warn when project config sets permissive scalar values that weaken
# user config or defaults (e.g. net: on, strict: false, scrub_env: false).
_check_project_config_weakens() {
  [[ ! -f "${PROJECT_CONFIG_FILE}" ]] && return
  # Permissive project values are ignored unless a user config already chose them.
  if [[ "$PROJECT_NET" == "on" && "${CONFIG_NET:-}" != "on" ]]; then
    warning "ignoring permissive project config value: net: on"
  fi
  if [[ "$PROJECT_FS_MODE" == "rw" && "${CONFIG_FS_MODE:-}" != "rw" ]]; then
    warning "ignoring permissive project config value: fs_mode: rw"
  fi
  if [[ "$PROJECT_STRICT" == "0" && "${CONFIG_STRICT:-}" != "0" ]]; then
    warning "ignoring permissive project config value: strict: false"
  fi
  if [[ "$PROJECT_SCRUB_ENV" == "0" && "${CONFIG_SCRUB_ENV:-}" != "0" ]]; then
    warning "ignoring permissive project config value: scrub_env: false"
  fi
  if [[ "$PROJECT_GROK_DEFENSE" == "0" && "${CONFIG_GROK_DEFENSE:-}" != "0" ]]; then
    warning "ignoring permissive project config value: grok_defense: false"
  fi
}
_check_project_config_weakens

# Build authoritative allowed list (CLI + user config only).
ALL_ALLOWED=()
ALL_ALLOWED_SOURCES=()
for dir in ${RESOLVED_CLI_ALLOWED[@]+"${RESOLVED_CLI_ALLOWED[@]}"}; do
  ALL_ALLOWED+=("$dir")
  ALL_ALLOWED_SOURCES+=("cli")
done
for dir in ${RESOLVED_CONFIG_ALLOWED[@]+"${RESOLVED_CONFIG_ALLOWED[@]}"}; do
  ALL_ALLOWED+=("$dir")
  ALL_ALLOWED_SOURCES+=("config")
done

# In strict mode, missing --allow paths are easy to overlook. Warn clearly.
if [[ "${STRICT}" -eq 1 && ${ALL_ALLOWED[0]+_} ]]; then
  for dir in "${ALL_ALLOWED[@]}"; do
    [[ -z "${dir}" ]] && continue
    if [[ ! -e "${dir}" ]]; then
      warning "strict mode: allowed path does not exist (not creating it): ${dir}"
    fi
  done
fi

# Harness-aware strict profiles: auto-detect the harness and expose its default
# config/state paths read-only so --strict remains usable without letting a
# compromised tool alter credentials. The untrusted preset disables even these
# convenience openings; callers must opt in path by path.
HARNESS_STRICT_RO=()
if [[ "${STRICT}" -eq 1 && "$CLI_TRUST" != "untrusted" ]]; then
  _detected_harness="${DETECTED_HARNESS:-}"
  if [[ -n "${_detected_harness}" ]]; then
    _auto_allowed=()
    if get_harness_config_paths "$_detected_harness"; then
      for _harness_config_path in "${HARNESS_CONFIG_PATHS[@]}"; do
        _harness_config_path="$(_realpath "$_harness_config_path")"
        if ! is_same_or_descendant_path "$_harness_config_path" "$HOME"; then
          warning "strict+${_detected_harness}: ignoring config path that resolves outside HOME: ${_harness_config_path}"
          continue
        fi
        # Skip if explicitly blocked by CLI, user config, or project config
        if ! is_allowed_in_list "$_harness_config_path" \
             "${RESOLVED_CLI_BLOCKED[@]+"${RESOLVED_CLI_BLOCKED[@]}"}" \
             "${RESOLVED_CONFIG_BLOCKED[@]+"${RESOLVED_CONFIG_BLOCKED[@]}"}" \
             "${RESOLVED_PROJECT_BLOCKED[@]+"${RESOLVED_PROJECT_BLOCKED[@]}"}"; then
          HARNESS_STRICT_RO+=("$_harness_config_path")
          _auto_allowed+=("$_harness_config_path")
        fi
      done
    fi
    # Reserved for narrowly scoped platform-specific auto-allows. The current
    # macOS policy deliberately leaves these lists empty.
    if [[ "$PLATFORM" == "darwin" ]]; then
      for dir in ${DARWIN_LIBRARY_ALLOWED_RW[@]+"${DARWIN_LIBRARY_ALLOWED_RW[@]}"}; do
        if ! is_allowed_in_list "$dir" \
             "${RESOLVED_CLI_BLOCKED[@]+"${RESOLVED_CLI_BLOCKED[@]}"}" \
             "${RESOLVED_CONFIG_BLOCKED[@]+"${RESOLVED_CONFIG_BLOCKED[@]}"}" \
             "${RESOLVED_PROJECT_BLOCKED[@]+"${RESOLVED_PROJECT_BLOCKED[@]}"}"; then
          ALL_ALLOWED+=("$dir")
          ALL_ALLOWED_SOURCES+=("auto")
          _auto_allowed+=("$dir")
        fi
      done
      for dir in ${DARWIN_LIBRARY_ALLOWED_RO[@]+"${DARWIN_LIBRARY_ALLOWED_RO[@]}"}; do
        if ! is_allowed_in_list "$dir" \
             "${RESOLVED_CLI_BLOCKED[@]+"${RESOLVED_CLI_BLOCKED[@]}"}" \
             "${RESOLVED_CONFIG_BLOCKED[@]+"${RESOLVED_CONFIG_BLOCKED[@]}"}" \
             "${RESOLVED_PROJECT_BLOCKED[@]+"${RESOLVED_PROJECT_BLOCKED[@]}"}"; then
          HARNESS_STRICT_RO+=("$dir")
          _auto_allowed+=("$dir")
        fi
      done
    fi
    if [[ ${#_auto_allowed[@]} -gt 0 ]]; then
      info "strict+${_detected_harness}: auto-allowing ${_auto_allowed[*]}"
    fi
  fi
fi

# CLI --block must win over broader config/automatic allows, except explicit
# CLI --allow. Check both hierarchy directions because an allowed parent would
# otherwise reopen a blocked child.
if [[ ${ALL_ALLOWED[0]+_} && ${RESOLVED_CLI_BLOCKED[0]+_} ]]; then
  _filtered_allowed=()
  _filtered_allowed_sources=()
  for _allowed_i in "${!ALL_ALLOWED[@]}"; do
    dir="${ALL_ALLOWED[$_allowed_i]}"
    [[ -z "$dir" ]] && continue
    if is_cli_allowed "$dir"; then
      _filtered_allowed+=("$dir")
      _filtered_allowed_sources+=("${ALL_ALLOWED_SOURCES[$_allowed_i]}")
      continue
    fi
    _overlaps_cli_block=0
    for _cli_block in "${RESOLVED_CLI_BLOCKED[@]}"; do
      if paths_overlap_hierarchy "$dir" "$_cli_block"; then
        _overlaps_cli_block=1
        break
      fi
    done
    [[ "$_overlaps_cli_block" -eq 1 ]] && continue
    _filtered_allowed+=("$dir")
    _filtered_allowed_sources+=("${ALL_ALLOWED_SOURCES[$_allowed_i]}")
  done
  ALL_ALLOWED=()
  ALL_ALLOWED_SOURCES=()
  if [[ ${_filtered_allowed[0]+_} ]]; then
    ALL_ALLOWED=("${_filtered_allowed[@]}")
    ALL_ALLOWED_SOURCES=("${_filtered_allowed_sources[@]}")
  fi
fi

# A caller must opt in to agent forwarding twice: expose the socket path with
# --allow and set SSH_AUTH_SOCK explicitly on the sandboxed command. Merely
# inheriting an outer shell's agent must never grant signing authority.
if [[ -n "$SCODE_CALLER_SSH_AUTH_SOCK" && "$SCODE_CALLER_SSH_AUTH_SOCK" == /* ]] && \
   ! _contains_control_character "$SCODE_CALLER_SSH_AUTH_SOCK" && \
   [[ -S "$SCODE_CALLER_SSH_AUTH_SOCK" ]]; then
  _ssh_socket_real="$(_realpath "$SCODE_CALLER_SSH_AUTH_SOCK")"
  DEFAULT_BLOCKED+=("$_ssh_socket_real")
fi

# Grok defense is an invariant, not an ordinary config preference. Refuse any
# allow that would reopen a mandatory repository-history or dotenv block.
if [[ ${GROK_MANDATORY_BLOCKED[0]+_} && ${ALL_ALLOWED[0]+_} ]]; then
  for _defense_block in "${GROK_MANDATORY_BLOCKED[@]}"; do
    for _allowed_dir in "${ALL_ALLOWED[@]}"; do
      if paths_overlap_hierarchy "$_defense_block" "$_allowed_dir"; then
        error "grok_defense conflicts with allowed path: ${_allowed_dir}"
        error "remove the overlapping allow or disable grok_defense explicitly"
        exit 1
      fi
    done
  done
fi

# Build blocked list: defaults + platform extras + config + CLI, minus allowed
# ALL_BLOCKED_SOURCES tracks the origin of each entry (parallel array).
ALL_BLOCKED=()
ALL_BLOCKED_SOURCES=()

# Start with defaults
for dir in "${DEFAULT_BLOCKED[@]}"; do
  if ! is_allowed "$dir"; then
    ALL_BLOCKED+=("$dir")
    ALL_BLOCKED_SOURCES+=("default")
  fi
done

# Platform extras
if [[ "$PLATFORM" == "darwin" ]]; then
  for dir in "${DARWIN_EXTRA_BLOCKED[@]}"; do
    if ! is_allowed "$dir"; then
      ALL_BLOCKED+=("$dir")
      ALL_BLOCKED_SOURCES+=("platform")
    fi
  done
elif [[ "$PLATFORM" == "linux" ]]; then
  for dir in "${LINUX_EXTRA_BLOCKED[@]}"; do
    if ! is_allowed "$dir"; then
      ALL_BLOCKED+=("$dir")
      ALL_BLOCKED_SOURCES+=("platform")
    fi
  done
fi

# Config blocked
for dir in ${RESOLVED_CONFIG_BLOCKED[@]+"${RESOLVED_CONFIG_BLOCKED[@]}"}; do
  if ! is_allowed "$dir"; then
    ALL_BLOCKED+=("$dir")
    ALL_BLOCKED_SOURCES+=("config")
  fi
done

# Project blocked
for dir in ${RESOLVED_PROJECT_BLOCKED[@]+"${RESOLVED_PROJECT_BLOCKED[@]}"}; do
  if ! is_allowed "$dir"; then
    ALL_BLOCKED+=("$dir")
    ALL_BLOCKED_SOURCES+=("project")
  fi
done

# CLI blocked
# CLI --block has higher precedence than config/default allows.
# CLI --allow still wins over CLI --block.
for dir in ${RESOLVED_CLI_BLOCKED[@]+"${RESOLVED_CLI_BLOCKED[@]}"}; do
  if ! is_cli_allowed "$dir"; then
    ALL_BLOCKED+=("$dir")
    ALL_BLOCKED_SOURCES+=("cli")
  fi
done

# Mandatory defense paths are appended after normal allow filtering.
for dir in ${GROK_MANDATORY_BLOCKED[@]+"${GROK_MANDATORY_BLOCKED[@]}"}; do
  ALL_BLOCKED+=("$dir")
  ALL_BLOCKED_SOURCES+=("defense")
done

# The project bind is an implicit allow needed to execute the requested task.
# An authoritative block covering it cannot be implemented without silently
# weakening either the block or the cwd contract, so fail closed.
for _blocked_i in "${!ALL_BLOCKED[@]}"; do
  case "${ALL_BLOCKED_SOURCES[$_blocked_i]}" in
    config|project|cli|defense) ;;
    *) continue ;;
  esac
  if is_same_or_descendant_path "$PROJECT_DIR" "${ALL_BLOCKED[$_blocked_i]}"; then
    error "custom block covers the project directory: ${ALL_BLOCKED[$_blocked_i]}"
    error "remove the block or add an authoritative allow for the project"
    exit 1
  fi
done

# bubblewrap needs the blocked path's parent to exist as a mount-point parent.
# A deep missing path was previously skipped, even when it came from an
# explicit user or project policy. Fail closed for authoritative custom rules;
# omit unavailable built-ins with one honest warning instead of logging a deny
# that the kernel never enforces.
if [[ "$PLATFORM" == "linux" ]]; then
  _enforceable_blocked=()
  _enforceable_blocked_sources=()
  _unavailable_default_blocks=0
  for _blocked_i in "${!ALL_BLOCKED[@]}"; do
    dir="${ALL_BLOCKED[$_blocked_i]}"
    _block_source="${ALL_BLOCKED_SOURCES[$_blocked_i]}"
    _needs_mount=1
    if [[ "$STRICT" -eq 1 && "$_block_source" != "config" && \
          "$_block_source" != "project" && "$_block_source" != "cli" ]]; then
      _needs_mount=0
      if is_same_or_descendant_path "$dir" "$PROJECT_DIR"; then
        _needs_mount=1
      elif [[ ${ALL_ALLOWED[0]+_} ]]; then
        for _allowed_dir in "${ALL_ALLOWED[@]}"; do
          if is_same_or_descendant_path "$dir" "$_allowed_dir"; then
            _needs_mount=1
            break
          fi
        done
      fi
    fi
    if [[ "$_needs_mount" -eq 1 && ! -e "$dir" && ! -d "$(dirname "$dir")" ]]; then
      case "$_block_source" in
        config|project|cli)
          error "cannot enforce Linux block because its parent does not exist: ${dir}"
          error "block an existing ancestor or create the parent directory first"
          exit 1
          ;;
        *)
          _unavailable_default_blocks=$((_unavailable_default_blocks + 1))
          continue
          ;;
      esac
    fi
    _enforceable_blocked+=("$dir")
    _enforceable_blocked_sources+=("$_block_source")
  done
  ALL_BLOCKED=()
  ALL_BLOCKED_SOURCES=()
  if [[ ${_enforceable_blocked[0]+_} ]]; then
    ALL_BLOCKED=("${_enforceable_blocked[@]}")
    ALL_BLOCKED_SOURCES=("${_enforceable_blocked_sources[@]}")
  fi
  if [[ "$_unavailable_default_blocks" -gt 0 ]]; then
    warning "${_unavailable_default_blocks} built-in Linux block(s) are currently inapplicable because their parents do not exist"
  fi
fi

# Linux default mode: --allow under a blocked parent requires an existing path
# for bwrap re-bind. Warn when an override cannot be applied yet.
if [[ "$PLATFORM" == "linux" && "${STRICT}" -eq 0 && ${ALL_ALLOWED[0]+_} && ${ALL_BLOCKED[0]+_} ]]; then
  for dir in "${ALL_ALLOWED[@]}"; do
    [[ -z "$dir" || -e "$dir" ]] && continue
    _allow_check="$dir"
    if [[ -d "$(dirname "$dir")" ]]; then
      _allow_check="$(_realpath "$(dirname "$dir")")/$(basename "$dir")"
    fi
    for bdir in "${ALL_BLOCKED[@]}"; do
      if is_descendant_path "$dir" "$bdir" || is_descendant_path "$_allow_check" "$bdir"; then
        warning "linux default mode: allowed path does not exist (cannot re-bind until it exists): ${dir}"
        break
      fi
    done
  done
fi


# -------- Scrub env if requested --------

if [[ "${SCRUB_ENV}" -eq 1 ]]; then
  scrub_env
fi
if [[ "$PLATFORM" == "linux" && "$NET_MODE" != "on" ]]; then
  unset XDG_RUNTIME_DIR
fi

# Grok defense is exported for the entire process tree so a nested Grok launch
# cannot inherit permissive collection defaults. The telemetry and workspace
# collection variables are defense-in-depth for Grok's currently undocumented
# switches; .git/dotenv denial above is the kernel-enforced boundary.
if [[ "$GROK_DEFENSE" -eq 1 ]]; then
  export GROK_TELEMETRY_ENABLED=false
  export GROK_TELEMETRY_TRACE_UPLOAD=false
  export GROK_TELEMETRY_MIXPANEL_ENABLED=false
  export GROK_WORKSPACE_DATA_COLLECTION_DISABLED=true
  export GROK_WORKSPACE_UPLOAD_QUEUE_ENABLED=false
  export GROK_RELAY_SYNC_ENABLED=false
  export GROK_RESPECT_GITIGNORE=1
  export GROK_DISABLE_AUTOUPDATER=1
  export GROK_WEB_FETCH=0
  export GROK_MEMORY=0
  export GROK_SUBAGENTS=0
  export GROK_TOOL_SEARCH=0

  export GROK_CURSOR_SKILLS_ENABLED=false
  export GROK_CURSOR_RULES_ENABLED=false
  export GROK_CURSOR_AGENTS_ENABLED=false
  export GROK_CURSOR_MCPS_ENABLED=false
  export GROK_CURSOR_HOOKS_ENABLED=false
  export GROK_CURSOR_SESSIONS_ENABLED=false
  export GROK_CLAUDE_SKILLS_ENABLED=false
  export GROK_CLAUDE_RULES_ENABLED=false
  export GROK_CLAUDE_AGENTS_ENABLED=false
  export GROK_CLAUDE_MCPS_ENABLED=false
  export GROK_CLAUDE_HOOKS_ENABLED=false
  export GROK_CLAUDE_SESSIONS_ENABLED=false
  export GROK_CODEX_SKILLS_ENABLED=false
  export GROK_CODEX_RULES_ENABLED=false
  export GROK_CODEX_AGENTS_ENABLED=false
  export GROK_CODEX_MCPS_ENABLED=false
  export GROK_CODEX_HOOKS_ENABLED=false
  export GROK_CODEX_SESSIONS_ENABLED=false
fi

# -------- Browser double-sandbox prevention --------
# Since scode IS a sandbox, inner browser sandboxes will fail.
# Export env vars that tell common tools to skip their own sandbox.

export SCODE_SANDBOXED=1
export ELECTRON_DISABLE_SANDBOX=1
export PLAYWRIGHT_MCP_NO_SANDBOX=1
if [[ " ${CHROMIUM_FLAGS:-} " != *" --no-sandbox "* ]]; then
  export CHROMIUM_FLAGS="${CHROMIUM_FLAGS:+${CHROMIUM_FLAGS} }--no-sandbox"
fi

# Node.js preload: patches child_process.spawn/spawnSync/exec/execSync/
# execFile/execFileSync to inject --no-sandbox for Chromium launches.
# Resolve lib dir: check source layout (./lib/) then installed layout (../lib/scode/).
SCODE_DIR="$(cd "$(dirname "$(_realpath "$0")")" && pwd)"
SCODE_LIB_DIR=""
if [[ -f "${SCODE_DIR}/lib/no-sandbox.js" ]]; then
  SCODE_LIB_DIR="${SCODE_DIR}/lib"
elif [[ -f "${SCODE_DIR}/../lib/scode/no-sandbox.js" ]]; then
  SCODE_LIB_DIR="$(cd "${SCODE_DIR}/../lib/scode" && pwd)"
fi
if [[ -n "${SCODE_LIB_DIR}" && -f "${SCODE_LIB_DIR}/no-sandbox.js" ]]; then
  SCODE_NO_SANDBOX_JS="${SCODE_LIB_DIR}/no-sandbox.js"
  validate_path "$SCODE_NO_SANDBOX_JS"
  _preload_custom_block=0
  for _blocked_i in "${!ALL_BLOCKED[@]}"; do
    case "${ALL_BLOCKED_SOURCES[$_blocked_i]}" in
      config|project|cli|defense)
        if is_same_or_descendant_path "$SCODE_NO_SANDBOX_JS" "${ALL_BLOCKED[$_blocked_i]}"; then
          _preload_custom_block=1
          break
        fi
        ;;
    esac
  done
  if [[ "$_preload_custom_block" -eq 1 ]]; then
    warning "browser preload disabled because custom policy blocks it: ${SCODE_NO_SANDBOX_JS}"
    SCODE_NO_SANDBOX_JS=""
  fi
  if [[ -n "$SCODE_NO_SANDBOX_JS" ]]; then
  # NODE_OPTIONS splits on whitespace — spaces in the path break --require.
  # Work around by symlinking to a space-free path when needed.
  if [[ "${SCODE_NO_SANDBOX_JS}" == *" "* ]]; then
    # Use /tmp explicitly (not TMPDIR) so the path itself stays space-free.
    # The private unpredictable directory prevents link-name races.
    if SCODE_NO_SANDBOX_TMPDIR="$(mktemp -d "/tmp/scode-no-sandbox.${UID}.XXXXXX")"; then
      chmod 700 "${SCODE_NO_SANDBOX_TMPDIR}"
      SCODE_NO_SANDBOX_LINK="${SCODE_NO_SANDBOX_TMPDIR}/preload.js"
    fi
    if [[ -n "${SCODE_NO_SANDBOX_LINK}" ]] && ln -s "${SCODE_NO_SANDBOX_JS}" "${SCODE_NO_SANDBOX_LINK}"; then
      SCODE_NO_SANDBOX_JS="${SCODE_NO_SANDBOX_LINK}"
    else
      warning "failed to create a space-free no-sandbox preload path"
      # shellcheck disable=SC2015  # best-effort cleanup; `|| true` is the intent
      [[ -n "${SCODE_NO_SANDBOX_TMPDIR}" ]] && rmdir "${SCODE_NO_SANDBOX_TMPDIR}" 2>/dev/null || true
      SCODE_NO_SANDBOX_LINK=""
      SCODE_NO_SANDBOX_TMPDIR=""
    fi
  fi
  export SCODE_NO_SANDBOX_JS
  export NODE_OPTIONS="--require=${SCODE_NO_SANDBOX_JS}${NODE_OPTIONS:+ ${NODE_OPTIONS}}"
  fi
fi

# Print sandbox-related env vars (for --dry-run)
print_dry_run_env() {
  echo ""
  echo "# Sandbox environment:"
  echo "#   SCODE_SANDBOXED=1"
  echo "#   ELECTRON_DISABLE_SANDBOX=1"
  echo "#   PLAYWRIGHT_MCP_NO_SANDBOX=1"
  echo "#   CHROMIUM_FLAGS=${CHROMIUM_FLAGS}"
  if [[ -n "${SCODE_NO_SANDBOX_JS:-}" ]]; then
    echo "#   NODE_OPTIONS=...--require=${SCODE_NO_SANDBOX_JS}"
  fi
  if [[ "${SCRUB_ENV}" -eq 1 ]]; then
    echo "#   --scrub-env active"
  fi
  if [[ "$GROK_DEFENSE" -eq 1 ]]; then
    echo "#   grok_defense active"
    echo "#   GROK_TELEMETRY_ENABLED=false"
    echo "#   GROK_TELEMETRY_TRACE_UPLOAD=false"
    echo "#   GROK_WORKSPACE_DATA_COLLECTION_DISABLED=true"
    echo "#   GROK_WORKSPACE_UPLOAD_QUEUE_ENABLED=false"
    echo "#   GROK_RELAY_SYNC_ENABLED=false"
    echo "#   GROK_RESPECT_GITIGNORE=1"
    echo "#   GROK_DISABLE_AUTOUPDATER=1"
    echo "#   Grok compatibility scanners, memory, subagents, tool search, and web fetch disabled"
  fi
}

# -------- Generate and run --------

# Older shellcheck (Ubuntu 24.04 ships 0.9) reports the same "never invoked"
# condition as SC2317; 0.10+ uses SC2329. Disable both so the lint result does
# not depend on which shellcheck the environment happens to provide.
# shellcheck disable=SC2329,SC2317  # invoked via EXIT trap below
cleanup_no_sandbox_link() {
  if [[ -n "${SCODE_NO_SANDBOX_LINK:-}" ]]; then
    rm -f "${SCODE_NO_SANDBOX_LINK}"
  fi
  if [[ -n "${SCODE_NO_SANDBOX_TMPDIR:-}" ]]; then
    rmdir "${SCODE_NO_SANDBOX_TMPDIR}" 2>/dev/null || true
  fi
  if [[ -n "${SCODE_DARWIN_TMPDIR:-}" ]]; then
    rm -rf -- "${SCODE_DARWIN_TMPDIR}" 2>/dev/null || true
  fi
  return 0
}

# Ensure the /tmp symlink (if created) is cleaned up on any exit path,
# including signals. Safe no-op when SCODE_NO_SANDBOX_LINK is unset.
trap 'cleanup_no_sandbox_link' EXIT

_scode_rc=0

# -------- Command binary auto-allow --------
# Only built-in/platform blocks may be bypassed for the command executable.
# User, project, and CLI block policy remains authoritative.
_command_has_custom_block=0
if [[ -n "${COMMAND_BINARY_PATH}" ]]; then
  for _blocked_i in "${!ALL_BLOCKED[@]}"; do
    case "${ALL_BLOCKED_SOURCES[$_blocked_i]}" in
      config|project|cli|defense)
        if is_same_or_descendant_path "${COMMAND_BINARY_PATH}" "${ALL_BLOCKED[$_blocked_i]}"; then
          _command_has_custom_block=1
          break
        fi
        ;;
    esac
  done
fi

if [[ "$PLATFORM" == "darwin" ]]; then
  # macOS: sandbox-exec
  if [[ "${STRICT}" -eq 1 ]]; then
    PROFILE=$(generate_strict_profile "${PROJECT_DIR}" "${FS_MODE}" "${NET_MODE}" ${ALL_BLOCKED[@]+"${ALL_BLOCKED[@]}"})
  else
    PROFILE=$(generate_profile "${PROJECT_DIR}" "${FS_MODE}" "${NET_MODE}" ${ALL_BLOCKED[@]+"${ALL_BLOCKED[@]}"})
  fi

  # Append allow for command binary if it falls under a blocked path.
  # In sandbox-exec, later rules override earlier ones.
  if [[ -n "${COMMAND_BINARY_PATH}" && "$_command_has_custom_block" -eq 0 ]]; then
    if [[ "$STRICT" -eq 1 ]]; then
      _esc_bin="$(sbpl_escape "${COMMAND_BINARY_PATH}")"
      PROFILE="${PROFILE}

; Strict-mode command binary (exact auto-allow)
(allow file-read* process-exec
  (literal \"${_esc_bin}\")
)"
    else
    for _blocked_i in "${!ALL_BLOCKED[@]}"; do
      case "${ALL_BLOCKED_SOURCES[$_blocked_i]}" in default|platform) ;; *) continue ;; esac
      _bdir="${ALL_BLOCKED[$_blocked_i]}"
      if is_same_or_descendant_path "${COMMAND_BINARY_PATH}" "$_bdir"; then
        _esc_bin="$(sbpl_escape "${COMMAND_BINARY_PATH}")"
        PROFILE="${PROFILE}

; Command binary (auto-allow under blocked parent)
(allow file-read* process-exec
  (literal \"${_esc_bin}\")
)"
        break
      fi
    done
    fi
  fi

  if [[ "${DRY_RUN}" -eq 1 ]]; then
    echo "${PROFILE}"
    echo ""
    printf '# Command:'
    printf ' %q' "${COMMAND[@]}"
    printf '\n'
    echo "# Platform: macOS (sandbox-exec)"
    [[ "${STRICT}" -eq 1 ]] && echo "# Mode: strict (deny-default)"
    print_dry_run_env
    exit 0
  fi

  # Set working directory (sandbox-exec has no --chdir equivalent)
  cd "${PROJECT_DIR}" || { error "cannot cd to project directory: ${PROJECT_DIR}"; exit 1; }

  # Run sandboxed (use -p to pass profile as string — avoids temp file cleanup
  # issues since exec replaces the shell and bypasses EXIT traps).
  if [[ -n "${LOG_FILE}" ]]; then
    ensure_log_parent_dir "${LOG_FILE}"
    # Build extra comment lines for macOS profile dump
    _profile_comments=()
    _profile_comments+=("# profile:")
    while IFS= read -r profile_line; do
      _profile_comments+=("#   ${profile_line}")
    done <<< "${PROFILE}"
    _profile_comments+=("#")
    _profile_comments+=("# Sandbox errors below (grep for 'Operation not permitted' / 'Permission denied'):")
    write_log_header_json "${LOG_FILE}" "${_profile_comments[@]}"
    info "logging to ${LOG_FILE}"
    if run_with_stderr_log "${LOG_FILE}" run_macos_sandbox_engine "$SANDBOX_ENGINE" -p "${PROFILE}" -- "${COMMAND[@]}"; then
      _scode_rc=0
    else
      _scode_rc=$?
    fi
  else
    if run_macos_sandbox_engine "$SANDBOX_ENGINE" -p "${PROFILE}" -- "${COMMAND[@]}"; then
      _scode_rc=0
    else
      _scode_rc=$?
    fi
  fi

elif [[ "$PLATFORM" == "linux" ]]; then
  # Linux: bubblewrap
  if [[ "${STRICT}" -eq 1 ]]; then
    build_strict_bwrap_args "${PROJECT_DIR}" "${FS_MODE}" "${NET_MODE}" ${ALL_BLOCKED[@]+"${ALL_BLOCKED[@]}"}
  else
    build_bwrap_args "${PROJECT_DIR}" "${FS_MODE}" "${NET_MODE}" ${ALL_BLOCKED[@]+"${ALL_BLOCKED[@]}"}
  fi

  # Linux parity with macOS: if the command binary itself is under a blocked
  # parent (defaults/config/project), re-bind that file so execution works.
  # Explicit CLI --block still wins and suppresses this auto-allow.
  if [[ -n "${COMMAND_BINARY_PATH}" && "$_command_has_custom_block" -eq 0 ]]; then
    if [[ "$STRICT" -eq 1 ]]; then
      BWRAP_ARGS+=(--ro-bind "${COMMAND_BINARY_PATH}" "${COMMAND_BINARY_PATH}")
    else
    for _blocked_i in "${!ALL_BLOCKED[@]}"; do
      case "${ALL_BLOCKED_SOURCES[$_blocked_i]}" in default|platform) ;; *) continue ;; esac
      _bdir="${ALL_BLOCKED[$_blocked_i]}"
      if is_same_or_descendant_path "${COMMAND_BINARY_PATH}" "$_bdir"; then
        BWRAP_ARGS+=(--ro-bind "${COMMAND_BINARY_PATH}" "${COMMAND_BINARY_PATH}")
        break
      fi
    done
    fi
  fi

  if [[ "${DRY_RUN}" -eq 1 ]]; then
    printf 'bwrap'
    printf ' %q' "${BWRAP_ARGS[@]}"
    printf ' --'
    printf ' %q' "${COMMAND[@]}"
    printf '\n'
    echo ""
    echo "# Platform: Linux (bubblewrap)"
    [[ "${STRICT}" -eq 1 ]] && echo "# Mode: strict"
    print_dry_run_env
    exit 0
  fi

  if [[ -n "${LOG_FILE}" ]]; then
    ensure_log_parent_dir "${LOG_FILE}"
    write_log_header_json "${LOG_FILE}" "# bwrap args: ${BWRAP_ARGS[*]}"
    info "logging to ${LOG_FILE}"
    if run_with_stderr_log "${LOG_FILE}" /usr/bin/env "PATH=${SCODE_CALLER_PATH}" "$SANDBOX_ENGINE" "${BWRAP_ARGS[@]}" -- "${COMMAND[@]}"; then
      _scode_rc=0
    else
      _scode_rc=$?
    fi
  else
    if /usr/bin/env "PATH=${SCODE_CALLER_PATH}" "$SANDBOX_ENGINE" "${BWRAP_ARGS[@]}" -- "${COMMAND[@]}"; then
      _scode_rc=0
    else
      _scode_rc=$?
    fi
  fi
fi

exit "${_scode_rc}"
