# Colors for output
readonly RED='\033[0;31m'
readonly YELLOW='\033[1;33m'
readonly GREEN='\033[0;32m'
readonly NC='\033[0m'

# Render untrusted text without allowing terminal control sequences to execute.
# Newlines and other C0/DEL bytes are shown as escapes; ordinary UTF-8 is kept.
terminal_escape() {
  local s="$1"
  local result="" i ch ord escaped
  for (( i=0; i<${#s}; i++ )); do
    ch="${s:i:1}"
    printf -v ord '%d' "'$ch"
    case "$ord" in
      8)  result+='\b' ;;
      9)  result+='\t' ;;
      10) result+='\n' ;;
      12) result+='\f' ;;
      13) result+='\r' ;;
      [0-9]|[1-2][0-9]|3[0-1]|127)
        printf -v escaped '\\x%02x' "$ord"
        result+="$escaped"
        ;;
      *) result+="$ch" ;;
    esac
  done
  printf '%s' "$result"
}

# Collapse dot components in an absolute path without touching the filesystem.
# This is required for the realpath fallback: retaining an unresolved `..`
# would let policy comparisons disagree with the path the kernel resolves.
_collapse_absolute_path() {
  local input="$1"
  local -a parts=() normalized=()
  local part result=""
  IFS='/' read -r -a parts <<< "$input"
  for part in "${parts[@]}"; do
    case "$part" in
      ""|.) continue ;;
      ..)
        if [[ ${normalized[0]+_} ]]; then
          unset 'normalized[${#normalized[@]}-1]'
          normalized=("${normalized[@]+"${normalized[@]}"}")
        fi
        ;;
      *) normalized+=("$part") ;;
    esac
  done
  for part in "${normalized[@]+"${normalized[@]}"}"; do
    result="${result}/${part}"
  done
  printf '%s\n' "${result:-/}"
}

# Portable realpath: use the system binary when available, otherwise resolve
# final-component symlinks with readlink and parent components with cd+pwd.
# Handles files, directories, and non-existent paths.
_realpath() {
  local input="$1"
  local resolved=""

  if command -v realpath >/dev/null 2>&1; then
    if resolved="$(realpath "$input" 2>/dev/null)"; then
      printf '%s\n' "$resolved"
      return 0
    fi
  fi

  local abs="$input"
  if [[ "$abs" != /* ]]; then
    abs="${PWD}/${abs}"
  fi

  # `cd -P "$(dirname ...)"` does not resolve a file's final symlink. Follow it
  # explicitly, including relative link targets, and cap traversal to reject
  # cycles consistently with realpath(1).
  local link_count=0 link_target=""
  while [[ -L "$abs" ]]; do
    link_count=$((link_count + 1))
    if [[ "$link_count" -gt 40 ]]; then
      error "too many symbolic links while resolving path: ${input}"
      return 1
    fi
    if ! link_target="$(/usr/bin/readlink "$abs")"; then
      error "failed to read symbolic link while resolving path: ${input}"
      return 1
    fi
    if [[ "$link_target" == /* ]]; then
      abs="$link_target"
    else
      abs="$(dirname "$abs")/${link_target}"
    fi
  done

  if [[ -d "$abs" ]]; then
    (cd "$abs" && pwd -P)
    return 0
  fi
  if [[ -e "$abs" ]]; then
    local dir base
    dir="$(cd "$(dirname "$abs")" && pwd -P)"
    base="$(basename "$abs")"
    printf '%s/%s\n' "$dir" "$base"
    return 0
  fi

  # Non-existent path: resolve the nearest existing ancestor, then append the
  # unresolved suffix so the result remains absolute.
  local anchor="$abs"
  local suffix=""
  while [[ ! -e "$anchor" && "$anchor" != "/" ]]; do
    local tail="${anchor##*/}"
    suffix="/${tail}${suffix}"
    anchor="${anchor%/*}"
    [[ -z "$anchor" ]] && anchor="/"
  done

  if [[ -d "$anchor" ]]; then
    local anchor_resolved
    anchor_resolved="$(cd "$anchor" && pwd -P)"
    if [[ "$anchor_resolved" == "/" ]]; then
      _collapse_absolute_path "/${suffix#/}"
    else
      _collapse_absolute_path "${anchor_resolved}${suffix}"
    fi
    return 0
  fi
  if [[ -e "$anchor" ]]; then
    local anchor_dir anchor_base
    anchor_dir="$(cd "$(dirname "$anchor")" && pwd -P)"
    anchor_base="$(basename "$anchor")"
    if [[ "$anchor_dir" == "/" ]]; then
      _collapse_absolute_path "/${anchor_base}${suffix}"
    else
      _collapse_absolute_path "${anchor_dir}/${anchor_base}${suffix}"
    fi
    return 0
  fi

  # Defensive final fallback ("/" should always exist).
  _collapse_absolute_path "$abs"
}

# Normalize paths for policy matching: trim trailing slashes except for root.
normalize_match_path() {
  local p="$1"
  if [[ -z "$p" ]]; then
    printf '\n'
    return 0
  fi
  while [[ "$p" == //* ]]; do
    p="/${p#//}"
  done
  while [[ "$p" != "/" && "$p" == */ ]]; do
    p="${p%/}"
  done
  [[ -z "$p" ]] && p="/"
  printf '%s\n' "$p"
}

# Returns success when $1 is the same path as, or a descendant of, $2.
is_same_or_descendant_path() {
  local child parent
  child="$(normalize_match_path "$1")"
  parent="$(normalize_match_path "$2")"
  [[ -z "$child" || -z "$parent" ]] && return 1
  if [[ "$parent" == "/" ]]; then
    [[ "$child" == /* ]]
    return
  fi
  [[ "$child" == "$parent" || "$child" == "$parent"/* ]]
}

# Returns success when $1 is a strict descendant of $2 (not equal).
is_descendant_path() {
  local child parent
  child="$(normalize_match_path "$1")"
  parent="$(normalize_match_path "$2")"
  [[ -z "$child" || -z "$parent" ]] && return 1
  if [[ "$parent" == "/" ]]; then
    [[ "$child" == /* && "$child" != "/" ]]
    return
  fi
  [[ "$child" == "$parent"/* ]]
}

# Returns success when two paths overlap in the same hierarchy direction
# (same path, ancestor, or descendant).
paths_overlap_hierarchy() {
  is_same_or_descendant_path "$1" "$2" || is_same_or_descendant_path "$2" "$1"
}

# -------- Platform detection --------

detect_platform() {
  # _SCODE_PLATFORM is a dry-run-only test hook. Letting an inherited variable
  # select the runtime engine would make platform enforcement environment-
  # dependent and would invite PATH/fake-engine tests that bypass real isolation.
  if [[ -n "${_SCODE_PLATFORM:-}" ]]; then
    case "${_SCODE_PLATFORM}" in
      darwin|linux)
        if [[ "${DRY_RUN:-0}" -ne 1 ]]; then
          error "internal platform override is only permitted with --dry-run"
          exit 1
        fi
        PLATFORM="${_SCODE_PLATFORM}"
        return
        ;;
      *) error "invalid internal platform override: ${_SCODE_PLATFORM}"; exit 1 ;;
    esac
  fi
  case "$(uname -s)" in
    Darwin) PLATFORM="darwin" ;;
    Linux)  PLATFORM="linux" ;;
    *)      error "unsupported platform: $(uname -s)"; exit 1 ;;
  esac
}

