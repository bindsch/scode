ACCOUNT_HOME=""
case "${OSTYPE:-}" in
  darwin*)
    _account_home_line="$(/usr/bin/dscl . -read "/Users/$(/usr/bin/id -un)" NFSHomeDirectory 2>/dev/null || true)"
    ACCOUNT_HOME="${_account_home_line#NFSHomeDirectory: }"
    ;;
  linux*)
    while IFS=: read -r _name _password _uid _gid _gecos _home _shell; do
      if [[ "$_uid" == "$UID" ]]; then
        ACCOUNT_HOME="$_home"
        break
      fi
    done < /etc/passwd
    ;;
esac
if [[ -z "$ACCOUNT_HOME" || "$ACCOUNT_HOME" != /* || "$ACCOUNT_HOME" == "/" || \
      ! -d "$ACCOUNT_HOME" || ! -O "$ACCOUNT_HOME" || "$ACCOUNT_HOME" =~ [[:cntrl:]] ]]; then
