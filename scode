  # Allow only the exact preload file; exposing the containing directory would
  # reopen sibling files hidden by a custom block.
  if [[ -n "${SCODE_NO_SANDBOX_JS:-}" && -f "${SCODE_NO_SANDBOX_JS}" ]]; then
    local esc_preload
    esc_preload="$(sbpl_escape "$SCODE_NO_SANDBOX_JS")"
    cat <<EOF

; scode Node.js preload (read-only)
(allow file-read*
  (literal "${esc_preload}")
)
EOF
  fi

  # Blocked directories — emitted BEFORE allows so that later allow rules
  # take precedence (sandbox-exec "later rules win" semantics).  This lets
  # --allow children of a blocked parent work correctly.
  if [[ ${#blocked[@]} -gt 0 ]]; then
    local emitted_header=0
    local i source
    for i in "${!blocked[@]}"; do
      dir="${blocked[$i]}"
      [[ -z "$dir" ]] && continue
      source="${ALL_BLOCKED_SOURCES[$i]:-default}"
      case "$source" in config|project|cli|defense) ;; *) continue ;; esac
      if [[ "$emitted_header" -eq 0 ]]; then
        echo ""
        echo "; Blocked directories"
        emitted_header=1
      fi
      local esc_dir
      esc_dir="$(sbpl_escape "$dir")"
      cat <<EOF
(deny file-read* file-write* process-exec
  (subpath "${esc_dir}")
)
EOF
    done
  fi

  # Allowed directories (explicit overrides — emitted after blocked so they win)
  if [[ ${ALL_ALLOWED[0]+_} ]]; then
    echo ""
    echo "; Explicitly allowed directories"
    for dir in "${ALL_ALLOWED[@]}"; do
      if [[ -n "$dir" ]]; then
        local esc_dir
        esc_dir="$(sbpl_escape "$dir")"
        cat <<EOF
(allow file-read* file-write* process-exec
  (subpath "${esc_dir}")
)
EOF
      fi
    done
  fi

  # Narrowly scoped harness state directories.
  #
  # These are read-write, not read-only. A harness that signs in with OAuth
  # must persist rotated credentials: the provider invalidates the old refresh
  # token the moment it is redeemed, so a harness that can read its token but
  # not write the replacement destroys the login permanently, and silently.
  # Read-only here does not prevent that exchange, it only discards the result.
  # The grant stays confined to the harness's own state directory.
  if [[ ${HARNESS_STRICT_RO[0]+_} ]]; then
    echo ""
    echo "; Harness auto-allowed state directories (read-write)"
    for dir in "${HARNESS_STRICT_RO[@]}"; do
      if [[ -n "$dir" ]]; then
        local esc_dir
        esc_dir="$(sbpl_escape "$dir")"
        cat <<EOF
(allow file-read* file-write*
  (subpath "${esc_dir}")
)
EOF
      fi
    done
  fi

  emit_macos_final_guards "$project_dir" "$fs_mode"
}
# SCODE_COVERAGE_EXCLUDE_END

# Append one fail-closed bubblewrap mask. Directories use an empty tmpfs;
# existing non-directories (regular files, sockets, FIFOs, devices, and links)
# use an inert file bind so sandbox startup does not fail on the node type.
append_bwrap_block() {
  local path="$1"
  if [[ -d "$path" && ! -L "$path" ]]; then
    BWRAP_ARGS+=(--tmpfs "$path")
  elif [[ -e "$path" || -L "$path" ]]; then
    BWRAP_ARGS+=(--ro-bind /dev/null "$path")
  elif [[ -d "$(dirname "$path")" ]]; then
    BWRAP_ARGS+=(--tmpfs "$path")
  fi
}

append_bwrap_allow() {
  local path="$1"
  local project_dir="$2"
  local fs_mode="$3"
  [[ -e "$path" || -L "$path" ]] || return 0
  if [[ "$fs_mode" == "ro" ]] && is_same_or_descendant_path "$path" "$project_dir"; then
    BWRAP_ARGS+=(--ro-bind "$path" "$path")
  else
    BWRAP_ARGS+=(--bind "$path" "$path")
  fi
}

# Reassert authoritative custom blocks after project/internal mounts, then add
# only explicit child exceptions. A final project bind preserves --ro even when
# an allowed ancestor was mounted read-write.
append_bwrap_final_policy() {
  local project_dir="$1"
  local fs_mode="$2"
  local strict_mode="$3"
  local i source path bdir under_bound

  for i in "${!ALL_BLOCKED[@]}"; do
    source="${ALL_BLOCKED_SOURCES[$i]}"
    case "$source" in config|project|cli|defense) ;; *) continue ;; esac
    path="${ALL_BLOCKED[$i]}"
    if [[ "$strict_mode" -eq 1 ]]; then
      under_bound=0
      is_same_or_descendant_path "$path" "$project_dir" && under_bound=1
      if [[ "$under_bound" -eq 0 && ${ALL_ALLOWED[0]+_} ]]; then
        for bdir in "${ALL_ALLOWED[@]}"; do
          if is_same_or_descendant_path "$path" "$bdir"; then
            under_bound=1
            break
          fi
        done
      fi
      [[ "$under_bound" -eq 0 ]] && continue
    fi
    append_bwrap_block "$path"
  done

  if [[ ${ALL_ALLOWED[0]+_} && ${ALL_BLOCKED[0]+_} ]]; then
    for path in "${ALL_ALLOWED[@]}"; do
      [[ -z "$path" ]] && continue
      for bdir in "${ALL_BLOCKED[@]}"; do
        if is_descendant_path "$path" "$bdir"; then
          append_bwrap_allow "$path" "$project_dir" "$fs_mode"
          break
        fi
      done
    done
  fi

  if [[ "$fs_mode" == "ro" ]]; then
    BWRAP_ARGS+=(--ro-bind "$project_dir" "$project_dir")
  fi
}

# Build bwrap args for Linux (default mode: allow home, block specific dirs).
# Populates global BWRAP_ARGS array (not a string — safe for paths with spaces).
build_bwrap_args() {
  local project_dir="$1"
  local fs_mode="$2"
  local net_mode="$3"
  shift 3
  local -a blocked=()
  if [[ $# -gt 0 ]]; then
    blocked=("$@")
  fi

  BWRAP_ARGS=()

  # Security flags
  BWRAP_ARGS+=(--new-session --die-with-parent --unshare-user --unshare-ipc --unshare-pid)

  # System essentials (read-only)
  for sysdir in /usr /opt /lib /lib64 /bin /sbin /etc; do
    if [[ -d "$sysdir" ]]; then
      BWRAP_ARGS+=(--ro-bind "$sysdir" "$sysdir")
    fi
  done

  # /proc and /dev
  BWRAP_ARGS+=(--proc /proc --dev /dev)

  # Temp dirs
  BWRAP_ARGS+=(--tmpfs /tmp)
  if [[ "$net_mode" == "on" && -n "${XDG_RUNTIME_DIR:-}" ]]; then
    local runtime_dir runtime_owner runtime_mode
    runtime_dir="$(_realpath "$XDG_RUNTIME_DIR")"
    runtime_owner="$(stat -c '%u' "$runtime_dir" 2>/dev/null || stat -f '%u' "$runtime_dir" 2>/dev/null || true)"
    runtime_mode="$(stat -c '%a' "$runtime_dir" 2>/dev/null || stat -f '%Lp' "$runtime_dir" 2>/dev/null || true)"
    if [[ "$runtime_dir" == "/run/user/${UID}" && -d "$runtime_dir" && \
          "$runtime_owner" == "$UID" && "$runtime_mode" == "700" ]]; then
      BWRAP_ARGS+=(--bind "$runtime_dir" "$runtime_dir")
    else
      warning "ignoring unsafe XDG_RUNTIME_DIR (expected /run/user/${UID}, user-owned and mode 0700)"
    fi
  fi

  # Home directory (read-write) — mirrors macOS default-allow model
  BWRAP_ARGS+=(--bind "$HOME" "$HOME")

  # Privilege escalation prevention
  for priv in /usr/bin/sudo /usr/bin/su /usr/bin/login /usr/bin/doas /usr/bin/pkexec; do
    [[ -f "$priv" ]] && BWRAP_ARGS+=(--ro-bind /dev/null "$priv")
  done

  # Block specific directories/files.
  # bwrap applies mounts in order; later mounts override earlier ones.
  # Directories get tmpfs overlay; files get /dev/null bind.
  # Non-existent paths get tmpfs pre-block (prevents creation inside sandbox).
  for dir in "${blocked[@]}"; do
    [[ -z "$dir" ]] && continue
    append_bwrap_block "$dir"
  done

  # Project directory (override in case it falls under a blocked path).
  # bwrap mounts in order; this bind comes after blocked tmpfs overlays,
  # so it re-exposes the project subtree. After re-exposing the project,
  # any blocked[] entries under project_dir are overlaid with tmpfs to
  # re-block them.
  if [[ "$fs_mode" == "ro" ]]; then
    BWRAP_ARGS+=(--ro-bind "$project_dir" "$project_dir")
  else
    BWRAP_ARGS+=(--bind "$project_dir" "$project_dir")
  fi
  # Re-block subdirectories/files within the project (overlays after project bind)
  for bdir in "${blocked[@]}"; do
    if [[ "$bdir" == "$project_dir"/* ]]; then
      append_bwrap_block "$bdir"
    fi
  done

  # Bind only the exact preload file. Final custom-policy masks are applied
  # afterward, so an explicit block can never be reopened internally.
  if [[ -n "${SCODE_NO_SANDBOX_JS:-}" && -e "${SCODE_NO_SANDBOX_JS}" ]]; then
    BWRAP_ARGS+=(--ro-bind "$SCODE_NO_SANDBOX_JS" "$SCODE_NO_SANDBOX_JS")
  fi

  append_bwrap_final_policy "$project_dir" "$fs_mode" 0

  # Network
  if [[ "$net_mode" != "on" ]]; then
    BWRAP_ARGS+=(--unshare-net)
  fi

  # Set working directory
  BWRAP_ARGS+=(--chdir "$project_dir")
}

# Build bwrap args for Linux (strict mode: only system + project + explicit allows).
# Populates global BWRAP_ARGS array.
build_strict_bwrap_args() {
  local project_dir="$1"
  local fs_mode="$2"
  local net_mode="$3"
  shift 3
  local -a blocked=()
  if [[ $# -gt 0 ]]; then
    blocked=("$@")
  fi

  BWRAP_ARGS=()

  # Security flags
  BWRAP_ARGS+=(--new-session --die-with-parent --unshare-user --unshare-ipc --unshare-pid)

  # System essentials only (read-only)
  for sysdir in /usr /opt /lib /lib64 /bin /sbin /etc; do
    if [[ -d "$sysdir" ]]; then
      BWRAP_ARGS+=(--ro-bind "$sysdir" "$sysdir")
    fi
  done

  # /proc and /dev
  BWRAP_ARGS+=(--proc /proc --dev /dev)

  # Temp
  BWRAP_ARGS+=(--tmpfs /tmp)

  # XDG_RUNTIME_DIR (e.g. /run/user/1000) is intentionally NOT bound in strict
  # mode. It contains sockets (Wayland, PulseAudio, D-Bus) that expand attack
  # surface. Tools needing it should use --allow /run/user/$UID explicitly.

  # Privilege escalation prevention
  for priv in /usr/bin/sudo /usr/bin/su /usr/bin/login /usr/bin/doas /usr/bin/pkexec; do
    [[ -f "$priv" ]] && BWRAP_ARGS+=(--ro-bind /dev/null "$priv")
  done

  # Project directory
  if [[ "$fs_mode" == "ro" ]]; then
    BWRAP_ARGS+=(--ro-bind "$project_dir" "$project_dir")
  else
    BWRAP_ARGS+=(--bind "$project_dir" "$project_dir")
  fi

  # Bind only the exact preload file.
  if [[ -n "${SCODE_NO_SANDBOX_JS:-}" && -e "${SCODE_NO_SANDBOX_JS}" ]]; then
    BWRAP_ARGS+=(--ro-bind "$SCODE_NO_SANDBOX_JS" "$SCODE_NO_SANDBOX_JS")
  fi

  # Allowed dirs/files (explicit overrides)
  if [[ ${ALL_ALLOWED[0]+_} ]]; then
    for dir in "${ALL_ALLOWED[@]}"; do
      if [[ -n "$dir" && -e "$dir" ]]; then
        append_bwrap_allow "$dir" "$project_dir" "$fs_mode"
      fi
    done
  fi

  # Harness state directories, bound read-write so credential rotation can
  # persist. See the macOS emission for why read-only breaks OAuth harnesses.
  if [[ ${HARNESS_STRICT_RO[0]+_} ]]; then
    for dir in "${HARNESS_STRICT_RO[@]}"; do
      if [[ -n "$dir" && -e "$dir" ]]; then
        BWRAP_ARGS+=(--bind "$dir" "$dir")
      fi
    done
  fi

  append_bwrap_final_policy "$project_dir" "$fs_mode" 1

  # Network
  if [[ "$net_mode" != "on" ]]; then
    BWRAP_ARGS+=(--unshare-net)
  fi

  # Set working directory
  BWRAP_ARGS+=(--chdir "$project_dir")
}

# -------- Defaults --------

NET_MODE="${SCODE_NET:-on}"
FS_MODE="${SCODE_FS_MODE:-rw}"

# Internal paths must never be inherited from the caller. In particular, the
# EXIT cleanup handler must only remove files created by this invocation.
SCODE_LIB_DIR=""
SCODE_NO_SANDBOX_JS=""
SCODE_NO_SANDBOX_LINK=""
SCODE_NO_SANDBOX_TMPDIR=""
SAFE_DARWIN_TMPDIR=""
SCODE_DARWIN_TMPDIR=""

# Usage accounting (opt-in). When SCODE_ACCOUNT_FILE names a writable file,
# one JSON line is appended at exit for every invocation that gets past
# argument validation (--help/--version produce no record; failed launches
# after that do). The parent directory must already exist; a relative path
# resolves against the invoking directory, before any change of directory.
# SCODE_ACCOUNT_ID is an opaque correlation token. Both are consumed into
# private variables and unset so the sandboxed child
# does not learn the sink path or the id through its environment.
# Assignments keep the export attribute, so a caller-exported private
# name would carry its exported value into the engine's environment.
# Clear every private name before this run assigns its own value;
# _SCODE_PLATFORM is deliberately absent -- it is a supported caller
# override.
unset _SCODE_ACCOUNT_FILE _SCODE_ACCOUNT_ID _SCODE_ACCOUNT_ARMED \
  _SCODE_ACCOUNT_PARENTS _SCODE_ACCOUNT_SINK _SCODE_START_TS \
  _SCODE_PENDING_INT_FILE _SCODE_TRAP_BUSY _SCODE_TRAP_BUSY_DIR \
  _SCODE_SANDBOX_LAUNCH_ATTEMPTED _SCODE_LOG_TMP_DIR
# Note this is not an integrity boundary: a sink placed inside the
# sandbox's writable area can still be written by the command, so put it
# outside (crew and codemux place it in their own output directories).
case "${SCODE_ACCOUNT_FILE:-}" in
  "") _SCODE_ACCOUNT_FILE="" ;;
  /*) _SCODE_ACCOUNT_FILE="${SCODE_ACCOUNT_FILE}" ;;
  *) _SCODE_ACCOUNT_FILE="${PWD}/${SCODE_ACCOUNT_FILE}" ;;
esac
# The directories on the sink's path are fingerprinted, not just the
# final file: the command can replace a parent (a project logs/ directory)
# with a symlink aimed outside the sandbox, and appending through it would
# write outside with full privileges. stat is taken of every ancestor at
# arm time and compared at write time, so a swap mid-run changes the
# identity the append would traverse and the record is dropped instead.
# The stat follows links (-L): an ancestor that already is a symlink is
# fingerprinted by the directory the traversal reaches, never by the
# link's own inode, so swapping the link's target mid-run changes the
# fingerprint the same way a swapped directory does. Stable system links
# (macOS /tmp -> private/tmp) still keep the same identity and are fine
# -- the check answers "did anything on the resolved path change", not
# "is any component a link". Not race-free -- a swap between the last
# stat and the append's open stays a microsecond window -- but the
# swap-at-leisure hole is closed. The final component is not visited: a
# not-yet-existing sink must not disable accounting.
# shellcheck disable=SC2329  # called from the arm-time check and the EXIT trap
_scode_sink_parents_fingerprint() {
  local _rest _cur="" _comp _st _out=""
  _rest="${1%/*}"
  _rest="${_rest#/}"
  while [[ -n "$_rest" ]]; do
    _comp="${_rest%%/*}"
    _cur="${_cur}/${_comp}"
    # -L follows links (see the block comment above): the identity is
    # the directory the traversal reaches, not a symlink's own inode.
    # SCODE_STAT_FLAVOR is the repo-wide dispatch: GNU stat -f prints
    # filesystem status and exits 0, so a `stat -f ... || stat -c ...`
    # chain never reaches the fallback on Linux (see the flavor probe at
    # the top of this file). || true keeps an unreadable entry on the
    # designed path below instead of tripping errexit, matching the
    # other fallible captures in this script. An "x" slot can never
    # match an armed fingerprint.
    if [[ "${SCODE_STAT_FLAVOR}" == "gnu" ]]; then
      _st="$(stat -L -c '%d:%i' "${_cur}" 2>/dev/null || true)"
    else
      _st="$(stat -L -f '%d:%i' "${_cur}" 2>/dev/null || true)"
    fi
    [[ -n "$_st" ]] || _st="x"
    _out="${_out}:${_st}"
    _rest="${_rest#"${_comp}"}"
    _rest="${_rest#/}"
  done
  if [[ -z "$_out" ]]; then
    # A sink directly in / has one ancestor, the root itself.
    if [[ "${SCODE_STAT_FLAVOR}" == "gnu" ]]; then
      _st="$(stat -L -c '%d:%i' "/" 2>/dev/null || true)"
    else
      _st="$(stat -L -f '%d:%i' "/" 2>/dev/null || true)"
    fi
    [[ -n "$_st" ]] || _st="x"
    printf '%s' "${_st}"
    return 0
  fi
  printf '%s' "${_out#:}"
}
# The sink validation and the sink open happen at the arming point below:
# together, after option parsing, so --help, --version, and audit never
# touch the sink path, and long before the launcher chain starts, so no
# future descendant can race them.
# The id accepts letters, digits, and . _ : -, at most 128 characters (the
# same bound codemux enforces). A longer id is dropped like an invalid one:
# records must stay small enough that one record is one append write (see
# write_account_record).
_SCODE_ACCOUNT_ID=""
case "${SCODE_ACCOUNT_ID:-}" in
  "") ;;
  *[!A-Za-z0-9._:-]*) ;;
  *) if (( ${#SCODE_ACCOUNT_ID} <= 128 )); then _SCODE_ACCOUNT_ID="${SCODE_ACCOUNT_ID}"; fi ;;
esac
# Only the public names are unset here: their values were read into the
# private names above, which were cleared before that.
unset SCODE_ACCOUNT_FILE SCODE_ACCOUNT_ID
_SCODE_START_TS="$(date +%s)"
_SCODE_ACCOUNT_ARMED=0
# Set once an engine launch was attempted, so the accounting record can tell
# "no launch was ever attempted" (dry-run, engine not found) from "a launch
# ran" (Linux tmpfs). Both runners set it immediately before they fork the
# engine, so the window between the fork and the runner returning is covered
# too. Whether the sandbox actually formed is not observable from outside:
# a bwrap exec failure looks like any other non-zero exit.
_SCODE_SANDBOX_LAUNCH_ATTEMPTED=0
# Assigned first thing inside the EXIT trap (trap string, not visible to lint).
_scode_trap_rc=""

# -------- Teardown and usage accounting --------
# Defined early and the EXIT trap installed here so every exit path after
# argument validation tears down scratch state and records accounting —
# including failed launches (unknown command, missing engine, config errors).

# shellcheck disable=SC2329,SC2317  # invoked via EXIT trap below
cleanup_no_sandbox_link() {
  if [[ -n "${SCODE_NO_SANDBOX_LINK:-}" ]]; then
    rm -f "${SCODE_NO_SANDBOX_LINK}"
  fi
  if [[ -n "${SCODE_NO_SANDBOX_TMPDIR:-}" ]]; then
    rmdir "${SCODE_NO_SANDBOX_TMPDIR}" 2>/dev/null || true
  fi
  if [[ -n "${SCODE_DARWIN_TMPDIR:-}" ]]; then
    rm -rf -- "${SCODE_DARWIN_TMPDIR}" 2>/dev/null || true
    # The scratch dir is child-writable, so the command can create
    # directories it locks (mode 000), which rm cannot descend into.
    # Teardown is a guarantee, not a best effort: grant the owner the
    # minimum needed to enumerate and unlink — on directories only.
    # Unlink needs write on the parent directory, never on the file, and a
    # file the command hard-linked into scratch shares its inode with any
    # outside copy, so a recursive file-mode change would reach outside
    # scratch. Bounded retries cover nesting, because opening one locked
    # directory can reveal deeper ones the previous pass could not see.
    local _attempt=0
    # The path is always absolute -- mktemp under an absolute root is the
    # only producer. The guard keeps a future producer from reintroducing
    # a relative start: -execdir would then resolve the root entry from
    # the caller's working directory, where a basename collision could
    # point the chmod at a project entry instead of the scratch.
    while [[ -d "${SCODE_DARWIN_TMPDIR}" && "${SCODE_DARWIN_TMPDIR}" == /* ]] && (( _attempt < 64 )); do
      # Each pass can expose exactly one more locked level (a mode-000 parent
      # hides everything beneath it from find), so the cap bounds nesting
      # depth, not effort; 64 is far deeper than any real tree and the loop
      # ends the moment rm succeeds. It stays a cap because a child can also
      # pin files with chflags, where the kernel itself refuses -- failing
      # loudly below is the honest end of the teardown promise.
      # -execdir resolves each entry from inside the directory find already
      # holds open, so a swapped ancestor cannot redirect the chmod, and -h
      # changes the mode of a symlink itself, never of its target.
      find "${SCODE_DARWIN_TMPDIR}" -type d -execdir chmod -h u+rwx {} \; 2>/dev/null || true
      rm -rf -- "${SCODE_DARWIN_TMPDIR}" 2>/dev/null || true
      _attempt=$((_attempt + 1))
    done
    if [[ -d "${SCODE_DARWIN_TMPDIR}" ]]; then
      # || true: with stderr closed the warning itself fails, and under
      # errexit that would abort the EXIT trap and skip the cleanup
      # statements after it.
      printf 'scode: scratch directory could not be fully removed: %s\n' "${SCODE_DARWIN_TMPDIR}" >&2 || true
    fi
  fi
  return 0
}

# Append one JSON line describing this run's scratch usage to the accounting
# file (when armed and requested). Called from the EXIT trap BEFORE
# cleanup_no_sandbox_link, so the scratch directory is still measurable.
# Best-effort by design: accounting must never alter the sandbox's exit path
# or skip teardown, so every fallible statement is guarded against errexit.
# shellcheck disable=SC2329,SC2317  # invoked via EXIT trap below
write_account_record() {
  local _rc="$1"
  local _account_file="${_SCODE_ACCOUNT_FILE:-}"
  [[ "${_SCODE_ACCOUNT_ARMED:-0}" -eq 1 ]] || return 0
  [[ -n "$_account_file" ]] || return 0
  # Re-checked at write time, which runs after the sandbox has exited.
  # The append itself travels through the descriptor opened at arm time,
  # so these checks decide only whether the record is written at all: a
  # path that no longer leads to a regular file -- a symlink, a FIFO, a
  # missing file -- drops the record with a warning instead of writing
  # anywhere else. There is no open left to race, so Bash's missing
  # O_NOFOLLOW cannot bite here. Sinks inside the child-writable
  # area were already discouraged at arm time.
  if [[ -L "$_account_file" || ( -e "$_account_file" && ! -f "$_account_file" ) ]]; then
    # Every warning here carries || true: this function runs in the EXIT
    # trap, and with stderr closed the warning itself fails -- under
    # errexit that would abort the trap before scratch teardown.
    printf 'scode: the accounting sink is not a regular file at write time; record dropped\n' >&2 || true
    return 0
  fi
  # The append must traverse the same directories that existed when
  # accounting was armed; a swapped ancestor (a symlink aimed outside the
  # sandbox, a deleted directory) changes the fingerprint and the record
  # is dropped.
  if [[ "$(_scode_sink_parents_fingerprint "$_account_file")" != "${_SCODE_ACCOUNT_PARENTS}" ]]; then
    printf 'scode: a directory on the accounting sink path changed during the run; record dropped\n' >&2 || true
    return 0
  fi
  # The path must still be the file the arm-time descriptor holds: a
  # sink unlinked and recreated as another regular file passes the
  # symlink check and the ancestor fingerprint, and the record must be
  # dropped instead of vanishing into the orphaned original.
  local _sink_now
  if [[ "${SCODE_STAT_FLAVOR}" == "gnu" ]]; then
    _sink_now="$(stat -L -c '%d:%i' "${_account_file}" 2>/dev/null || true)"
  else
    _sink_now="$(stat -L -f '%d:%i' "${_account_file}" 2>/dev/null || true)"
  fi
  if [[ "${_sink_now}" != "${_SCODE_ACCOUNT_SINK:-}" ]]; then
    printf 'scode: the accounting sink was replaced during the run; record dropped\n' >&2 || true
    return 0
  fi
  local _now _end_ts _start_ts _dur _bytes _reason _path_json _id_json _du_out _du_rc _platform
  _now="$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)" || _now="$(date +%s)"
  [[ -n "$_now" ]] || _now="unknown"
  # Both operands are validated before the arithmetic expansion: a
  # capture that came back empty or garbled -- a failed date(1), a
  # truncated read, anything at all -- must never reach the arithmetic.
  # Arithmetic on such a string is a syntax error, and a syntax error
  # aborts this trap outright: no record, and teardown skipped with it.
  # On any doubt the duration is recorded as null instead of computed.
  _end_ts="$(date +%s 2>/dev/null)"
  _start_ts="${_SCODE_START_TS:-}"
  if [[ "$_end_ts" =~ ^[0-9]+$ && "$_start_ts" =~ ^[0-9]+$ ]]; then
    _dur=$(( _end_ts - _start_ts ))
  else
    _dur="null"
  fi
  _bytes=""
  _reason="no_scratch"
  _path_json="null"
  _id_json="null"
  if [[ -n "${_SCODE_ACCOUNT_ID:-}" ]]; then
    _id_json="\"${_SCODE_ACCOUNT_ID}\""
  fi
  if [[ -n "${SCODE_DARWIN_TMPDIR:-}" && -d "${SCODE_DARWIN_TMPDIR}" ]]; then
    # The scratch dir is child-writable, so du can fail mid-walk (a mode-000
    # directory, a concurrently deleted file). du still prints a partial
    # total when it fails, and accepting it would underreport, so du's own
    # exit status (not the pipeline's, which is awk's) decides: record null
    # with reason "du_failed" instead of a partial number.
    _du_out="$(du -sk "${SCODE_DARWIN_TMPDIR}" 2>/dev/null)" && _du_rc=0 || _du_rc=$?
    case "${SCODE_DARWIN_TMPDIR}" in
      *[!A-Za-z0-9/._-]*) _path_json="null" ;;
      *) _path_json="\"${SCODE_DARWIN_TMPDIR}\"" ;;
    esac
    if [[ "$_du_rc" -eq 0 ]]; then
      _bytes="$(printf '%s\n' "$_du_out" | awk 'NR==1{print $1}')"
      _reason=""
    else
      _reason="du_failed"
    fi
  elif [[ "${PLATFORM:-}" == "linux" && "${_SCODE_SANDBOX_LAUNCH_ATTEMPTED:-0}" -eq 1 ]]; then
    # /tmp is a tmpfs inside the bwrap namespace; it is gone by the time the
    # parent could measure it. Any run that reached the launch stage gets
    # this label: whether the namespace actually formed is not observable
    # from outside (a bwrap exec failure returns like any other non-zero
    # exit), and a namespace that did form is unmeasurable either way. Only
    # runs that never attempted a launch keep the default no_scratch --
    # on Linux that is dry-run and engine-not-found; on macOS an
    # engine-not-found run already created the private scratch directory
    # (it exists before the engine check), so that case is recorded with
    # scratch_kib 0 above instead.
    _reason="tmpfs_unmeasurable"
  fi
  # One append, one record. Concurrent scode runs may share a sink, and a
  # record that spills bash's output buffer is emitted through several
  # write() calls -- another writer's record can interleave between them
  # and corrupt both lines (reproduced with 1 KiB records under bash 3.2).
  # A single-conversion printf of a bounded record is flushed in one
  # write, and one append write to a regular file is atomic against other
  # appenders on both platforms; 800 bytes measured safe on bash 3.2 and
  # 5.x. The id is capped at arm time, so only a pathological scratch path
  # can push a record over the bound: drop the path first, then the whole
  # record, rather than emit a line another writer could split.
  # The platform normally comes from detection, but an early exit (a bad
  # -C, say) can reach this record before detection ran, carrying the
  # caller's inherited value -- arbitrary text the record format cannot
  # hold. Only the two values detection produces are recorded; anything
  # else is "unknown".
  case "${PLATFORM:-}" in
    darwin|linux) _platform="${PLATFORM}" ;;
    *) _platform="unknown" ;;
  esac
  local _fmt _record _nb
  _fmt='{"ts":"%s","event":"scode_exit","platform":"%s","exit_code":%s,"duration_s":%s,"scratch_kib":%s,"scratch_path":%s,"account_id":%s,"reason":"%s"}'
  # shellcheck disable=SC2059  # _fmt is the fixed record format assigned
  # above; every field travels as a printf argument, never inside it.
  _record="$(printf "$_fmt" "$_now" "${_platform}" "$_rc" "$_dur" \
    "${_bytes:-null}" "$_path_json" "$_id_json" "$_reason")"
  # The bound is bytes, not characters: the single-append guarantee is a
  # write-size guarantee, and a multibyte path or id can pass a character
  # check while the record still splits across writes. wc -c counts the
  # bytes the append will emit; an unmeasurable record counts as over the
  # bound, because an unsized record is the one that can fragment.
  _nb="$(printf '%s' "${_record}" | wc -c | tr -d " ")" || _nb=999999
  if (( _nb > 800 )); then
    _path_json="null"
    # shellcheck disable=SC2059  # same fixed format as above
    _record="$(printf "$_fmt" "$_now" "${_platform}" "$_rc" "$_dur" \
      "${_bytes:-null}" "$_path_json" "$_id_json" "$_reason")"
    _nb="$(printf '%s' "${_record}" | wc -c | tr -d " ")" || _nb=999999
  fi
  if (( _nb > 800 )); then
    printf 'scode: accounting record exceeded the single-append bound; record dropped\n' >&2 || true
    return 0
  fi
  if ! printf '%s' "${_record}"$'\n' >&4 2>/dev/null; then
    # A write can fail partway (a full disk, a file-size limit), leaving
    # a fragment without its terminating newline that the next append
    # would join onto one corrupt line. Report the failure, then seal the
    # fragment with a best-effort newline. The run's own status and the
    # teardown are never touched: accounting must stay invisible when it
    # fails.
    printf 'scode: accounting append failed; the sink may hold a partial record\n' >&2 || true
    printf '\n' >&4 2>/dev/null || true
  fi
  exec 4>&-
  return 0
}

# The EXIT trap reads all five of these. Initialize them here, before
# any exit path exists, so an inherited environment cannot aim the
# trap's pending-file, busy-mark, or log-directory cleanup at an
# unrelated path or forge an armed accounting flag on runs that leave
# before the runners start. _SCODE_ACCOUNT_PARENTS is absent on purpose:
# it is first assigned at arming, after option parsing, and
# write_account_record reads it only when accounting is armed, so an
# init line here would be dead. The startup unset list already clears
# any inherited value.
_SCODE_PENDING_INT_FILE=""
_SCODE_TRAP_BUSY=""
_SCODE_TRAP_BUSY_DIR=""
_SCODE_LOG_TMP_DIR=""
_SCODE_ACCOUNT_ARMED=0
trap '_scode_trap_rc=$?
      # Teardown is a guarantee: a signal arriving mid-trap -- during the
      # du traversal, say -- must not run the exit handlers again and
      # abandon the remaining cleanup. The captured exit status was
      # taken first and stands. A QUIT run can reach this trap with the
      # engine still alive -- the runners exit 131 from their QUIT
      # handlers -- and that engine is left running as the documented
      # orphan trade-off; a follow-up signal must not recurse the
      # handlers either. A no-op handler (no quoting gymnastics inside
      # this string) holds the signals off.
      trap : INT TERM HUP QUIT
      # The trap runs with SIGPIPE ignored: every write it issues is
      # best-effort and failure-guarded, but a stderr whose reader is
      # already gone would kill the shell by signal in the middle of
      # the trap -- skipping the remaining teardown and replacing the
      # run status -- and no || true catches a signal death. Mid-run
      # writes keep the conventional disposition; this trap is where
      # the run owes the record, the teardown, and the true exit
      # status, and those must survive a dead reader.
      trap "" PIPE
      write_account_record "$_scode_trap_rc" || true; cleanup_no_sandbox_link; if [[ -n "${_SCODE_PENDING_INT_FILE:-}" ]]; then rm -f "${_SCODE_PENDING_INT_FILE}" 2>/dev/null || true; fi; if [[ -n "${_SCODE_TRAP_BUSY_DIR:-}" ]]; then rm -rf "${_SCODE_TRAP_BUSY_DIR}" 2>/dev/null || true; fi; if [[ -n "${_SCODE_LOG_TMP_DIR:-}" ]]; then rm -rf "${_SCODE_LOG_TMP_DIR}" 2>/dev/null || true; fi' EXIT

# A fatal signal kills bash while $? still holds the last command's status,
# so the EXIT trap above would record that stale status (typically 0) as
# the run's exit code. Exit with the conventional signal code instead; the
# EXIT trap then records it and still tears down. The foreground runner
# replaces these with child-forwarding handlers while the engine runs.
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP
trap 'exit 131' QUIT
# A caller file-size limit (ulimit -f) turns the first regular-file write
# past the limit into SIGXFSZ, whose default action kills the shell --
# the EXIT-trap append included, which would skip the teardown and
# replace the run's own status. scode ignores the signal, so a refused
# write fails like any other failed write: warned, record dropped,
# teardown intact. The launch chain restores the default disposition for
# the engine itself.
trap '' XFSZ

# The pending-INT record writes through fd 7. Closing it here makes the
# state before the runner's open deterministic: a caller who spawned
# scode with fd 7 open would otherwise receive the record when the
# pending file's creation failed, where the documented degrade is a
# silent failure.
{ exec 7>&-; } 2>/dev/null || true

# Validate env-sourced values early
case "$NET_MODE" in
  on|off) ;;
  *) error "invalid SCODE_NET value: '$NET_MODE' (expected 'on' or 'off')"; exit 1 ;;
esac
case "$FS_MODE" in
  rw|ro) ;;
  *) error "invalid SCODE_FS_MODE value: '$FS_MODE' (expected 'rw' or 'ro')"; exit 1 ;;
esac

DRY_RUN=0
STRICT=0
SCRUB_ENV=0
GROK_DEFENSE=0
CREDENTIAL_SYNC=1
LOG_FILE=""
PROJECT_DIR=""

COMMAND=()
CLI_BLOCKED=()
CLI_ALLOWED=()
CONFIG_BLOCKED=()
CONFIG_ALLOWED=()
# String configs init to "" (unset means "use default"); boolean configs also
# init to "" so explicit false can be distinguished from "not configured".
# parse_config() sets these via eval with a CONFIG_ prefix.
CONFIG_NET=""
CONFIG_FS_MODE=""
CONFIG_STRICT=""
CONFIG_SCRUB_ENV=""
CONFIG_GROK_DEFENSE=""

# Track CLI-explicit flags (so config doesn't override them)
CLI_NET=0
CLI_FS_MODE=0
CLI_STRICT=0
CLI_SCRUB_ENV=0
CLI_TRUST=""
CLI_CONFIG_SEEN=0
CLI_CWD_SEEN=0
CLI_LOG_SEEN=0

# -------- Option parsing --------

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    -V|--version)
      version
      exit 0
      ;;
    -n|--no-net)
      NET_MODE="off"
      CLI_NET=1
      shift
      ;;
    --strict)
      STRICT=1
      CLI_STRICT=1
      shift
      ;;
    --trust)
      if [[ $# -lt 2 ]]; then
        error "missing argument for $1"
        exit 1
      fi
      if [[ -n "$CLI_TRUST" ]]; then
        error "--trust specified more than once (was '$CLI_TRUST', got '$2')"
        exit 1
      fi
      CLI_TRUST="$2"
      case "$2" in
        trusted)
          # Minimal sandbox: rw, net on, no strict, no scrub.
          # Sets CLI_* flags so config files cannot override these values.
          if [[ "$CLI_FS_MODE" -eq 0 ]]; then FS_MODE="rw"; CLI_FS_MODE=1; fi
          if [[ "$CLI_NET" -eq 0 ]]; then NET_MODE="on"; CLI_NET=1; fi
          if [[ "$CLI_STRICT" -eq 0 ]]; then STRICT=0; CLI_STRICT=1; fi
          if [[ "$CLI_SCRUB_ENV" -eq 0 ]]; then SCRUB_ENV=0; CLI_SCRUB_ENV=1; fi
          ;;
        standard)
          # Default behavior — no changes needed
          ;;
        untrusted)
          # Maximum lockdown: strict + no-net + scrub-env + ro.
          # Sets CLI_* flags so config files cannot weaken the lockdown.
          if [[ "$CLI_STRICT" -eq 0 ]]; then STRICT=1; CLI_STRICT=1; fi
          if [[ "$CLI_NET" -eq 0 ]]; then NET_MODE="off"; CLI_NET=1; fi
          if [[ "$CLI_SCRUB_ENV" -eq 0 ]]; then SCRUB_ENV=1; CLI_SCRUB_ENV=1; fi
          if [[ "$CLI_FS_MODE" -eq 0 ]]; then FS_MODE="ro"; CLI_FS_MODE=1; fi
          ;;
        *)
          error "unknown trust level: $2 (expected: trusted, standard, untrusted)"
          exit 1
          ;;
      esac
      shift 2
      ;;
    --config)
      if [[ $# -lt 2 ]]; then
        error "missing argument for $1"
        exit 1
      fi
      if [[ "$CLI_CONFIG_SEEN" -eq 1 ]]; then
        error "--config specified more than once"
        exit 1
      fi
      CONFIG_FILE="$(expand_path "$2")"
      CONFIG_FILE_EXPLICIT=1
      CLI_CONFIG_SEEN=1
      shift 2
      ;;
    --no-credential-sync)
      CREDENTIAL_SYNC=0
      shift
      ;;
    --scrub-env)
      SCRUB_ENV=1
      CLI_SCRUB_ENV=1
      shift
      ;;
    -C|--cwd)
      if [[ $# -lt 2 ]]; then
        error "missing argument for $1"
        exit 1
      fi
      if [[ "$CLI_CWD_SEEN" -eq 1 ]]; then
        error "--cwd specified more than once"
        exit 1
      fi
      PROJECT_DIR="$(expand_path "$2")"
      CLI_CWD_SEEN=1
      shift 2
      ;;
    --ro)
      FS_MODE="ro"
      CLI_FS_MODE=1
      shift
      ;;
    --rw)
      FS_MODE="rw"
      CLI_FS_MODE=1
      shift
      ;;
    --block)
      if [[ $# -lt 2 ]]; then
        error "missing argument for $1"
        exit 1
      fi
      validate_path "$2"
      CLI_BLOCKED+=("$2")
      shift 2
      ;;
    --allow)
      if [[ $# -lt 2 ]]; then
        error "missing argument for $1"
        exit 1
      fi
      validate_path "$2"
      CLI_ALLOWED+=("$2")
      shift 2
      ;;
    --log)
      if [[ $# -lt 2 ]]; then
        error "missing argument for $1"
        exit 1
      fi
      if [[ "$CLI_LOG_SEEN" -eq 1 ]]; then
        error "--log specified more than once"
        exit 1
      fi
      LOG_FILE="$(expand_output_path "$2")"
      CLI_LOG_SEEN=1
      shift 2
      ;;
    --dry-run)
      DRY_RUN=1
      shift
      ;;
    --)
      shift
      COMMAND=("$@")
      break
      ;;
    -*)
      error "unknown option: $1"
      echo "Try '${PROGRAM_NAME} --help' for more information." >&2
      exit 1
      ;;
    audit)
      shift
      _audit_watch=0
      if [[ "${1:-}" == "--watch" || "${1:-}" == "-w" ]]; then
        _audit_watch=1
        shift
      fi
      if [[ $# -ne 1 ]]; then
        error "usage: ${PROGRAM_NAME} audit [--watch|-w] <logfile>"
        exit 1
      fi
      detect_platform
      if [[ "$_audit_watch" -eq 1 ]]; then
        audit_watch "$(expand_path "$1")"
      else
        audit_log "$(expand_path "$1")"
      fi
      exit $?
      ;;
    *)
      # Check if it's a known harness or start of command
      COMMAND=("$@")
      break
      ;;
  esac
done

# Argument validation is over: every exit from here on is a run (or a failed
# launch) and gets a teardown/accounting pass from the EXIT trap.
_SCODE_ACCOUNT_ARMED=1

# The EXIT-trap append must never block or follow a link: an existing sink
# that is a symlink, FIFO, device, or socket disables accounting at arm
# time (a symlink is refused even when dangling, since the append would
# create its target). Re-checked at write time in case of a swap.
if [[ -n "${_SCODE_ACCOUNT_FILE}" && ( -L "${_SCODE_ACCOUNT_FILE}" || ( -e "${_SCODE_ACCOUNT_FILE}" && ! -f "${_SCODE_ACCOUNT_FILE}" ) ) ]]; then
  # || true: with stderr closed the warning itself fails, and under errexit
  # it would abort before the accounting is disabled below.
  printf 'scode: SCODE_ACCOUNT_FILE is not a regular file (symlinks are rejected too); accounting disabled\n' >&2 || true
  _SCODE_ACCOUNT_FILE=""
fi
# An "x" slot means an ancestor was missing or unreadable at arm time;
# the documented contract is a parent that already exists.
if [[ -n "${_SCODE_ACCOUNT_FILE}" ]]; then
  _SCODE_ACCOUNT_PARENTS="$(_scode_sink_parents_fingerprint "${_SCODE_ACCOUNT_FILE}")"
  if [[ -z "${_SCODE_ACCOUNT_PARENTS}" || "${_SCODE_ACCOUNT_PARENTS}" == *x* ]]; then
    printf 'scode: could not read every directory on the SCODE_ACCOUNT_FILE path; accounting disabled\n' >&2 || true
    _SCODE_ACCOUNT_FILE=""
    _SCODE_ACCOUNT_PARENTS=""
  fi
fi
if [[ -n "${_SCODE_ACCOUNT_FILE}" ]]; then
  # The record append travels through this descriptor, opened once here
  # at arm time -- the pending-INT pattern. Arming sits after option
  # parsing, so --help, --version, and audit exit before this point and
  # create no sink file. Reopening the path in the exit trap would
  # leave a window between the last validation and the open where a
  # surviving sandbox descendant could swap the sink for a symlink
  # aimed outside the sandbox and the append would follow it. A missing
  # sink is created here instead of at write time, and the launcher
  # chain starts only later, so nothing can race the open. The
  # write-time checks still run and drop the record when the path no
  # longer leads to the file this descriptor holds open.
  if { exec 4>>"${_SCODE_ACCOUNT_FILE}"; } 2>/dev/null; then
    if [[ "${SCODE_STAT_FLAVOR}" == "gnu" ]]; then
      _SCODE_ACCOUNT_SINK="$(stat -L -c '%d:%i' "${_SCODE_ACCOUNT_FILE}" 2>/dev/null || true)"
    else
      _SCODE_ACCOUNT_SINK="$(stat -L -f '%d:%i' "${_SCODE_ACCOUNT_FILE}" 2>/dev/null || true)"
    fi
    if [[ -z "${_SCODE_ACCOUNT_SINK}" ]]; then
      printf 'scode: could not identify the accounting sink; accounting disabled\n' >&2 || true
      _SCODE_ACCOUNT_FILE=""
      _SCODE_ACCOUNT_PARENTS=""
      { exec 4>&-; } 2>/dev/null || true
    fi
  else
    printf 'scode: could not open the accounting sink; accounting disabled\n' >&2 || true
    _SCODE_ACCOUNT_FILE=""
    _SCODE_ACCOUNT_PARENTS=""
  fi
fi

# Default command
if [[ ${#COMMAND[@]} -eq 0 ]]; then
  COMMAND=("opencode")
fi
validate_path "${COMMAND[0]}"
REQUESTED_COMMAND=("${COMMAND[@]}")

# Default project dir
if [[ -z "${PROJECT_DIR}" ]]; then
  PROJECT_DIR="${PWD}"
fi

validate_path "${PROJECT_DIR}"

if [[ ! -d "${PROJECT_DIR}" ]]; then
  error "project directory does not exist: ${PROJECT_DIR}"
  exit 1
fi

PROJECT_DIR="$(_realpath "${PROJECT_DIR}")"

# Resolve command paths from the requested working directory. Relative command
# paths and relative PATH entries otherwise resolve against the caller's PWD,
# even though execution happens from PROJECT_DIR.
COMMAND_BINARY_PATH=""
_command_lookup=""
if [[ "${COMMAND[0]}" == */* ]]; then
  if [[ "${COMMAND[0]}" == /* ]]; then
    _command_lookup="${COMMAND[0]}"
  else
    _command_lookup="${PROJECT_DIR}/${COMMAND[0]}"
  fi
else
  # shellcheck disable=SC2015  # `|| true` only forces an empty lookup on failure
  _command_lookup="$(cd "${PROJECT_DIR}" && PATH="$SCODE_CALLER_PATH" type -P -- "${COMMAND[0]}" 2>/dev/null || true)"
  case "$_command_lookup" in
    /*) ;;
    ./*|../*|*/*) _command_lookup="${PROJECT_DIR}/${_command_lookup}" ;;
    *) _command_lookup="" ;;
  esac
fi
if [[ -n "$_command_lookup" && -e "$_command_lookup" ]]; then
  validate_path "$_command_lookup"
  COMMAND_BINARY_PATH="$(_realpath "$_command_lookup")"
  validate_path "$COMMAND_BINARY_PATH"
  # Execute the same canonical object that passed validation. A second PATH
  # lookup after policy construction would reintroduce a TOCTOU substitution.
  # Dry-run keeps the requested spelling so its rendered command stays useful.
  if [[ "$DRY_RUN" -eq 0 || "${COMMAND[0]}" == */* ]]; then
    COMMAND[0]="$COMMAND_BINARY_PATH"
  fi
fi

# -------- Platform detection & validation --------

detect_platform

# macOS allocates a private per-user temporary directory below /var/folders.
# Strict mode may write only to that canonical, owner-only directory—not the
# entire shared /var/folders tree. An attacker-controlled TMPDIR outside that
# namespace is ignored.
if [[ "$PLATFORM" == "darwin" ]]; then
  _tmp_root="/private/tmp"
  if [[ -n "${TMPDIR:-}" && ! "$TMPDIR" =~ [[:cntrl:]] ]]; then
    _tmp_candidate="$(_realpath "$TMPDIR")"
    _tmp_owner="$(stat -f '%u' "$_tmp_candidate" 2>/dev/null || true)"
    _tmp_mode="$(stat -f '%Lp' "$_tmp_candidate" 2>/dev/null || true)"
    if [[ "$_tmp_candidate" == /private/var/folders/*/T && -d "$_tmp_candidate" && \
          "$_tmp_owner" == "$UID" && "$_tmp_mode" == "700" ]]; then
      _tmp_root="$_tmp_candidate"
    fi
  fi
  if [[ "$DRY_RUN" -eq 1 ]]; then
    SAFE_DARWIN_TMPDIR="${_tmp_root%/}/scode.${UID}.dry-run"
  elif SCODE_DARWIN_TMPDIR="$(mktemp -d "${_tmp_root%/}/scode.${UID}.XXXXXX")"; then
    chmod 700 "$SCODE_DARWIN_TMPDIR"
    SAFE_DARWIN_TMPDIR="$SCODE_DARWIN_TMPDIR"
    TMPDIR="${SCODE_DARWIN_TMPDIR}/"
    export TMPDIR
  else
    error "failed to create a private macOS temporary directory"
    exit 1
  fi
fi

SANDBOX_ENGINE=""
case "$PLATFORM" in
  darwin) SANDBOX_ENGINE="/usr/bin/sandbox-exec" ;;
  linux) SANDBOX_ENGINE="/usr/bin/bwrap" ;;
esac

# Validate sandbox engine exists (skip for dry-run since we won't exec)
if [[ "${DRY_RUN}" -eq 0 ]]; then
  if [[ "$PLATFORM" == "darwin" ]]; then
    if [[ ! -x "$SANDBOX_ENGINE" ]]; then
      error "sandbox-exec not found (are you on macOS?)"
      exit 1
    fi
  elif [[ "$PLATFORM" == "linux" ]]; then
    if [[ ! -x "$SANDBOX_ENGINE" ]]; then
      error "bwrap not found. Install bubblewrap:"
      error "  Debian/Ubuntu: apt install bubblewrap"
      error "  Fedora/RHEL:   dnf install bubblewrap"
      exit 1
    fi
  fi
fi

if [[ "${DRY_RUN}" -eq 0 ]]; then
  if [[ "${COMMAND[0]}" == */* ]]; then
    if [[ -z "$COMMAND_BINARY_PATH" || ! -f "$COMMAND_BINARY_PATH" || ! -x "$COMMAND_BINARY_PATH" ]]; then
      error "command not found or not executable: ${COMMAND[0]}"
      exit 1
    fi
  elif [[ -z "$COMMAND_BINARY_PATH" || ! -f "$COMMAND_BINARY_PATH" || ! -x "$COMMAND_BINARY_PATH" ]]; then
    error "command not found: ${COMMAND[0]}"
    exit 1
  fi
fi

DETECTED_HARNESS=""
if DETECTED_HARNESS="$(detect_harness)"; then
  :
else
  warning "'${COMMAND[0]}' is not a known harness — sandbox behavior has not been tested for this command"
fi

# kcov runs only on Linux, so this macOS-only code can never be executed under
# coverage. The guards that warn are exercised by test/10_credential_sync.bats
# on the macOS CI job; excluding it here keeps the percentage honest instead of
# penalizing unreachable lines.
# SCODE_COVERAGE_EXCLUDE_START
# Claude Code keeps its credential in the macOS Keychain, which the sandbox
# blocks along with the rest of ~/Library, so a sandboxed claude reports
# "Not logged in" against a perfectly valid session. It also reads a file store
# at ~/.claude/.credentials.json, inside the directory the harness auto-allow
# already covers.
#
# Copying the credential there by hand does not hold: a token refresh migrates
# it back to the Keychain and deletes the file. So the copy is made here, in the
# parent process, which is still outside the sandbox and can read the Keychain.
#
# This puts the refresh token in a file the sandboxed agent can read, which is
# the same exposure every other harness already has for ~/.codex and the rest,
# and is what running a harness sandboxed costs. --no-credential-sync declines
# it; sandboxed claude then cannot authenticate.
sync_claude_credential() {
  [[ "$PLATFORM" == "darwin" ]] || return 0
  # Homebrew's claude resolves through a symlink to claude.exe, so the detected
  # name carries the suffix that is_known_harness already strips.
  [[ "${DETECTED_HARNESS%.exe}" == "claude" ]] || return 0
  [[ "$CREDENTIAL_SYNC" -eq 1 ]] || return 0
  command -v security >/dev/null 2>&1 || return 0

  # Only write the credential where a sandboxed process could actually use it.
  # Everywhere else the copy is pure secrecy loss: it moves the refresh token
  # out of the Keychain, where per-binary ACLs guard it, into a file any process
  # running as this user can read, and buys nothing back.
  #
  # --dry-run promises to inspect without acting. --trust untrusted drops the
  # harness auto-allow, so the sandbox cannot read ~/.claude at all. And
  # blocking ~/.claude is a direct instruction to keep the credential away from
  # this run, which writing it there first would contradict.
  [[ "$DRY_RUN" -eq 1 ]] && return 0
  [[ "$CLI_TRUST" == "untrusted" ]] && return 0
  # Only a direct invocation is inspectable. Behind a wrapper -- env, nice,
  # timeout -- the binary scode resolved is the wrapper, and the harness it
  # finally executes is chosen by a PATH the wrapper sets, which is how
  # `env PATH=$PWD:$PATH claude` passed the check below as /usr/bin/env and
  # then ran a repository-controlled claude with the token in reach.
  if [[ "$(basename "${COMMAND_BINARY_PATH:-}")" != "${DETECTED_HARNESS}" ]]; then
    warning "not syncing the Claude credential: '${COMMAND[0]}' is a wrapper, so the harness it runs cannot be checked"
    return 0
  fi

  # A binary inside the project is not the installed harness. A repository can
  # ship its own ./claude, or a node_modules/.bin/claude, and PATH may well find
  # it first; copying the real OAuth token for that is handing a credential to
  # whatever the project chose to call itself. The harness auto-allow tolerates
  # a basename match because it only opens a directory; this writes a secret.
  local resolved="${COMMAND_BINARY_PATH:-}"
  if [[ -n "$resolved" && -n "${PROJECT_DIR:-}" ]]; then
    case "$(cd "$(dirname "$resolved")" 2>/dev/null && pwd -P)/" in
      "$(cd "$PROJECT_DIR" 2>/dev/null && pwd -P)"/*)
        warning "not syncing the Claude credential: '${resolved}' lives inside the project"
        return 0
        ;;
    esac
  fi

  # An explicit --allow re-opens a blocked path, so a block alone does not mean
  # the sandbox cannot reach the credential; consult the effective policy first.
  local _explicitly_allowed=0
  local _allowed_path
  for _allowed_path in ${ALL_ALLOWED[@]+"${ALL_ALLOWED[@]}"}; do
    case "$HOME/.claude/" in
      "$_allowed_path"/*|"$_allowed_path") _explicitly_allowed=1; break ;;
    esac
  done

  # Both the directory and the credential file itself, since blocking just the
  # file is a direct instruction not to expose it.
  if [[ "$_explicitly_allowed" -eq 0 ]]; then
    if is_allowed_in_list "$HOME/.claude/.credentials.json" \
         "${RESOLVED_CLI_BLOCKED[@]+"${RESOLVED_CLI_BLOCKED[@]}"}" \
         "${RESOLVED_CONFIG_BLOCKED[@]+"${RESOLVED_CONFIG_BLOCKED[@]}"}" \
         "${RESOLVED_PROJECT_BLOCKED[@]+"${RESOLVED_PROJECT_BLOCKED[@]}"}"; then
      return 0
    fi
    if is_allowed_in_list "$HOME/.claude" \
         "${RESOLVED_CLI_BLOCKED[@]+"${RESOLVED_CLI_BLOCKED[@]}"}" \
         "${RESOLVED_CONFIG_BLOCKED[@]+"${RESOLVED_CONFIG_BLOCKED[@]}"}" \
         "${RESOLVED_PROJECT_BLOCKED[@]+"${RESOLVED_PROJECT_BLOCKED[@]}"}"; then
      return 0
    fi
  fi

  # Declared separately: within one `local`, $dir is not yet assigned when a
  # later name on the same line expands it, which trips set -u.
  local dir="$HOME/.claude"
  local target="$dir/.credentials.json"
  local tmp=""
  [[ -d "$dir" ]] || return 0

  # Resolve where the write would actually land. HOME can be redirected and
  # ~/.claude can be a symlink, either of which would put the real refresh
  # token inside the repository being reviewed.
  local real_dir
  real_dir="$(cd "$dir" 2>/dev/null && pwd -P)" || return 0
  if [[ -n "${PROJECT_DIR:-}" ]]; then
    local real_project
    real_project="$(cd "$PROJECT_DIR" 2>/dev/null && pwd -P)" || real_project=""
    if [[ -n "$real_project" ]]; then
      case "$real_dir/" in
        "$real_project"/*)
          warning "not syncing the Claude credential: ${real_dir} is inside the project"
          return 0
          ;;
      esac
    fi
  fi

  local secret
  secret="$(security find-generic-password -s "Claude Code-credentials" -w 2>/dev/null)" || return 0
  [[ -n "$secret" ]] || return 0

  # Only the tokens matter; anything else means the item is not a credential we
  # can hand to the harness, and writing it would replace a working file.
  # The system interpreter by name, not $PYTHON_BIN: this one is fed the
  # credential on stdin, and an inherited variable should not choose what reads
  # it. macOS always ships /usr/bin/python3.
  printf '%s' "$secret" | /usr/bin/python3 -c '
import json, sys
try:
    d = json.load(sys.stdin).get("claudeAiOauth") or {}
except ValueError:
    raise SystemExit(1)
raise SystemExit(0 if d.get("accessToken") and d.get("refreshToken") else 1)
' 2>/dev/null || return 0

  # The Keychain is not always the newer copy. A refresh that happens inside the
  # sandbox writes the file and cannot write the Keychain, so copying
  # unconditionally would replace a live credential with a spent one -- and
  # since the provider invalidates the old refresh token when it issues a
  # replacement, that destroys the only working login. Whichever expires later
  # is the newer one, and it stays.
  if [[ -s "$target" ]]; then
    if /usr/bin/python3 -c '
import json, sys
def expiry(path):
    try:
        with open(path) as handle:
            return int((json.load(handle).get("claudeAiOauth") or {}).get("expiresAt") or 0)
    except (OSError, ValueError, TypeError):
        return -1
current = expiry(sys.argv[1])
incoming = int((json.loads(sys.stdin.read()).get("claudeAiOauth") or {}).get("expiresAt") or 0)
raise SystemExit(0 if current >= incoming else 1)
' "$target" <<< "$secret" 2>/dev/null; then
      return 0
    fi
  fi

  # Written under a random name and renamed, so a concurrent reader sees either
  # the old credential or the new one, never a partial file.
  tmp="$(mktemp "$dir/.credentials.XXXXXX" 2>/dev/null)" || return 0
  chmod 600 "$tmp" 2>/dev/null || true
  # A failure here is worth saying out loud: the harness will start and then
  # report itself logged out, which looks like an expired session rather than a
  # sandbox that could not hand over the credential.
  if printf '%s' "$secret" > "$tmp" 2>/dev/null && mv -f "$tmp" "$target" 2>/dev/null; then
    return 0
  fi
  rm -f "$tmp" 2>/dev/null || true
  warning "could not write ${target}; sandboxed claude will not be able to authenticate"
}
# SCODE_COVERAGE_EXCLUDE_END

# -------- Resolve config file --------

# Priority: --config flag > SCODE_CONFIG env var > default path
if [[ -z "${CONFIG_FILE}" ]]; then
  if [[ -n "${SCODE_CONFIG:-}" ]]; then
    CONFIG_FILE="$(expand_path "${SCODE_CONFIG}")"
    CONFIG_FILE_EXPLICIT=1
  else
    CONFIG_FILE="${DEFAULT_CONFIG_FILE}"
  fi
fi

if [[ "${CONFIG_FILE_EXPLICIT}" -eq 1 && ! -f "${CONFIG_FILE}" ]]; then
  error "config file not found: ${CONFIG_FILE}"
  exit 1
fi

# -------- Load config and merge --------

# Load user config (highest config priority)
parse_config "${CONFIG_FILE}" "CONFIG"

# Load per-project config (lower priority than user config)
PROJECT_CONFIG_FILE="${PROJECT_DIR%/}/.scode.yaml"
PROJECT_BLOCKED=()
PROJECT_ALLOWED=()
PROJECT_NET=""
PROJECT_FS_MODE=""
PROJECT_STRICT=""
PROJECT_SCRUB_ENV=""
PROJECT_GROK_DEFENSE=""
if [[ -L "${PROJECT_CONFIG_FILE}" ]]; then
  error "refusing symbolic-link project config: ${PROJECT_CONFIG_FILE}"
  exit 1
fi
if [[ -f "${PROJECT_CONFIG_FILE}" ]]; then
  # Pin the repository-controlled config to one verified descriptor so a
  # concurrent rename/symlink swap cannot redirect host-side reads.
  if ! exec 8<"${PROJECT_CONFIG_FILE}"; then
    error "failed to open project config: ${PROJECT_CONFIG_FILE}"
    exit 1
  fi
  _project_cfg_path_identity="$(_stat_field inode "$PROJECT_CONFIG_FILE")"
  _project_cfg_fd_identity="$(_stat_field inode /dev/fd/8)"
  _project_cfg_owner_links="$(_stat_field owner_links /dev/fd/8)"
  _project_cfg_canonical="$(_realpath "$PROJECT_CONFIG_FILE")"
  if [[ -z "$_project_cfg_path_identity" || "$_project_cfg_path_identity" != "$_project_cfg_fd_identity" || \
        "$_project_cfg_owner_links" != "${UID}:1" || \
        "$_project_cfg_canonical" != "$PROJECT_CONFIG_FILE" ]]; then
    exec 8<&-
    error "refusing unsafe project config (must be an owned, single-link regular file in the project root): ${PROJECT_CONFIG_FILE}"
    exit 1
  fi
  parse_config "${PROJECT_CONFIG_FILE}" "PROJECT" 8
  exec 8<&-
fi

# Apply config scalars where CLI didn't override. Project configuration is
# untrusted and may only make the inherited/default posture more restrictive.
if [[ "$CLI_NET" -eq 0 ]]; then
  if [[ -n "$CONFIG_NET" ]]; then
    NET_MODE="$CONFIG_NET"
  elif [[ "$PROJECT_NET" == "off" ]]; then
    NET_MODE="off"
  fi
fi
if [[ "$CLI_FS_MODE" -eq 0 ]]; then
  if [[ -n "$CONFIG_FS_MODE" ]]; then
    FS_MODE="$CONFIG_FS_MODE"
  elif [[ "$PROJECT_FS_MODE" == "ro" ]]; then
    FS_MODE="ro"
  fi
fi
if [[ "$CLI_STRICT" -eq 0 ]]; then
  if [[ -n "$CONFIG_STRICT" ]]; then
    STRICT="$CONFIG_STRICT"
  elif [[ "$PROJECT_STRICT" == "1" ]]; then
    STRICT=1
  fi
fi
if [[ "$CLI_SCRUB_ENV" -eq 0 ]]; then
  if [[ -n "$CONFIG_SCRUB_ENV" ]]; then
    SCRUB_ENV="$CONFIG_SCRUB_ENV"
  elif [[ "$PROJECT_SCRUB_ENV" == "1" ]]; then
    SCRUB_ENV=1
  fi
fi
if [[ -n "$CONFIG_GROK_DEFENSE" ]]; then
  GROK_DEFENSE="$CONFIG_GROK_DEFENSE"
elif [[ "$PROJECT_GROK_DEFENSE" == "1" ]]; then
  GROK_DEFENSE=1
fi

# Grok's July 2026 collector uploaded complete Git bundles, including history,
# independently of which files the model read. This mode keeps inference usable
# but makes the proved bulk-history channel unavailable at the OS boundary.
if [[ "$GROK_DEFENSE" -eq 1 && "$DETECTED_HARNESS" == "grok" ]]; then
  _account_home_real="$(_realpath "$ACCOUNT_HOME")"
  _effective_home_real="$(_realpath "$HOME")"
  if [[ "$PROJECT_DIR" == "/" || "$PROJECT_DIR" == "$_account_home_real" || "$PROJECT_DIR" == "$_effective_home_real" ]]; then
    error "grok_defense refuses a project rooted at ${PROJECT_DIR}"
    error "choose a dedicated repository directory; the project itself is readable by Grok"
    exit 1
  fi
  STRICT=1
  SCRUB_ENV=1
  info "grok defense: strict mode, environment scrubbing, Git-history and dotenv blocks enabled"
fi

# Resolve CLI/config blocked+allowed paths relative to project dir.
# This keeps --block/--allow semantics stable regardless of caller PWD.
RESOLVED_CLI_ALLOWED=()
for dir in ${CLI_ALLOWED[@]+"${CLI_ALLOWED[@]}"}; do
  RESOLVED_CLI_ALLOWED+=("$(resolve_access_path "$dir" "$PROJECT_DIR")")
done
RESOLVED_CONFIG_ALLOWED=()
for dir in ${CONFIG_ALLOWED[@]+"${CONFIG_ALLOWED[@]}"}; do
  RESOLVED_CONFIG_ALLOWED+=("$(resolve_access_path "$dir" "$PROJECT_DIR")")
done
RESOLVED_CLI_BLOCKED=()
for dir in ${CLI_BLOCKED[@]+"${CLI_BLOCKED[@]}"}; do
  RESOLVED_CLI_BLOCKED+=("$(resolve_access_path "$dir" "$PROJECT_DIR")")
done
RESOLVED_CONFIG_BLOCKED=()
for dir in ${CONFIG_BLOCKED[@]+"${CONFIG_BLOCKED[@]}"}; do
  RESOLVED_CONFIG_BLOCKED+=("$(resolve_access_path "$dir" "$PROJECT_DIR")")
done
GROK_MANDATORY_BLOCKED=()
if [[ "$GROK_DEFENSE" -eq 1 && "$DETECTED_HARNESS" == "grok" ]]; then
  GROK_MANDATORY_BLOCKED=(
    "$PROJECT_DIR/.git"
    "$PROJECT_DIR/.grok"
    "$PROJECT_DIR/.env"
    "$PROJECT_DIR/.envrc"
    "$PROJECT_DIR/.env.local"
    "$PROJECT_DIR/.env.development"
    "$PROJECT_DIR/.env.development.local"
    "$PROJECT_DIR/.env.production"
    "$PROJECT_DIR/.env.production.local"
    "$PROJECT_DIR/.env.staging"
    "$PROJECT_DIR/.env.staging.local"
    "$PROJECT_DIR/.env.test"
    "$PROJECT_DIR/.env.test.local"
  )
fi
RESOLVED_PROJECT_ALLOWED=()
for dir in ${PROJECT_ALLOWED[@]+"${PROJECT_ALLOWED[@]}"}; do
  RESOLVED_PROJECT_ALLOWED+=("$(resolve_access_path "$dir" "$PROJECT_DIR")")
done
RESOLVED_PROJECT_BLOCKED=()
for dir in ${PROJECT_BLOCKED[@]+"${PROJECT_BLOCKED[@]}"}; do
  RESOLVED_PROJECT_BLOCKED+=("$(resolve_access_path "$dir" "$PROJECT_DIR")")
done

# Project allow rules are never authoritative. An allow already covered by a
# CLI/user allow is harmless and redundant; every other project allow is ignored.
_report_ignored_project_allows() {
  [[ ${#RESOLVED_PROJECT_ALLOWED[@]} -eq 0 ]] && return
  local pdir
  for pdir in "${RESOLVED_PROJECT_ALLOWED[@]}"; do
    if is_allowed_in_list "$pdir" \
         "${RESOLVED_CLI_ALLOWED[@]+"${RESOLVED_CLI_ALLOWED[@]}"}" \
         "${RESOLVED_CONFIG_ALLOWED[@]+"${RESOLVED_CONFIG_ALLOWED[@]}"}"; then
      continue
    fi
    warning "ignoring project config (.scode.yaml) allowed path (project config is restrictive-only): ${pdir}"
  done
}
_report_ignored_project_allows

# Warn when project config sets permissive scalar values that weaken
# user config or defaults (e.g. net: on, strict: false, scrub_env: false).
_check_project_config_weakens() {
  [[ ! -f "${PROJECT_CONFIG_FILE}" ]] && return
  # Permissive project values are ignored unless a user config already chose them.
  if [[ "$PROJECT_NET" == "on" && "${CONFIG_NET:-}" != "on" ]]; then
    warning "ignoring permissive project config value: net: on"
  fi
  if [[ "$PROJECT_FS_MODE" == "rw" && "${CONFIG_FS_MODE:-}" != "rw" ]]; then
    warning "ignoring permissive project config value: fs_mode: rw"
  fi
  if [[ "$PROJECT_STRICT" == "0" && "${CONFIG_STRICT:-}" != "0" ]]; then
    warning "ignoring permissive project config value: strict: false"
  fi
  if [[ "$PROJECT_SCRUB_ENV" == "0" && "${CONFIG_SCRUB_ENV:-}" != "0" ]]; then
    warning "ignoring permissive project config value: scrub_env: false"
  fi
  if [[ "$PROJECT_GROK_DEFENSE" == "0" && "${CONFIG_GROK_DEFENSE:-}" != "0" ]]; then
    warning "ignoring permissive project config value: grok_defense: false"
  fi
}
_check_project_config_weakens

# Build authoritative allowed list (CLI + user config only).
ALL_ALLOWED=()
ALL_ALLOWED_SOURCES=()
for dir in ${RESOLVED_CLI_ALLOWED[@]+"${RESOLVED_CLI_ALLOWED[@]}"}; do
  ALL_ALLOWED+=("$dir")
  ALL_ALLOWED_SOURCES+=("cli")
done
for dir in ${RESOLVED_CONFIG_ALLOWED[@]+"${RESOLVED_CONFIG_ALLOWED[@]}"}; do
  ALL_ALLOWED+=("$dir")
  ALL_ALLOWED_SOURCES+=("config")
done

# In strict mode, missing --allow paths are easy to overlook. Warn clearly.
if [[ "${STRICT}" -eq 1 && ${ALL_ALLOWED[0]+_} ]]; then
  for dir in "${ALL_ALLOWED[@]}"; do
    [[ -z "${dir}" ]] && continue
    if [[ ! -e "${dir}" ]]; then
      warning "strict mode: allowed path does not exist (not creating it): ${dir}"
    fi
  done
fi

# Harness-aware strict profiles: auto-detect the harness and expose its default
# config/state paths read-only so --strict remains usable without letting a
# compromised tool alter credentials. The untrusted preset disables even these
# convenience openings; callers must opt in path by path.
HARNESS_STRICT_RO=()
if [[ "${STRICT}" -eq 1 && "$CLI_TRUST" != "untrusted" ]]; then
  _detected_harness="${DETECTED_HARNESS:-}"
  if [[ -n "${_detected_harness}" ]]; then
    _auto_allowed=()
    if get_harness_config_paths "$_detected_harness"; then
      for _harness_config_path in "${HARNESS_CONFIG_PATHS[@]}"; do
        _harness_config_path="$(_realpath "$_harness_config_path")"
        if ! is_same_or_descendant_path "$_harness_config_path" "$HOME"; then
          warning "strict+${_detected_harness}: ignoring config path that resolves outside HOME: ${_harness_config_path}"
          continue
        fi
        # Skip if explicitly blocked by CLI, user config, or project config
        if ! is_allowed_in_list "$_harness_config_path" \
             "${RESOLVED_CLI_BLOCKED[@]+"${RESOLVED_CLI_BLOCKED[@]}"}" \
             "${RESOLVED_CONFIG_BLOCKED[@]+"${RESOLVED_CONFIG_BLOCKED[@]}"}" \
             "${RESOLVED_PROJECT_BLOCKED[@]+"${RESOLVED_PROJECT_BLOCKED[@]}"}"; then
          HARNESS_STRICT_RO+=("$_harness_config_path")
          _auto_allowed+=("$_harness_config_path")
        fi
      done
    fi
    # Reserved for narrowly scoped platform-specific auto-allows. The current
    # macOS policy deliberately leaves these lists empty.
    if [[ "$PLATFORM" == "darwin" ]]; then
      for dir in ${DARWIN_LIBRARY_ALLOWED_RW[@]+"${DARWIN_LIBRARY_ALLOWED_RW[@]}"}; do
        if ! is_allowed_in_list "$dir" \
             "${RESOLVED_CLI_BLOCKED[@]+"${RESOLVED_CLI_BLOCKED[@]}"}" \
             "${RESOLVED_CONFIG_BLOCKED[@]+"${RESOLVED_CONFIG_BLOCKED[@]}"}" \
             "${RESOLVED_PROJECT_BLOCKED[@]+"${RESOLVED_PROJECT_BLOCKED[@]}"}"; then
          ALL_ALLOWED+=("$dir")
          ALL_ALLOWED_SOURCES+=("auto")
          _auto_allowed+=("$dir")
        fi
      done
      for dir in ${DARWIN_LIBRARY_ALLOWED_RO[@]+"${DARWIN_LIBRARY_ALLOWED_RO[@]}"}; do
        if ! is_allowed_in_list "$dir" \
             "${RESOLVED_CLI_BLOCKED[@]+"${RESOLVED_CLI_BLOCKED[@]}"}" \
             "${RESOLVED_CONFIG_BLOCKED[@]+"${RESOLVED_CONFIG_BLOCKED[@]}"}" \
             "${RESOLVED_PROJECT_BLOCKED[@]+"${RESOLVED_PROJECT_BLOCKED[@]}"}"; then
          HARNESS_STRICT_RO+=("$dir")
          _auto_allowed+=("$dir")
        fi
      done
    fi
    if [[ ${#_auto_allowed[@]} -gt 0 ]]; then
      info "strict+${_detected_harness}: auto-allowing ${_auto_allowed[*]}"
    fi
  fi
fi

# CLI --block must win over broader config/automatic allows, except explicit
# CLI --allow. Check both hierarchy directions because an allowed parent would
# otherwise reopen a blocked child.
if [[ ${ALL_ALLOWED[0]+_} && ${RESOLVED_CLI_BLOCKED[0]+_} ]]; then
  _filtered_allowed=()
  _filtered_allowed_sources=()
  for _allowed_i in "${!ALL_ALLOWED[@]}"; do
    dir="${ALL_ALLOWED[$_allowed_i]}"
    [[ -z "$dir" ]] && continue
    if is_cli_allowed "$dir"; then
      _filtered_allowed+=("$dir")
      _filtered_allowed_sources+=("${ALL_ALLOWED_SOURCES[$_allowed_i]}")
      continue
    fi
    _overlaps_cli_block=0
    for _cli_block in "${RESOLVED_CLI_BLOCKED[@]}"; do
      if paths_overlap_hierarchy "$dir" "$_cli_block"; then
        _overlaps_cli_block=1
        break
      fi
    done
    [[ "$_overlaps_cli_block" -eq 1 ]] && continue
    _filtered_allowed+=("$dir")
    _filtered_allowed_sources+=("${ALL_ALLOWED_SOURCES[$_allowed_i]}")
  done
  ALL_ALLOWED=()
  ALL_ALLOWED_SOURCES=()
  if [[ ${_filtered_allowed[0]+_} ]]; then
    ALL_ALLOWED=("${_filtered_allowed[@]}")
    ALL_ALLOWED_SOURCES=("${_filtered_allowed_sources[@]}")
  fi
fi

# A caller must opt in to agent forwarding twice: expose the socket path with
# --allow and set SSH_AUTH_SOCK explicitly on the sandboxed command. Merely
# inheriting an outer shell's agent must never grant signing authority.
if [[ -n "$SCODE_CALLER_SSH_AUTH_SOCK" && "$SCODE_CALLER_SSH_AUTH_SOCK" == /* ]] && \
   ! _contains_control_character "$SCODE_CALLER_SSH_AUTH_SOCK" && \
   [[ -S "$SCODE_CALLER_SSH_AUTH_SOCK" ]]; then
  _ssh_socket_real="$(_realpath "$SCODE_CALLER_SSH_AUTH_SOCK")"
  DEFAULT_BLOCKED+=("$_ssh_socket_real")
fi

# Grok defense is an invariant, not an ordinary config preference. Refuse any
# allow that would reopen a mandatory repository-history or dotenv block.
if [[ ${GROK_MANDATORY_BLOCKED[0]+_} && ${ALL_ALLOWED[0]+_} ]]; then
  for _defense_block in "${GROK_MANDATORY_BLOCKED[@]}"; do
    for _allowed_dir in "${ALL_ALLOWED[@]}"; do
      if paths_overlap_hierarchy "$_defense_block" "$_allowed_dir"; then
        error "grok_defense conflicts with allowed path: ${_allowed_dir}"
        error "remove the overlapping allow or disable grok_defense explicitly"
        exit 1
      fi
    done
  done
fi

# Build blocked list: defaults + platform extras + config + CLI, minus allowed
# ALL_BLOCKED_SOURCES tracks the origin of each entry (parallel array).
ALL_BLOCKED=()
ALL_BLOCKED_SOURCES=()

# Start with defaults
for dir in "${DEFAULT_BLOCKED[@]}"; do
  if ! is_allowed "$dir"; then
    ALL_BLOCKED+=("$dir")
    ALL_BLOCKED_SOURCES+=("default")
  fi
done

# Platform extras
if [[ "$PLATFORM" == "darwin" ]]; then
  for dir in "${DARWIN_EXTRA_BLOCKED[@]}"; do
    if ! is_allowed "$dir"; then
      ALL_BLOCKED+=("$dir")
      ALL_BLOCKED_SOURCES+=("platform")
    fi
  done
elif [[ "$PLATFORM" == "linux" ]]; then
  for dir in "${LINUX_EXTRA_BLOCKED[@]}"; do
    if ! is_allowed "$dir"; then
      ALL_BLOCKED+=("$dir")
      ALL_BLOCKED_SOURCES+=("platform")
    fi
  done
fi

# Config blocked
for dir in ${RESOLVED_CONFIG_BLOCKED[@]+"${RESOLVED_CONFIG_BLOCKED[@]}"}; do
  if ! is_allowed "$dir"; then
    ALL_BLOCKED+=("$dir")
    ALL_BLOCKED_SOURCES+=("config")
  fi
done

# Project blocked
for dir in ${RESOLVED_PROJECT_BLOCKED[@]+"${RESOLVED_PROJECT_BLOCKED[@]}"}; do
  if ! is_allowed "$dir"; then
    ALL_BLOCKED+=("$dir")
    ALL_BLOCKED_SOURCES+=("project")
  fi
done

# CLI blocked
# CLI --block has higher precedence than config/default allows.
# CLI --allow still wins over CLI --block.
for dir in ${RESOLVED_CLI_BLOCKED[@]+"${RESOLVED_CLI_BLOCKED[@]}"}; do
  if ! is_cli_allowed "$dir"; then
    ALL_BLOCKED+=("$dir")
    ALL_BLOCKED_SOURCES+=("cli")
  fi
done

# Mandatory defense paths are appended after normal allow filtering.
for dir in ${GROK_MANDATORY_BLOCKED[@]+"${GROK_MANDATORY_BLOCKED[@]}"}; do
  ALL_BLOCKED+=("$dir")
  ALL_BLOCKED_SOURCES+=("defense")
done

# The project bind is an implicit allow needed to execute the requested task.
# An authoritative block covering it cannot be implemented without silently
# weakening either the block or the cwd contract, so fail closed.
for _blocked_i in "${!ALL_BLOCKED[@]}"; do
  case "${ALL_BLOCKED_SOURCES[$_blocked_i]}" in
    config|project|cli|defense) ;;
    *) continue ;;
  esac
  if is_same_or_descendant_path "$PROJECT_DIR" "${ALL_BLOCKED[$_blocked_i]}"; then
    error "custom block covers the project directory: ${ALL_BLOCKED[$_blocked_i]}"
    error "remove the block or add an authoritative allow for the project"
    exit 1
  fi
done

# bubblewrap needs the blocked path's parent to exist as a mount-point parent.
# A deep missing path was previously skipped, even when it came from an
# explicit user or project policy. Fail closed for authoritative custom rules;
# omit unavailable built-ins with one honest warning instead of logging a deny
# that the kernel never enforces.
if [[ "$PLATFORM" == "linux" ]]; then
  _enforceable_blocked=()
  _enforceable_blocked_sources=()
  _unavailable_default_blocks=0
  for _blocked_i in "${!ALL_BLOCKED[@]}"; do
    dir="${ALL_BLOCKED[$_blocked_i]}"
    _block_source="${ALL_BLOCKED_SOURCES[$_blocked_i]}"
    _needs_mount=1
    if [[ "$STRICT" -eq 1 && "$_block_source" != "config" && \
          "$_block_source" != "project" && "$_block_source" != "cli" ]]; then
      _needs_mount=0
      if is_same_or_descendant_path "$dir" "$PROJECT_DIR"; then
        _needs_mount=1
      elif [[ ${ALL_ALLOWED[0]+_} ]]; then
        for _allowed_dir in "${ALL_ALLOWED[@]}"; do
          if is_same_or_descendant_path "$dir" "$_allowed_dir"; then
            _needs_mount=1
            break
          fi
        done
      fi
    fi
    if [[ "$_needs_mount" -eq 1 && ! -e "$dir" && ! -d "$(dirname "$dir")" ]]; then
      case "$_block_source" in
        config|project|cli)
          error "cannot enforce Linux block because its parent does not exist: ${dir}"
          error "block an existing ancestor or create the parent directory first"
          exit 1
          ;;
        *)
          _unavailable_default_blocks=$((_unavailable_default_blocks + 1))
          continue
          ;;
      esac
    fi
    _enforceable_blocked+=("$dir")
    _enforceable_blocked_sources+=("$_block_source")
  done
  ALL_BLOCKED=()
  ALL_BLOCKED_SOURCES=()
  if [[ ${_enforceable_blocked[0]+_} ]]; then
    ALL_BLOCKED=("${_enforceable_blocked[@]}")
    ALL_BLOCKED_SOURCES=("${_enforceable_blocked_sources[@]}")
  fi
  if [[ "$_unavailable_default_blocks" -gt 0 ]]; then
    warning "${_unavailable_default_blocks} built-in Linux block(s) are currently inapplicable because their parents do not exist"
  fi
fi

# Linux default mode: --allow under a blocked parent requires an existing path
# for bwrap re-bind. Warn when an override cannot be applied yet.
if [[ "$PLATFORM" == "linux" && "${STRICT}" -eq 0 && ${ALL_ALLOWED[0]+_} && ${ALL_BLOCKED[0]+_} ]]; then
  for dir in "${ALL_ALLOWED[@]}"; do
    [[ -z "$dir" || -e "$dir" ]] && continue
    _allow_check="$dir"
    if [[ -d "$(dirname "$dir")" ]]; then
      _allow_check="$(_realpath "$(dirname "$dir")")/$(basename "$dir")"
    fi
    for bdir in "${ALL_BLOCKED[@]}"; do
      if is_descendant_path "$dir" "$bdir" || is_descendant_path "$_allow_check" "$bdir"; then
        warning "linux default mode: allowed path does not exist (cannot re-bind until it exists): ${dir}"
        break
      fi
    done
  done
fi


# -------- Scrub env if requested --------

if [[ "${SCRUB_ENV}" -eq 1 ]]; then
  scrub_env
fi
if [[ "$PLATFORM" == "linux" && "$NET_MODE" != "on" ]]; then
  unset XDG_RUNTIME_DIR
fi

# Grok defense is exported for the entire process tree so a nested Grok launch
# cannot inherit permissive collection defaults. The telemetry and workspace
# collection variables are defense-in-depth for Grok's currently undocumented
# switches; .git/dotenv denial above is the kernel-enforced boundary.
if [[ "$GROK_DEFENSE" -eq 1 ]]; then
  export GROK_TELEMETRY_ENABLED=false
  export GROK_TELEMETRY_TRACE_UPLOAD=false
  export GROK_TELEMETRY_MIXPANEL_ENABLED=false
  export GROK_WORKSPACE_DATA_COLLECTION_DISABLED=true
  export GROK_WORKSPACE_UPLOAD_QUEUE_ENABLED=false
  export GROK_RELAY_SYNC_ENABLED=false
  export GROK_RESPECT_GITIGNORE=1
  export GROK_DISABLE_AUTOUPDATER=1
  export GROK_WEB_FETCH=0
  export GROK_MEMORY=0
  export GROK_SUBAGENTS=0
  export GROK_TOOL_SEARCH=0

  export GROK_CURSOR_SKILLS_ENABLED=false
  export GROK_CURSOR_RULES_ENABLED=false
  export GROK_CURSOR_AGENTS_ENABLED=false
  export GROK_CURSOR_MCPS_ENABLED=false
  export GROK_CURSOR_HOOKS_ENABLED=false
  export GROK_CURSOR_SESSIONS_ENABLED=false
  export GROK_CLAUDE_SKILLS_ENABLED=false
  export GROK_CLAUDE_RULES_ENABLED=false
  export GROK_CLAUDE_AGENTS_ENABLED=false
  export GROK_CLAUDE_MCPS_ENABLED=false
  export GROK_CLAUDE_HOOKS_ENABLED=false
  export GROK_CLAUDE_SESSIONS_ENABLED=false
  export GROK_CODEX_SKILLS_ENABLED=false
  export GROK_CODEX_RULES_ENABLED=false
  export GROK_CODEX_AGENTS_ENABLED=false
  export GROK_CODEX_MCPS_ENABLED=false
  export GROK_CODEX_HOOKS_ENABLED=false
  export GROK_CODEX_SESSIONS_ENABLED=false
fi

# -------- Browser double-sandbox prevention --------
# Since scode IS a sandbox, inner browser sandboxes will fail.
# Export env vars that tell common tools to skip their own sandbox.

export SCODE_SANDBOXED=1
export ELECTRON_DISABLE_SANDBOX=1
export PLAYWRIGHT_MCP_NO_SANDBOX=1
if [[ " ${CHROMIUM_FLAGS:-} " != *" --no-sandbox "* ]]; then
  export CHROMIUM_FLAGS="${CHROMIUM_FLAGS:+${CHROMIUM_FLAGS} }--no-sandbox"
fi

# Node.js preload: patches child_process.spawn/spawnSync/exec/execSync/
# execFile/execFileSync to inject --no-sandbox for Chromium launches.
# Resolve lib dir: check source layout (./lib/) then installed layout (../lib/scode/).
SCODE_DIR="$(cd "$(dirname "$(_realpath "$0")")" && pwd)"
SCODE_LIB_DIR=""
if [[ -f "${SCODE_DIR}/lib/no-sandbox.js" ]]; then
  SCODE_LIB_DIR="${SCODE_DIR}/lib"
elif [[ -f "${SCODE_DIR}/../lib/scode/no-sandbox.js" ]]; then
  SCODE_LIB_DIR="$(cd "${SCODE_DIR}/../lib/scode" && pwd)"
fi
if [[ -n "${SCODE_LIB_DIR}" && -f "${SCODE_LIB_DIR}/no-sandbox.js" ]]; then
  SCODE_NO_SANDBOX_JS="${SCODE_LIB_DIR}/no-sandbox.js"
  validate_path "$SCODE_NO_SANDBOX_JS"
  _preload_custom_block=0
  for _blocked_i in "${!ALL_BLOCKED[@]}"; do
    case "${ALL_BLOCKED_SOURCES[$_blocked_i]}" in
      config|project|cli|defense)
        if is_same_or_descendant_path "$SCODE_NO_SANDBOX_JS" "${ALL_BLOCKED[$_blocked_i]}"; then
          _preload_custom_block=1
          break
        fi
        ;;
    esac
  done
  if [[ "$_preload_custom_block" -eq 1 ]]; then
    warning "browser preload disabled because custom policy blocks it: ${SCODE_NO_SANDBOX_JS}"
    SCODE_NO_SANDBOX_JS=""
  fi
  if [[ -n "$SCODE_NO_SANDBOX_JS" ]]; then
  # NODE_OPTIONS splits on whitespace — spaces in the path break --require.
  # Work around by symlinking to a space-free path when needed.
  if [[ "${SCODE_NO_SANDBOX_JS}" == *" "* ]]; then
    # Use /tmp explicitly (not TMPDIR) so the path itself stays space-free.
    # The private unpredictable directory prevents link-name races.
    if SCODE_NO_SANDBOX_TMPDIR="$(mktemp -d "/tmp/scode-no-sandbox.${UID}.XXXXXX")"; then
      chmod 700 "${SCODE_NO_SANDBOX_TMPDIR}"
      SCODE_NO_SANDBOX_LINK="${SCODE_NO_SANDBOX_TMPDIR}/preload.js"
    fi
    if [[ -n "${SCODE_NO_SANDBOX_LINK}" ]] && ln -s "${SCODE_NO_SANDBOX_JS}" "${SCODE_NO_SANDBOX_LINK}"; then
      SCODE_NO_SANDBOX_JS="${SCODE_NO_SANDBOX_LINK}"
    else
      warning "failed to create a space-free no-sandbox preload path"
      # shellcheck disable=SC2015  # best-effort cleanup; `|| true` is the intent
      [[ -n "${SCODE_NO_SANDBOX_TMPDIR}" ]] && rmdir "${SCODE_NO_SANDBOX_TMPDIR}" 2>/dev/null || true
      SCODE_NO_SANDBOX_LINK=""
      SCODE_NO_SANDBOX_TMPDIR=""
    fi
  fi
  export SCODE_NO_SANDBOX_JS
  export NODE_OPTIONS="--require=${SCODE_NO_SANDBOX_JS}${NODE_OPTIONS:+ ${NODE_OPTIONS}}"
  fi
fi

# Print sandbox-related env vars (for --dry-run)
print_dry_run_env() {
  echo ""
  echo "# Sandbox environment:"
  echo "#   SCODE_SANDBOXED=1"
  echo "#   ELECTRON_DISABLE_SANDBOX=1"
  echo "#   PLAYWRIGHT_MCP_NO_SANDBOX=1"
  echo "#   CHROMIUM_FLAGS=${CHROMIUM_FLAGS}"
  if [[ -n "${SCODE_NO_SANDBOX_JS:-}" ]]; then
    echo "#   NODE_OPTIONS=...--require=${SCODE_NO_SANDBOX_JS}"
  fi
  if [[ "${SCRUB_ENV}" -eq 1 ]]; then
    echo "#   --scrub-env active"
  fi
  if [[ "$GROK_DEFENSE" -eq 1 ]]; then
    echo "#   grok_defense active"
    echo "#   GROK_TELEMETRY_ENABLED=false"
    echo "#   GROK_TELEMETRY_TRACE_UPLOAD=false"
    echo "#   GROK_WORKSPACE_DATA_COLLECTION_DISABLED=true"
    echo "#   GROK_WORKSPACE_UPLOAD_QUEUE_ENABLED=false"
    echo "#   GROK_RELAY_SYNC_ENABLED=false"
    echo "#   GROK_RESPECT_GITIGNORE=1"
    echo "#   GROK_DISABLE_AUTOUPDATER=1"
    echo "#   Grok compatibility scanners, memory, subagents, tool search, and web fetch disabled"
  fi
}

# -------- Generate and run --------

_scode_rc=0

# -------- Command binary auto-allow --------
# Only built-in/platform blocks may be bypassed for the command executable.
# User, project, and CLI block policy remains authoritative.
_command_has_custom_block=0
if [[ -n "${COMMAND_BINARY_PATH}" ]]; then
  for _blocked_i in "${!ALL_BLOCKED[@]}"; do
    case "${ALL_BLOCKED_SOURCES[$_blocked_i]}" in
      config|project|cli|defense)
        if is_same_or_descendant_path "${COMMAND_BINARY_PATH}" "${ALL_BLOCKED[$_blocked_i]}"; then
          _command_has_custom_block=1
          break
        fi
        ;;
    esac
  done
fi

if [[ "$PLATFORM" == "darwin" ]]; then
  # macOS: sandbox-exec
  if [[ "${STRICT}" -eq 1 ]]; then
    PROFILE=$(generate_strict_profile "${PROJECT_DIR}" "${FS_MODE}" "${NET_MODE}" ${ALL_BLOCKED[@]+"${ALL_BLOCKED[@]}"})
  else
    PROFILE=$(generate_profile "${PROJECT_DIR}" "${FS_MODE}" "${NET_MODE}" ${ALL_BLOCKED[@]+"${ALL_BLOCKED[@]}"})
  fi

  # Append allow for command binary if it falls under a blocked path.
  # In sandbox-exec, later rules override earlier ones.
  if [[ -n "${COMMAND_BINARY_PATH}" && "$_command_has_custom_block" -eq 0 ]]; then
    if [[ "$STRICT" -eq 1 ]]; then
      _esc_bin="$(sbpl_escape "${COMMAND_BINARY_PATH}")"
      PROFILE="${PROFILE}

; Strict-mode command binary (exact auto-allow)
(allow file-read* process-exec
  (literal \"${_esc_bin}\")
)"
    else
    for _blocked_i in "${!ALL_BLOCKED[@]}"; do
      case "${ALL_BLOCKED_SOURCES[$_blocked_i]}" in default|platform) ;; *) continue ;; esac
      _bdir="${ALL_BLOCKED[$_blocked_i]}"
      if is_same_or_descendant_path "${COMMAND_BINARY_PATH}" "$_bdir"; then
        _esc_bin="$(sbpl_escape "${COMMAND_BINARY_PATH}")"
        PROFILE="${PROFILE}

; Command binary (auto-allow under blocked parent)
(allow file-read* process-exec
  (literal \"${_esc_bin}\")
)"
        break
      fi
    done
    fi
  fi

  if [[ "${DRY_RUN}" -eq 1 ]]; then
    echo "${PROFILE}"
    echo ""
    printf '# Command:'
    printf ' %q' "${COMMAND[@]}"
    printf '\n'
    echo "# Platform: macOS (sandbox-exec)"
    [[ "${STRICT}" -eq 1 ]] && echo "# Mode: strict (deny-default)"
    print_dry_run_env
    exit 0
  fi

  # Set working directory (sandbox-exec has no --chdir equivalent)
  cd "${PROJECT_DIR}" || { error "cannot cd to project directory: ${PROJECT_DIR}"; exit 1; }

  # Resolved policy is known by now, so the sync can tell whether the sandbox
  # this run builds could actually reach the credential.
  sync_claude_credential

  # Run sandboxed. The profile travels as a string (-p) rather than a temp
  # file, so teardown never races a profile cleanup; the main shell stays
  # alive to run the EXIT trap, which the scratch teardown and the
  # accounting record depend on.
  if [[ -n "${LOG_FILE}" ]]; then
    ensure_log_parent_dir "${LOG_FILE}"
    # Build extra comment lines for macOS profile dump
    _profile_comments=()
    _profile_comments+=("# profile:")
    while IFS= read -r profile_line; do
      _profile_comments+=("#   ${profile_line}")
    done <<< "${PROFILE}"
    _profile_comments+=("#")
    _profile_comments+=("# Sandbox errors below (grep for 'Operation not permitted' / 'Permission denied'):")
    write_log_header_json "${LOG_FILE}" "${_profile_comments[@]}"
    info "logging to ${LOG_FILE}"
    if run_with_stderr_log "${LOG_FILE}" run_sandbox_engine_with_closed_fds "$SANDBOX_ENGINE" -p "${PROFILE}" -- "${COMMAND[@]}"; then
      _scode_rc=0
    else
      _scode_rc=$?
    fi
  else
    if run_engine_forwarding "$SANDBOX_ENGINE" -p "${PROFILE}" -- "${COMMAND[@]}"; then
      _scode_rc=0
    else
      _scode_rc=$?
    fi
  fi

elif [[ "$PLATFORM" == "linux" ]]; then
  # Linux: bubblewrap
  if [[ "${STRICT}" -eq 1 ]]; then
    build_strict_bwrap_args "${PROJECT_DIR}" "${FS_MODE}" "${NET_MODE}" ${ALL_BLOCKED[@]+"${ALL_BLOCKED[@]}"}
  else
    build_bwrap_args "${PROJECT_DIR}" "${FS_MODE}" "${NET_MODE}" ${ALL_BLOCKED[@]+"${ALL_BLOCKED[@]}"}
  fi

  # Linux parity with macOS: if the command binary itself is under a blocked
  # parent (defaults/config/project), re-bind that file so execution works.
  # Explicit CLI --block still wins and suppresses this auto-allow.
  if [[ -n "${COMMAND_BINARY_PATH}" && "$_command_has_custom_block" -eq 0 ]]; then
    if [[ "$STRICT" -eq 1 ]]; then
      BWRAP_ARGS+=(--ro-bind "${COMMAND_BINARY_PATH}" "${COMMAND_BINARY_PATH}")
    else
    for _blocked_i in "${!ALL_BLOCKED[@]}"; do
      case "${ALL_BLOCKED_SOURCES[$_blocked_i]}" in default|platform) ;; *) continue ;; esac
      _bdir="${ALL_BLOCKED[$_blocked_i]}"
      if is_same_or_descendant_path "${COMMAND_BINARY_PATH}" "$_bdir"; then
        BWRAP_ARGS+=(--ro-bind "${COMMAND_BINARY_PATH}" "${COMMAND_BINARY_PATH}")
        break
      fi
    done
    fi
  fi

  if [[ "${DRY_RUN}" -eq 1 ]]; then
    printf 'bwrap'
    printf ' %q' "${BWRAP_ARGS[@]}"
    printf ' --'
    printf ' %q' "${COMMAND[@]}"
    printf '\n'
    echo ""
    echo "# Platform: Linux (bubblewrap)"
    [[ "${STRICT}" -eq 1 ]] && echo "# Mode: strict"
    print_dry_run_env
    exit 0
  fi

  if [[ -n "${LOG_FILE}" ]]; then
    ensure_log_parent_dir "${LOG_FILE}"
    write_log_header_json "${LOG_FILE}" "# bwrap args: ${BWRAP_ARGS[*]}"
    info "logging to ${LOG_FILE}"
    if run_with_stderr_log "${LOG_FILE}" run_sandbox_engine_with_closed_fds "$SANDBOX_ENGINE" "${BWRAP_ARGS[@]}" -- "${COMMAND[@]}"; then
      _scode_rc=0
    else
      _scode_rc=$?
    fi
  else
    if run_engine_forwarding "$SANDBOX_ENGINE" "${BWRAP_ARGS[@]}" -- "${COMMAND[@]}"; then
      _scode_rc=0
    else
      _scode_rc=$?
    fi
  fi

fi

exit "${_scode_rc}"
