# Seatbelt uses last-match precedence. Reassert custom blocks after broad
# carve-outs/automatic allows, then restore only authoritative CLI/user child
# allows. Finally cap the project at read-only when requested.
emit_macos_final_guards() {
  local project_dir="$1"
  local fs_mode="$2"
  local emitted=0 i dir source bdir under_custom esc_dir esc_project

  for i in "${!ALL_BLOCKED[@]}"; do
    source="${ALL_BLOCKED_SOURCES[$i]}"
    case "$source" in config|project|cli|defense) ;; *) continue ;; esac
    if [[ "$emitted" -eq 0 ]]; then
      echo ""
      echo "; Final custom-policy blocks"
      emitted=1
    fi
    esc_dir="$(sbpl_escape "${ALL_BLOCKED[$i]}")"
    cat <<EOF
(deny file-read* file-write* process-exec
  (subpath "${esc_dir}")
)
EOF
  done

  if [[ "$emitted" -eq 1 && ${ALL_ALLOWED[0]+_} ]]; then
    for i in "${!ALL_ALLOWED[@]}"; do
      source="${ALL_ALLOWED_SOURCES[$i]}"
      case "$source" in cli|config) ;; *) continue ;; esac
      dir="${ALL_ALLOWED[$i]}"
      under_custom=0
      for bdir in "${ALL_BLOCKED[@]}"; do
        if is_descendant_path "$dir" "$bdir"; then
          under_custom=1
          break
        fi
      done
      [[ "$under_custom" -eq 0 ]] && continue
      esc_dir="$(sbpl_escape "$dir")"
      cat <<EOF
(allow file-read* file-write* process-exec
  (subpath "${esc_dir}")
)
EOF
    done
  fi

  if [[ "$fs_mode" == "ro" ]]; then
    esc_project="$(sbpl_escape "$project_dir")"
    cat <<EOF

