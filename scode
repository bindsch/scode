# Colors for output
readonly RED='\033[0;31m'
readonly YELLOW='\033[1;33m'
readonly GREEN='\033[0;32m'
readonly NC='\033[0m'

# Render untrusted text without allowing terminal control sequences to execute.
# Newlines and other C0/DEL bytes are shown as escapes; ordinary UTF-8 is kept.
terminal_escape() {
  local s="$1"
  local result="" i ch ord escaped
  for (( i=0; i<${#s}; i++ )); do
    ch="${s:i:1}"
    printf -v ord '%d' "'$ch"
    case "$ord" in
      8)  result+='\b' ;;
      9)  result+='\t' ;;
      10) result+='\n' ;;
      12) result+='\f' ;;
      13) result+='\r' ;;
      [0-9]|[1-2][0-9]|3[0-1]|127)
        printf -v escaped '\\x%02x' "$ord"
        result+="$escaped"
        ;;
      *) result+="$ch" ;;
    esac
  done
  printf '%s' "$result"
}

# Collapse dot components in an absolute path without touching the filesystem.
# This is required for the realpath fallback: retaining an unresolved `..`
# would let policy comparisons disagree with the path the kernel resolves.
_collapse_absolute_path() {
  local input="$1"
  local -a parts=() normalized=()
  local part result=""
  IFS='/' read -r -a parts <<< "$input"
  for part in "${parts[@]}"; do
    case "$part" in
      ""|.) continue ;;
      ..)
        if [[ ${normalized[0]+_} ]]; then
          unset 'normalized[${#normalized[@]}-1]'
          normalized=("${normalized[@]+"${normalized[@]}"}")
        fi
        ;;
      *) normalized+=("$part") ;;
    esac
  done
  for part in "${normalized[@]+"${normalized[@]}"}"; do
    result="${result}/${part}"
  done
  printf '%s\n' "${result:-/}"
}

# Portable realpath: use the system binary when available, otherwise resolve
# final-component symlinks with readlink and parent components with cd+pwd.
# Handles files, directories, and non-existent paths.
# GNU coreutils `stat -f` prints *filesystem* status and exits 0, ignoring the
# format string. A `stat -f '%i' ... || stat -c '%i' ...` chain therefore never
# falls through on Linux: it silently returns filesystem data instead of the
# file's inode. Detect the flavor once and dispatch on named fields so callers
# cannot reintroduce that bug through mismatched format letters.
if stat -c '%i' / >/dev/null 2>&1; then
  readonly SCODE_STAT_FLAVOR="gnu"
else
  readonly SCODE_STAT_FLAVOR="bsd"
fi

# _stat_field <inode|size|owner|owner_links> <path>
# Prints the requested field, or nothing if it cannot be determined.
_stat_field() {
  local field="$1" target="$2" fmt=""

  if [[ "$SCODE_STAT_FLAVOR" == "gnu" ]]; then
    case "$field" in
      inode) fmt='%i' ;;
      size) fmt='%s' ;;
      owner) fmt='%u' ;;
      owner_links) fmt='%u:%h' ;;
      *) return 1 ;;
    esac
    stat -Lc "$fmt" "$target" 2>/dev/null || true
  else
    case "$field" in
      inode) fmt='%i' ;;
      size) fmt='%z' ;;
      owner) fmt='%u' ;;
      owner_links) fmt='%u:%l' ;;
      *) return 1 ;;
    esac
    stat -f "$fmt" "$target" 2>/dev/null || true
  fi
}

_realpath() {
  local input="$1"
  local resolved=""

  if command -v realpath >/dev/null 2>&1; then
    if resolved="$(realpath "$input" 2>/dev/null)"; then
      printf '%s\n' "$resolved"
      return 0
    fi
  fi

  local abs="$input"
  if [[ "$abs" != /* ]]; then
    abs="${PWD}/${abs}"
  fi

  # `cd -P "$(dirname ...)"` does not resolve a file's final symlink. Follow it
  # explicitly, including relative link targets, and cap traversal to reject
  # cycles consistently with realpath(1).
  local link_count=0 link_target=""
  while [[ -L "$abs" ]]; do
    link_count=$((link_count + 1))
    if [[ "$link_count" -gt 40 ]]; then
      error "too many symbolic links while resolving path: ${input}"
      return 1
    fi
    if ! link_target="$(/usr/bin/readlink "$abs")"; then
      error "failed to read symbolic link while resolving path: ${input}"
      return 1
    fi
    if [[ "$link_target" == /* ]]; then
      abs="$link_target"
    else
      abs="$(dirname "$abs")/${link_target}"
    fi
  done

  if [[ -d "$abs" ]]; then
    (cd "$abs" && pwd -P)
    return 0
  fi
  if [[ -e "$abs" ]]; then
    local dir base
    dir="$(cd "$(dirname "$abs")" && pwd -P)"
    base="$(basename "$abs")"
    printf '%s/%s\n' "$dir" "$base"
    return 0
  fi

  # Non-existent path: resolve the nearest existing ancestor, then append the
  # unresolved suffix so the result remains absolute.
  local anchor="$abs"
  local suffix=""
  while [[ ! -e "$anchor" && "$anchor" != "/" ]]; do
    local tail="${anchor##*/}"
    suffix="/${tail}${suffix}"
    anchor="${anchor%/*}"
    [[ -z "$anchor" ]] && anchor="/"
  done

  if [[ -d "$anchor" ]]; then
    local anchor_resolved
    anchor_resolved="$(cd "$anchor" && pwd -P)"
    if [[ "$anchor_resolved" == "/" ]]; then
      _collapse_absolute_path "/${suffix#/}"
    else
      _collapse_absolute_path "${anchor_resolved}${suffix}"
    fi
    return 0
  fi
  if [[ -e "$anchor" ]]; then
    local anchor_dir anchor_base
    anchor_dir="$(cd "$(dirname "$anchor")" && pwd -P)"
    anchor_base="$(basename "$anchor")"
    if [[ "$anchor_dir" == "/" ]]; then
      _collapse_absolute_path "/${anchor_base}${suffix}"
    else
      _collapse_absolute_path "${anchor_dir}/${anchor_base}${suffix}"
    fi
    return 0
  fi

  # Defensive final fallback ("/" should always exist).
  _collapse_absolute_path "$abs"
}

# Normalize paths for policy matching: trim trailing slashes except for root.
normalize_match_path() {
  local p="$1"
  if [[ -z "$p" ]]; then
    printf '\n'
    return 0
  fi
  while [[ "$p" == //* ]]; do
    p="/${p#//}"
  done
  while [[ "$p" != "/" && "$p" == */ ]]; do
    p="${p%/}"
  done
  [[ -z "$p" ]] && p="/"
  printf '%s\n' "$p"
}

# Returns success when $1 is the same path as, or a descendant of, $2.
is_same_or_descendant_path() {
  local child parent
  child="$(normalize_match_path "$1")"
  parent="$(normalize_match_path "$2")"
  [[ -z "$child" || -z "$parent" ]] && return 1
  if [[ "$parent" == "/" ]]; then
    [[ "$child" == /* ]]
    return
  fi
  [[ "$child" == "$parent" || "$child" == "$parent"/* ]]
}

# Returns success when $1 is a strict descendant of $2 (not equal).
is_descendant_path() {
  local child parent
  child="$(normalize_match_path "$1")"
  parent="$(normalize_match_path "$2")"
  [[ -z "$child" || -z "$parent" ]] && return 1
  if [[ "$parent" == "/" ]]; then
    [[ "$child" == /* && "$child" != "/" ]]
    return
  fi
  [[ "$child" == "$parent"/* ]]
}

# Returns success when two paths overlap in the same hierarchy direction
# (same path, ancestor, or descendant).
paths_overlap_hierarchy() {
  is_same_or_descendant_path "$1" "$2" || is_same_or_descendant_path "$2" "$1"
}

# -------- Platform detection --------

detect_platform() {
  # _SCODE_PLATFORM is a dry-run-only test hook. Letting an inherited variable
  # select the runtime engine would make platform enforcement environment-
  # dependent and would invite PATH/fake-engine tests that bypass real isolation.
  if [[ -n "${_SCODE_PLATFORM:-}" ]]; then
    case "${_SCODE_PLATFORM}" in
      darwin|linux)
        if [[ "${DRY_RUN:-0}" -ne 1 ]]; then
          error "internal platform override is only permitted with --dry-run"
          exit 1
        fi
        PLATFORM="${_SCODE_PLATFORM}"
        return
        ;;
      *) error "invalid internal platform override: ${_SCODE_PLATFORM}"; exit 1 ;;
    esac
  fi
  case "$(uname -s)" in
    Darwin) PLATFORM="darwin" ;;
    Linux)  PLATFORM="linux" ;;
    *)      error "unsupported platform: $(uname -s)"; exit 1 ;;
  esac
}

usage() {
  echo "${PROGRAM_NAME} ${PROGRAM_VERSION}"
  cat <<'EOF'
Safe sandbox wrapper for AI coding harnesses.

Usage:
  scode [options] [--] <command> [args...]
  scode [options] <harness> [args...]       # shortcut for known harnesses
  scode                                     # defaults to: opencode
  scode audit [--watch|-w] <logfile>          # parse denial log, suggest --allow flags

Options:
  -h, --help          Show this help and exit
  -V, --version       Show version and exit
  -n, --no-net        Disable network access inside the sandbox
  -C, --cwd DIR       Project/working directory (default: $PWD; singleton)
  --ro                Mount project directory read-only
  --rw                Mount project directory read-write (default)
  --block PATH        Block access to a path (directory or file; can be repeated)
  --allow PATH        Allow access to a path subtree, overriding block rules (can be repeated)
  --strict            Deny-default sandbox (only allow project dir + system essentials)
  --trust LEVEL       Named trust preset: trusted, standard, untrusted (singleton)
  --config FILE       Use FILE as config (default: ~/.config/scode/sandbox.yaml; singleton)
  --scrub-env         Scrub sensitive env vars (API keys, tokens) before exec
  --no-credential-sync
                      Do not copy Claude Code's Keychain credential to
                      ~/.claude/.credentials.json (sandboxed claude cannot
                      then authenticate; macOS only)
  --log FILE          Log sandbox violations to FILE (creates parent dirs; singleton)
  --dry-run           Print sandbox profile/command without executing

Path Semantics:
  Relative paths for --block/--allow and config blocked/allowed are resolved
  against the project directory (--cwd, or $PWD by default).
  Allow rules are recursive (firewall-style): allowing /a allows /a/**
  even if descendants are listed in defaults or --block/config blocked.

Known Harnesses (can be used directly without --):
EOF
  local harness_list
  harness_list="$(printf '%s, ' "${KNOWN_HARNESSES[@]}")"
  echo "  ${harness_list%, }"
  cat <<'EOF'

Default Protections:
  The following paths are blocked by default:
    Personal media, documents, downloads, and shell/database histories
    ~/.ssh, ~/.gnupg, ~/.pki, cloud/container/IaC credentials
    Password managers, browser profiles, keyrings, and package tokens
    ~/.npmrc, ~/.netrc, ~/.git-credentials, ~/.pypirc
    ~/.config/gh, ~/.config/glab-cli, ~/.huggingface
    ~/Library (macOS only — no automatic credential carve-outs)
    Additional Linux-specific blocks (browser profiles, keyrings, etc.)

  Use --allow to override specific defaults:
    scode --allow ~/Documents claude

Config File:
  ~/.config/scode/sandbox.yaml

  Scalar options (applied unless overridden by CLI flags):
    net: off             # same as --no-net
    fs_mode: ro          # same as --ro
    strict: true         # same as --strict
    scrub_env: true      # same as --scrub-env
    grok_defense: true   # harden Grok collection + block repo history/secrets

  Example:
    strict: true
    scrub_env: true
    blocked:
      - ~/.aws
      - ~/.gnupg

Environment:
  SCODE_CONFIG       Path to config file (default: ~/.config/scode/sandbox.yaml)
  SCODE_NET          "on" (default) or "off"
  SCODE_FS_MODE      "rw" (default) or "ro"
  SCODE_ACCOUNT_FILE Append one JSON line at exit with per-run scratch usage
                     (KiB, duration, exit code); parent dir must exist; a
                     relative path resolves against the invoking directory
  SCODE_ACCOUNT_ID   Correlation token (letters, digits, . _ : -; at most
                     128 characters) recorded in the account line; neither
                     variable is passed to the sandboxed child

Platform Support:
  macOS:  Uses sandbox-exec (built-in)
  Linux:  Uses bubblewrap (bwrap). Install:
            apt install bubblewrap    # Debian/Ubuntu
            dnf install bubblewrap    # Fedora/RHEL

Examples:
  scode opencode                     # run opencode in sandbox
  scode claude                       # run claude in sandbox
  scode codemux -a claude            # run codemux with claude adapter
  scode -- npm test                  # run any command in sandbox
  scode --ro claude                  # read-only sandbox
  scode --allow ~/Documents claude   # unblock ~/Documents
  scode -n claude                    # no network access
  scode --strict claude              # deny-default; ~/.claude stays read-write
  scode --trust untrusted claude     # maximum lockdown; no harness-state auto-allow
  scode --trust trusted claude       # minimal sandbox (rw, net on)
  scode --scrub-env claude           # scrub API keys from env
  scode --log session.log claude     # log sandbox denials for review
  scode audit session.log            # parse denials, suggest --allow flags

Strict Mode Auto-Allow:
  When --strict detects a known harness, it automatically allows read-write access to:
    - The harness config/state paths (e.g. ~/.claude for claude)
  Write access is required: OAuth harnesses rotate credentials and must persist
  the replacement, or the login is destroyed the first time the token expires.
  Use --block to suppress a specific auto-allow (e.g. --block ~/.claude).
  --trust untrusted disables harness-state auto-allows entirely.

Trust Presets:
  --trust trusted      Minimal sandbox: rw, network on, no strict, no scrub-env.
                       Overrides config-level settings for these four values.
  --trust standard     Default behavior (same as no --trust flag).
  --trust untrusted    Maximum lockdown: --strict + --no-net + --scrub-env + --ro.
                       Cannot be weakened by config files.
  Explicit flags (--rw, --strict, etc.) override --trust settings.

Project Config:
  .scode.yaml in the project root (--cwd directory) is loaded with lower
  priority than the user config. It may only tighten the policy; project
  allowed paths and permissive scalar values are ignored.

Audit Subcommand:
  scode audit <logfile>
  scode audit --watch <logfile>
  Parses denial patterns from --log output and categorizes paths against the
  effective blocked list recorded in the log. Suggests --allow flags for
  default/platform blocks; custom policy blocks (--block, config, project)
  are labeled separately with no --allow suggestion. Falls back to built-in
  defaults for logs without blocked metadata.
  With --watch (-w), tails the log file and prints new denials in real-time.

Browser Support:
  scode automatically prevents double-sandboxing by exporting:
    SCODE_SANDBOXED=1              - signals tools they're inside scode
    ELECTRON_DISABLE_SANDBOX=1     - disables Electron's sandbox
    PLAYWRIGHT_MCP_NO_SANDBOX=1    - disables Playwright MCP's sandbox
    CHROMIUM_FLAGS="--no-sandbox"  - disables Chrome/Chromium's sandbox

  For Puppeteer and Playwright library usage, scode injects a Node.js
  preload module (via NODE_OPTIONS) that patches child_process.spawn,
  spawnSync, exec, execSync, execFile, and execFileSync to automatically
  add --no-sandbox when launching Chromium binaries.
  A compromised renderer therefore inherits everything the outer scode policy
  permits. Minimize explicit allows and use --trust untrusted for hostile input.

  Chrome/Playwright also need --no-sandbox for sandbox-exec (nested sandbox).
  For Claude Code with Playwright plugin, create .mcp.json in project root:
    {
      "mcpServers": {
        "playwright": {
          "command": "npx",
          "args": ["@playwright/mcp@0.0.78", "--no-sandbox"]
        }
      }
    }
EOF
