version() {
  echo "${PROGRAM_NAME} ${PROGRAM_VERSION}"
}

error() {
  printf '%b%s%b\n' "${RED}${PROGRAM_NAME}: " "$(terminal_escape "$*")" "${NC}" >&2
}

warning() {
  printf '%b%s%b\n' "${YELLOW}${PROGRAM_NAME}: " "$(terminal_escape "$*")" "${NC}" >&2
}

info() {
  printf '%b%s%b\n' "${GREEN}${PROGRAM_NAME}: " "$(terminal_escape "$*")" "${NC}" >&2
}

# Ensure the parent directory for a log file exists.
ensure_log_parent_dir() {
  local log_file="$1"
  if [[ -d "$log_file" && ! -L "$log_file" ]]; then
    error "log path is a directory: ${log_file}"
    exit 1
  fi
  local log_dir
  log_dir="$(dirname "${log_file}")"
  if [[ -d "${log_dir}" ]]; then
    return 0
  fi
  if ! mkdir -p "${log_dir}"; then
    error "failed to create log directory: ${log_dir}"
    exit 1
  fi
}

# Forward a termination signal to the sandbox engine from a runner's
# forwarding trap. A signal that arrives before the engine pid exists is
# queued -- a kill against an empty pid would lose it for good -- and
# flush_pending_signals delivers it right after the launch. A forward that
# finds the engine already gone changes nothing: the engine's own exit
# status is the honest one, and forcing 128+n there would rewrite a run
# that was never actually interrupted. Both helpers reach the caller's
# signal_rc / command_pid / pending_signals through bash dynamic scoping.
# shellcheck disable=SC2329  # referenced from the runners' trap strings
forward_run_signal() {
  if [[ -n "${command_pid:-}" ]]; then
    if kill -"$1" "${command_pid}" 2>/dev/null; then
      signal_rc="$2"
    fi
  else
    pending_signals="${pending_signals:+${pending_signals} }$1"
  fi
}

# Deliver, in arrival order, the signals queued before the engine pid
# existed, mapping each to the conventional code its trap would have
# used (INT 130, TERM 143, HUP 129). A queued INT is killed as well as
# recorded: the launcher reads the pending-INT file at its restore, but
# a parent delayed between the fork and command_pid=$! can append after
# that read, and the kill then reaches the live engine the launcher
# already started. In the chain's SIG_IGN window the kill is discarded
# and the file delivers instead; past the restore the kill lands and
# the file has no reader. One delivery either way. The code only marks
# that a delivery landed; the run reports the engine's own status.
flush_pending_signals() {
  local _sig _code
  for _sig in ${pending_signals:-}; do
    case "$_sig" in
      INT) _code=130 ;;
      TERM) _code=143 ;;
      HUP) _code=129 ;;
      *) continue ;;
    esac
    if kill -"$_sig" "${command_pid}" 2>/dev/null; then
      signal_rc="$_code"
    fi
  done
  pending_signals=""
}

# INT and HUP are generated by the terminal for the whole foreground
# process group. The engine is a child in scode's group -- required for
# its interactive stdin -- so when that group is the terminal's
# foreground group, a terminal-generated signal has already reached the
# engine, and no interface tells a trap whether the signal was generated
# for the group or aimed at scode's pid alone. scode therefore never
# forwards a second copy: a forwarded copy interrupted engines that were
# still handling the first signal (a handler running past two seconds,
# or a CLI whose first ^C means "interrupt the current work and keep
# running" received a second ^C scode could not know was a duplicate),
# and the engine's own exit status is the honest report either way. The
# cost is deliberate: a signal aimed at scode's pid while scode holds
# the terminal's foreground group is treated as a group signal and not
# delivered to the engine -- scode warns on stderr once per run, so a
# supervisor doing that is not silently ignored. (The structural fix is
# to take the engine out of scode's group and make the engine's group
# the terminal's foreground group: each source then has exactly one
# target, and pid-directed signals could forward without guessing. It is
# deferred because a stopped engine would become unreportable -- bash
# wait never returns stopped children, so scode could neither tell the
# user about ^Z nor resume the engine -- and the pty verification would
# start over.) When the group is not ours there is no controlling
# terminal, or the signal came from outside the terminal group -- the
# engine has NOT been signaled, so forward; the record carries the
# engine's own status, which is the conventional 128+n when it dies by
# the signal. TERM is never generated by a terminal, but a supervisor
# signaling the group delivers it as a group signal all the same, so it
# takes the same classification: a group-aimed TERM is absorbed, not
# forwarded again. (Without terminal truth the classification cannot
# recognize a group stop, so a group-aimed TERM reaches the engine twice
# there -- once directly, once forwarded; the engine-own-group rewrite is
# the structural fix.) ps failing or reporting
# unparseable fields returns failure, and the traps answer that with a
# plain forward: with no terminal truth available, the conservative side
# is to stop the engine. (A missing controlling terminal is not a
# failure here -- ps reads tpgid 0, which parses fine and takes the
# forward branch.) A signal in the trap-install-to-launch window finds
# no engine: nothing was signaled alongside us, so the group question is
# moot and the signal is queued -- flush_pending_signals delivers TERM
# and HUP right after the launch, and every INT is also recorded in the
# per-run pending file the launcher reads once it has restored SIG_DFL.
# The file, not the parent's queue, is what carries INT: it is shared
# state, so it also reaches an INT that arrives between the fork and
# command_pid=$! -- a queue in the parent alone cannot reach a child
# that forked before the queue was written. (The log runner's traps skip
# killing the writer on that branch, so the delivery keeps its stderr
# reader.)
# shellcheck disable=SC2329  # referenced from the runners' trap strings
forward_or_note() {
  local _fields _tpgid _pgid _is_int=""
  if [[ "$1" == "INT" ]]; then _is_int=1; fi
  if [[ -z "${command_pid:-}" ]]; then
    forward_run_signal "$1" "$2"
    if [[ -n "$_is_int" ]]; then note_pending_int; fi
    return 0
  fi
  if ! _fields="$(ps -o tpgid=,pgid= -p "$$" 2>/dev/null)"; then
    if [[ -n "$_is_int" ]]; then note_pending_int; fi
    return 1
  fi
  read -r _tpgid _pgid _ <<<"$_fields" || true
  if ! [[ "${_tpgid:-}" =~ ^[0-9]+$ && "${_pgid:-}" =~ ^[0-9]+$ ]]; then
    if [[ -n "$_is_int" ]]; then note_pending_int; fi
    return 1
  fi
  # The structural fix for the pid-aimed case below is to give the
  # engine its own process group and make that group the terminal's
  # foreground group, so a typed group signal and a pid-directed one
  # each reach exactly one target. This is the plan, deferred on
  # purpose: with the engine in its own group, bash wait never returns
  # a stopped child, so scode could neither report ^Z nor resume the
  # engine. See README for the full trade-off.
  if [[ "$_tpgid" == "$_pgid" ]]; then
    if [[ -z "${group_note_emitted:-}" ]]; then
      group_note_emitted=1
      # || true: with stderr closed the warning itself fails, and under
      # errexit it would abort the trap mid-delivery.
      printf 'scode: SIG%s arrived while the engine shares the terminal foreground group; treating it as a terminal-group signal and not forwarding\n' "$1" >&2 || true
    fi
    group_signaled=1
    # A group INT inside the SIG_IGN window was discarded by the chain;
    # recording it delivers exactly one INT at the restore.
    if [[ -n "$_is_int" ]]; then note_pending_int; fi
  else
    # Record first, then kill -- in that order exactly one delivery lands
    # in every interleaving. A record the launcher's restore has not read
    # yet is self-delivered there; a record it has already passed is
    # backed by the kill, which reaches the live engine. Kill-first had a
    # hole: a kill landing in the chain's SIG_IGN window is discarded, and
    # a restore+read that ran between the kill and the append would find
    # the file empty and exec the engine -- the cancellation lost with no
    # delivery anywhere.
    if [[ -n "$_is_int" ]]; then note_pending_int; fi
    forward_run_signal "$1" "$2"
  fi
  return 0
}

# Record an INT for the launcher to deliver after it restores SIG_DFL.
# The write goes through the descriptor opened at creation, so a swapped
# path in a command-writable directory cannot redirect it; with the
# descriptor unopened (creation failed) the write fails silently and
# delivery degrades to kill-only -- scode closes fd 7 at startup, so a
# descriptor the caller happened to open there cannot stand in for it.
# Post-exec the file has no reader, so a
# late record is a harmless no-op -- the property that makes
# append-alongside-kill single-delivery in every launch phase.
# shellcheck disable=SC2329  # called from forward_or_note, itself referenced from trap strings
note_pending_int() {
  printf 'INT\n' >&7 2>/dev/null || true
}

# Run a command and mirror its stderr to both terminal and log file without
# process substitution (works in restricted runtimes where /dev/fd is blocked).
run_with_stderr_log() {
  local log_file="$1"
  shift

  if ! { : >&9; } 2>/dev/null; then
    error "log descriptor is not open: ${log_file}"
    return 1
  fi
  # The drain check below reads through this descriptor, pinned before
  # the command runs: greping the path every poll would follow a swap of
  # the log pathname, and a FIFO planted there blocks the grep's open
  # forever -- past the engine's exit, so accounting and teardown would
  # never run. Each read resumes at this descriptor's own offset.
  if ! { exec 5<"${log_file}"; } 2>/dev/null; then
    error "log is not readable: ${log_file}"
    exec 9>&-
    return 1
  fi

  local tmp_dir
  if ! tmp_dir="$(mktemp -d "/tmp/scode-log.XXXXXX")"; then
    error "failed to create temporary log directory"
    exec 9>&-
    return 1
  fi
  # Remembered for the EXIT trap: a fatal signal that skips the runner's
  # own cleanup below (QUIT mid-run) must not leak the directory.
  _SCODE_LOG_TMP_DIR="${tmp_dir}"

  local stderr_pipe="${tmp_dir}/stderr.pipe"
  if ! mkfifo "${stderr_pipe}"; then
    error "failed to create temporary stderr pipe"
    rmdir "${tmp_dir}" 2>/dev/null || true
    exec 9>&-
    return 1
  fi

  # write_log_header_json opened fd 9 on the same temporary inode before
  # installing it at log_file. Stream through that descriptor so a sandboxed
  # command cannot redirect logging by replacing the path.
  #
  # The log is written through fd 9 itself (tee's stdout), never through a path.
  # On Linux /dev/fd/N is a /proc symlink, so naming /dev/fd/9 as a tee *file*
  # would re-resolve the log path on every run -- which both truncated the
  # header and reopened the symlink-replacement race this descriptor exists to
  # close. Only the stderr copy is addressed by path, and stderr already belongs
  # to the caller; -a keeps that copy from truncating a redirected stderr file.
  tee -a /dev/fd/2 < "${stderr_pipe}" >&9 &
  local tee_pid=$!
  local tee_signaled=0

  # scode holds its own write end of the pipe. After the engine is
  # reaped, the sentinel appended through it is the last line scode puts
  # in the pipe: when the log shows the sentinel, the writer has
  # consumed and flushed every byte the engine wrote before it, and
  # ending the writer can no longer lose anything the run owes the log.
  # The sentinel doubles as the log's completion marker. Degrade: with
  # the write end unopenable the sentinel stays empty, the poll below
  # ends on the writer's own exit, and a clean exit stands in as the
  # drain proof -- with EOF after the engine is reaped the log is
  # complete, so only an unclean writer death is reported.
  # The token carries bits from /dev/urandom; RANDOM draws are only the
  # fallback for a host where urandom cannot be read. The launch chain
  # execs without forking, so the command's PPID is scode's pid, and a
  # pid-only marker would be forgeable from inside the sandbox. bash
  # 3.2, the macOS /bin/bash, seeds RANDOM from the pid and the clock,
  # both known to the sandboxed command, so the fallback is guessable
  # in principle -- but urandom exists on every platform scode
  # supports. A forged marker would end the writer mid-drain and get
  # the truncated log reported as complete.
  local _scode_rand=""
  _scode_rand="$(od -An -N12 -tx1 /dev/urandom 2>/dev/null | tr -d ' \n' || true)"
  [[ -n "$_scode_rand" ]] || _scode_rand="${RANDOM}${RANDOM}${RANDOM}${RANDOM}"
  local _scode_sentinel="scode-log-complete run $$-${_scode_rand}"
  if ! { exec 6>>"${stderr_pipe}"; } 2>/dev/null; then
    _scode_sentinel=""
  fi

  # Per-run queue for INT arriving in the launch phase: before the fork,
  # between the fork and command_pid=$! (a parent-side queue cannot reach
  # the already-forked launcher there), and through the chain's SIG_IGN
  # window. Created eagerly so the launcher env can carry the path; on
  # failure the path stays empty and INT delivery in that window
  # degrades to kill-only. Removed by the EXIT trap.
  _SCODE_PENDING_INT_FILE=""
  if ! _SCODE_PENDING_INT_FILE="$(mktemp "${TMPDIR:-/tmp}/scode-int.XXXXXX" 2>/dev/null)"; then
    _SCODE_PENDING_INT_FILE=""
    printf 'scode: could not create the pending-signal file; a Ctrl-C during launch may be lost\n' >&2 || true
  elif ! { exec 7>>"$_SCODE_PENDING_INT_FILE"; } 2>/dev/null; then
    # The braces keep the 2>/dev/null scoped to the open attempt: a bare
    # `exec 7>>file 2>/dev/null` in a condition applies BOTH redirections
    # to the shell for good, and stderr goes silent for the rest of the
    # run -- warnings, group notes, everything. Verified on bash 3.2.
    # Appends go through this descriptor, never through the path: the
    # file lives in the caller's temp directory, which a command whose
    # sandbox grants that directory (a caller-pointed TMPDIR under the
    # project) could swap for a symlink -- a path append would make the
    # unsandboxed parent write into a file of the command's choosing.
    # The descriptor is pinned at creation; the launcher's fd guard
    # closes it before the engine execs, so the engine never holds it.
    rm -f "$_SCODE_PENDING_INT_FILE" 2>/dev/null || true
    _SCODE_PENDING_INT_FILE=""
    printf 'scode: could not open the pending-signal file; a Ctrl-C during launch may be lost\n' >&2 || true
  fi
  # Launch-phase INT handshake: the INT trap creates the mark directory
  # while it classifies and records, and removes it on the way out; the
  # launcher waits (bounded) for the mark to disappear before it reads
  # the pending file. Without it, an INT landing while the trap's ps
  # classification runs could reach a launcher that reads the
  # still-empty pending file, execs the engine, and loses the Ctrl-C --
  # the late record has no reader, and the group branch never kills.
  # The mark is a directory inside a 0700 directory mktemp reserved,
  # never a written file: mkdir and rmdir refuse a final-path symlink
  # instead of following one, so a sandboxed command that plants one
  # cannot aim the parent's trap at an outside file. A command that
  # pins the mark in place only adds a bounded two-second launch delay.
  # Removed by the EXIT trap.
  _SCODE_TRAP_BUSY=""
  _SCODE_TRAP_BUSY_DIR=""
  if ! _SCODE_TRAP_BUSY_DIR="$(mktemp -d "${TMPDIR:-/tmp}/scode-busy.XXXXXX" 2>/dev/null)"; then
    _SCODE_TRAP_BUSY_DIR=""
  else
    _SCODE_TRAP_BUSY="${_SCODE_TRAP_BUSY_DIR}/busy"
  fi
  local rc=0
  local signal_rc=0
  local group_signaled=0
  local group_note_emitted=""
  local pending_signals=""
  local command_pid=""
  # The traps go up before the launch: a signal landing between the fork
  # and a later-installed handler would run the top-level exit handler
  # instead, tearing the scratch down under an engine that is still
  # starting. The forwarding helpers queue anything that arrives before
  # the engine pid exists; TERM and HUP are delivered right after the
  # launch, and INT rides the pending-INT file into the launcher. The
  # writer kill is gated on the engine existing: pre-launch the signal is
  # queued, not delivered, so the writer must survive to mirror the
  # flushed delivery. The signal path never kills the writer: an engine
  # that survives a forwarded signal keeps its log complete, and a
  # shutdown diagnostic written after the signal lands in the log rather
  # than in a broken pipe. If ps cannot classify a signal, the traps
  # fall back to a plain forward: with no terminal truth available,
  # stopping the engine is the conservative side.
  trap '{ mkdir "${_SCODE_TRAP_BUSY:-/dev/null/scode-busy}"; } 2>/dev/null || true; forward_or_note INT 130 || forward_run_signal INT 130; { rmdir "${_SCODE_TRAP_BUSY:-/dev/null/scode-busy}"; } 2>/dev/null || true' INT
  # TERM joins the group classification: a supervisor signaling the whole
  # group has already delivered it, and a forwarded copy would reach the
  # engine twice.
  trap 'forward_or_note TERM 143 || forward_run_signal TERM 143' TERM
  trap 'forward_or_note HUP 129 || forward_run_signal HUP 129' HUP
  trap 'exit 131' QUIT

  # The launch was attempted; whether the sandbox actually formed is not
  # observable from outside. Set immediately before the fork so a signal
  # landing between the fork and this function returning still records as
  # an attempted launch.
  _SCODE_SANDBOX_LAUNCH_ATTEMPTED=1

  # <&0: an asynchronous command's stdin defaults to /dev/null when job
  # control is off; the explicit redirection preserves the caller's stdin.
  # A caller with no stdin at all (`scode -- cmd 0<&-`) would fail the
  # redirection outright and kill the launch; that caller gets the async
  # default instead.
  # The command's stderr is the write end scode already holds, not a
  # fresh open of the FIFO path. A path open waits for a reader: if the
  # logger died between its own open and this one, the command would
  # block on the open forever while scode waits on the command, and no
  # accounting or teardown would ever run. An already-open descriptor
  # needs no open, so it cannot block. The degrade path (write end
  # unopenable, sentinel empty) keeps the path open; the branch already
  # runs without the sentinel and its completion proof.
  if [[ -n "$_scode_sentinel" ]]; then
    if ( : <&0 ) 2>/dev/null; then
      "$@" 2>&6 <&0 &
    else
      "$@" 2>&6 </dev/null &
    fi
  else
    if ( : <&0 ) 2>/dev/null; then
      "$@" 2>"${stderr_pipe}" <&0 &
    else
      "$@" 2>"${stderr_pipe}" </dev/null &
    fi
  fi
  command_pid=$!
  flush_pending_signals

  # Bash defers traps while waiting on a foreground command. Running the
  # sandbox engine as a child lets us forward termination promptly and reap
  # both the engine and logger before returning the engine's own status.
  if wait "${command_pid}"; then
    rc=0
  else
    rc=$?
  fi
  if [[ "$signal_rc" -ne 0 || "$group_signaled" -ne 0 || "$rc" -ge 128 ]]; then
    # rc >= 128 belongs in the trigger set even with no delivery recorded:
    # a trap-interrupted wait returns the interruption's 128+n, and when
    # the forward missed -- the child had already exited while the trap
    # ran -- signal_rc is still zero, so without this arm the interrupted
    # status would stand in for the engine's own.
    # A second signal can interrupt a wait too, and a plain `|| true`
    # would read that interruption as a completed shutdown -- the EXIT trap
    # would tear the scratch down under an engine that is still running.
    # Worse, a wait interrupted by a trap returns 128+n -- the
    # interruption's status, not the run's -- and if bash reaped the engine
    # while the trap ran, kill -0 can no longer see it to wait again. bash
    # retains the status of a reaped child, so wait the engine out while it
    # is visible, then take one more wait either way: blocked while the
    # engine lives, instant once it is reaped. The last result is the
    # engine's own status -- the honest report for a terminal-group signal,
    # which the engine received exactly as any foreground child would have.
    while kill -0 "${command_pid}" 2>/dev/null; do
      if wait "${command_pid}"; then rc=0; else rc=$?; fi
    done
    if wait "${command_pid}"; then rc=0; else rc=$?; fi
    # The engine's own status always stands. A forwarded signal is not
    # reported as a forced conventional code: an engine that dies by the
    # signal already yields 128+n through the recovered wait status, and
    # an engine that handles the signal and exits with its own choice
    # keeps that choice -- the same answer a terminal-group signal gets.
    # signal_rc records only that a delivery landed, for the trigger
    # condition that entered this block.
  fi

  # The engine is reaped; give the writer a short grace period to see EOF
  # and flush its last lines. A command that daemonized leaves a surviving
  # child holding the stderr pipe, so the wait cannot be open-ended: past
  # the grace period the run ends the writer itself. A zombie still reads
  # as an existing pid to kill -0, so the poll reads ps's state -- Z means
  # the status is already waiting to be reaped.
  # Hand the writer the sentinel: the last line scode writes to the
  # pipe, appended only after the engine is reaped and its stderr is
  # closed, so the FIFO delivers it after every engine byte. The append
  # runs in the background on purpose: with the writer wedged and the
  # FIFO full, a synchronous append would block here -- before the
  # bounded poll below ever ran, and accounting and teardown with it --
  # and no signal reaches the block, because the forwarding handlers
  # only ever target the already-reaped command. In the background the
  # blocked append costs only its own process, which the end of the
  # teardown reaps. SIGPIPE is held off around the append and inherited
  # by it -- with the writer already dead the FIFO has no reader, and a
  # bare builtin append to a readerless FIFO ends bash itself with 141
  # (verified).
  local _sentinel_pid=""
  if [[ -n "${_scode_sentinel}" ]]; then
    trap '' PIPE
    printf '%s\n' "${_scode_sentinel}" >&6 2>/dev/null || true &
    _sentinel_pid=$!
    trap - PIPE
  fi
  { exec 6>&-; } 2>/dev/null || true
  # Give the writer a bounded window to show the sentinel in the log.
  # Its presence proves the writer drained the run's stderr, so ending
  # the writer after it -- a command that daemonized leaves a
  # grandchild holding the pipe open, and EOF may never come -- loses
  # nothing. A writer that never shows it is wedged or was replaced from
  # outside: the log is already incomplete, and the guard below reports
  # that instead of suppressing it. A zombie still reads as an existing
  # pid to kill -0, so the poll reads ps's state -- Z means the status is
  # already waiting to be reaped.
  local tee_rc=0
  local _drained=0
  local _tee_state=""
  local _sent_state=""
  local _poll=0
  while (( _poll < 40 )); do
    if [[ -n "${_scode_sentinel}" ]] && grep -qF -- "${_scode_sentinel}" <&5 2>/dev/null; then
      _drained=1
      break
    fi
    _tee_state="$(ps -o stat= -p "${tee_pid}" 2>/dev/null | tr -d '[:space:]')"
    if [[ -z "$_tee_state" || "$_tee_state" == Z* ]]; then
      break
    fi
    sleep 0.25
    _poll=$((_poll + 1))
  done
  # The log copy is proven complete, but the writer has a second copy
  # to flush: tee writes each chunk to the log first and its stderr
  # mirror second, so killing the writer the moment the sentinel lands
  # can cut the mirror short with bytes the engine did write. In the
  # ordinary run the writer sees EOF -- the engine is reaped and the
  # run's own write end is closed right after the sentinel -- and exits
  # on its own once the mirror drains; give it that chance, bounded.
  # A writer that stays is one a daemonized grandchild keeps alive
  # through the pipe, or one whose mirror consumer stopped reading;
  # the teardown below then ends it, and the documented drop of
  # post-reap output applies.
  if [[ "$_drained" -eq 1 ]]; then
    _poll=0
    while (( _poll < 40 )); do
      _tee_state="$(ps -o stat= -p "${tee_pid}" 2>/dev/null | tr -d '[:space:]')"
      if [[ -z "$_tee_state" || "$_tee_state" == Z* ]]; then
        break
      fi
      sleep 0.25
      _poll=$((_poll + 1))
    done
  fi
  _tee_state="$(ps -o stat= -p "${tee_pid}" 2>/dev/null | tr -d '[:space:]')"
  if [[ -n "$_tee_state" && "$_tee_state" != Z* ]]; then
    tee_signaled=1
    kill -TERM "${tee_pid}" 2>/dev/null || true
    # A stopped writer (an outside SIGSTOP) holds the TERM until it is
    # continued, and the wait below would block on it forever; a nudge
    # lets the TERM land. Harmless for a running writer.
    _tee_state="$(ps -o stat= -p "${tee_pid}" 2>/dev/null | tr -d '[:space:]')"
    if [[ "$_tee_state" == T* ]]; then
      kill -CONT "${tee_pid}" 2>/dev/null || true
    fi
  fi
  if wait "${tee_pid}"; then
    tee_rc=0
  else
    tee_rc=$?
  fi
  # The run ended a writer whose log copy was already proven complete,
  # so the guard below suppresses the death -- but a writer that had to
  # be killed was still mirroring to stderr, and bytes the engine did
  # write may have been left unflushed in that copy (a mirror consumer
  # that stopped, or slowed past the grace window). Say so instead of
  # ending silently.
  if [[ "$tee_rc" -ne 0 && "$tee_signaled" -eq 1 && "$_drained" -eq 1 ]]; then
    printf 'scode: ended the log writer after the log was complete; its stderr mirror may be missing the tail of the output\n' >&2 || true
  fi
  # End the background append if it is still in flight. Killing the
  # writer above released the FIFO's read end, so a blocked append has
  # already failed with EPIPE and exited on its own; this only catches
  # the stragglers.
  if [[ -n "${_sentinel_pid}" ]]; then
    _sent_state="$(ps -o stat= -p "${_sentinel_pid}" 2>/dev/null | tr -d '[:space:]')"
    if [[ -n "$_sent_state" && "$_sent_state" != Z* ]]; then
      kill -TERM "${_sentinel_pid}" 2>/dev/null || true
    fi
    wait "${_sentinel_pid}" 2>/dev/null || true
  fi
  # A writer death is the run's doing only when the run killed it after
  # the log was proven complete, or when a terminal-group signal reached
  # the writer through the group and the sentinel arrived anyway. A TERM
  # belongs there as much as an INT or a HUP: the sentinel has already
  # proved the log complete, so the death cannot corrupt it, and a
  # supervisor signaling the whole group is as much an outside event as
  # the terminal's own signal. Everything else is a
  # failure the run reports instead of returning success with an
  # incomplete log: a writer that died on its own, one an outside kill
  # took down, and one the run had to end before the sentinel showed.
  if [[ "$tee_rc" -ne 0 ]]; then
    if [[ "$tee_signaled" -eq 1 && "$_drained" -eq 1 && ( "$tee_rc" -eq 130 || "$tee_rc" -eq 143 || "$tee_rc" -eq 129 ) ]]; then
      :
    elif [[ "$_drained" -eq 1 && "$group_signaled" -ne 0 && ( "$tee_rc" -eq 130 || "$tee_rc" -eq 143 || "$tee_rc" -eq 129 ) ]]; then
      :
    else
      error "log writer failed — requested log is incomplete"
      [[ "$rc" -eq 0 ]] && rc=1
    fi
  fi
  { exec 5>&-; } 2>/dev/null || true
  exec 9>&-
  rm -f "${stderr_pipe}"
  rmdir "${tmp_dir}" 2>/dev/null || true
  restore_signal_traps
  return "${rc}"
}

# A fatal signal kills Bash while $? still holds the last command's status,
# so the EXIT trap would record a stale exit code. Conventional handlers map
# each signal to its 128+n exit before the EXIT trap runs. Runners install
# forwarding handlers while a child owns the foreground; when a runner
# returns, these must be back in place -- cleared handlers would leave the
# window before exit unprotected, which is worse than no runner at all.
restore_signal_traps() {
  trap 'exit 130' INT
  trap 'exit 143' TERM
  trap 'exit 129' HUP
  trap 'exit 131' QUIT
}

run_engine_forwarding() {
  # The default (no --log) path ran the engine in the foreground, and Bash
  # defers trap execution while a foreground command runs -- so a supervisor
  # signaling scode's PID was answered only when the engine finished on its
  # own. Bash instead runs pending traps the moment a `wait` on a background
  # child is interrupted, so the engine runs as a background child here and
  # the handlers forward, exactly as run_with_stderr_log does.
  #
  # <&0: an asynchronous command's stdin defaults to /dev/null when job
  # control is off; the explicit redirection preserves the caller's stdin,
  # so piped input and interactive harnesses keep working. A caller with no
  # stdin at all (`scode -- cmd 0<&-`) would fail the redirection outright
  # and kill the launch; that caller gets the async default instead.
  # Per-run queue for INT arriving in the launch phase: before the fork,
  # between the fork and command_pid=$! (a parent-side queue cannot reach
  # the already-forked launcher there), and through the chain's SIG_IGN
  # window. Created eagerly so the launcher env can carry the path; on
  # failure the path stays empty and INT delivery in that window
  # degrades to kill-only. Removed by the EXIT trap.
  _SCODE_PENDING_INT_FILE=""
  if ! _SCODE_PENDING_INT_FILE="$(mktemp "${TMPDIR:-/tmp}/scode-int.XXXXXX" 2>/dev/null)"; then
    _SCODE_PENDING_INT_FILE=""
    printf 'scode: could not create the pending-signal file; a Ctrl-C during launch may be lost\n' >&2 || true
  elif ! { exec 7>>"$_SCODE_PENDING_INT_FILE"; } 2>/dev/null; then
    # The braces keep the 2>/dev/null scoped to the open attempt: a bare
    # `exec 7>>file 2>/dev/null` in a condition applies BOTH redirections
    # to the shell for good, and stderr goes silent for the rest of the
    # run -- warnings, group notes, everything. Verified on bash 3.2.
    # Appends go through this descriptor, never through the path: the
    # file lives in the caller's temp directory, which a command whose
    # sandbox grants that directory (a caller-pointed TMPDIR under the
    # project) could swap for a symlink -- a path append would make the
    # unsandboxed parent write into a file of the command's choosing.
    # The descriptor is pinned at creation; the launcher's fd guard
    # closes it before the engine execs, so the engine never holds it.
    rm -f "$_SCODE_PENDING_INT_FILE" 2>/dev/null || true
    _SCODE_PENDING_INT_FILE=""
    printf 'scode: could not open the pending-signal file; a Ctrl-C during launch may be lost\n' >&2 || true
  fi
  # Launch-phase INT handshake: the INT trap creates the mark directory
  # while it classifies and records, and removes it on the way out; the
  # launcher waits (bounded) for the mark to disappear before it reads
  # the pending file. Without it, an INT landing while the trap's ps
  # classification runs could reach a launcher that reads the
  # still-empty pending file, execs the engine, and loses the Ctrl-C --
  # the late record has no reader, and the group branch never kills.
  # The mark is a directory inside a 0700 directory mktemp reserved,
  # never a written file: mkdir and rmdir refuse a final-path symlink
  # instead of following one, so a sandboxed command that plants one
  # cannot aim the parent's trap at an outside file. A command that
  # pins the mark in place only adds a bounded two-second launch delay.
  # Removed by the EXIT trap.
  _SCODE_TRAP_BUSY=""
  _SCODE_TRAP_BUSY_DIR=""
  if ! _SCODE_TRAP_BUSY_DIR="$(mktemp -d "${TMPDIR:-/tmp}/scode-busy.XXXXXX" 2>/dev/null)"; then
    _SCODE_TRAP_BUSY_DIR=""
  else
    _SCODE_TRAP_BUSY="${_SCODE_TRAP_BUSY_DIR}/busy"
  fi
  local rc=0
  local signal_rc=0
  local group_signaled=0
  local group_note_emitted=""
  local pending_signals=""
  local command_pid=""
  # The traps go up before the launch: a signal landing between the fork
  # and a later-installed handler would run the top-level exit handler
  # instead, tearing the scratch down under an engine that is still
  # starting. The forwarding helpers queue anything that arrives before
  # the engine pid exists; TERM and HUP are delivered right after the
  # launch, and INT rides the pending-INT file into the launcher. If ps
  # cannot classify a signal, the traps fall back to a plain forward:
  # with no terminal truth available, stopping the engine is the
  # conservative side.
  trap '{ mkdir "${_SCODE_TRAP_BUSY:-/dev/null/scode-busy}"; } 2>/dev/null || true; forward_or_note INT 130 || forward_run_signal INT 130; { rmdir "${_SCODE_TRAP_BUSY:-/dev/null/scode-busy}"; } 2>/dev/null || true' INT
  # TERM joins the group classification: a supervisor signaling the whole
  # group has already delivered it, and a forwarded copy would reach the
  # engine twice.
  trap 'forward_or_note TERM 143 || forward_run_signal TERM 143' TERM
  trap 'forward_or_note HUP 129 || forward_run_signal HUP 129' HUP
  trap 'exit 131' QUIT

  # The launch was attempted; whether the sandbox actually formed is not
  # observable from outside. Set immediately before the fork so a signal
  # landing between the fork and this function returning still records as
  # an attempted launch.
  _SCODE_SANDBOX_LAUNCH_ATTEMPTED=1

  # <&0: an asynchronous command's stdin defaults to /dev/null when job
  # control is off; the explicit redirection preserves the caller's stdin,
  # so piped input and interactive harnesses keep working. A caller with no
  # stdin at all (`scode -- cmd 0<&-`) would fail the redirection outright
  # and kill the launch; that caller gets the async default instead.
  if ( : <&0 ) 2>/dev/null; then
    run_sandbox_engine_with_closed_fds "$@" <&0 &
  else
    run_sandbox_engine_with_closed_fds "$@" </dev/null &
  fi
  command_pid=$!
  flush_pending_signals

  if wait "${command_pid}"; then
    rc=0
  else
    rc=$?
  fi
  if [[ "$signal_rc" -ne 0 || "$group_signaled" -ne 0 || "$rc" -ge 128 ]]; then
    # rc >= 128 belongs in the trigger set even with no delivery recorded:
    # a trap-interrupted wait returns the interruption's 128+n, and when
    # the forward missed -- the child had already exited while the trap
    # ran -- signal_rc is still zero, so without this arm the interrupted
    # status would stand in for the engine's own.
    # A second signal can interrupt a wait too, and a plain `|| true`
    # would read that interruption as a completed shutdown -- the EXIT trap
    # would tear the scratch down under an engine that is still running.
    # Worse, a wait interrupted by a trap returns 128+n -- the
    # interruption's status, not the run's -- and if bash reaped the engine
    # while the trap ran, kill -0 can no longer see it to wait again. bash
    # retains the status of a reaped child, so wait the engine out while it
    # is visible, then take one more wait either way: blocked while the
    # engine lives, instant once it is reaped. The last result is the
    # engine's own status -- the honest report for a terminal-group signal,
    # which the engine received exactly as any foreground child would have.
    while kill -0 "${command_pid}" 2>/dev/null; do
      if wait "${command_pid}"; then rc=0; else rc=$?; fi
    done
    if wait "${command_pid}"; then rc=0; else rc=$?; fi
    # The engine's own status always stands. A forwarded signal is not
    # reported as a forced conventional code: an engine that dies by the
    # signal already yields 128+n through the recovered wait status, and
    # an engine that handles the signal and exits with its own choice
    # keeps that choice -- the same answer a terminal-group signal gets.
    # signal_rc records only that a delivery landed.
  fi

  restore_signal_traps
  return "${rc}"
}

# kcov runs only on Linux, so this macOS-only code can never be executed under
# coverage. It is exercised by the full bats suite on the macOS CI job; excluding
# it here keeps the percentage honest instead of penalizing unreachable lines.
# Neither sandbox-exec nor bubblewrap can close inherited descriptors for us
# (bubblewrap has no such option in any released version). Start the engine
# through a fixed privileged Bash that closes every inherited descriptor except
# standard input/output/error, then replaces itself with the engine. The -c
# program is a trusted constant; all engine/profile/command values remain
# positional argv entries.
#
# The launcher ends in exec on purpose: every caller runs it as a background
# child, so $! names the engine process itself and a forwarded signal reaches
# the engine instead of an intermediary shell whose death would orphan the
# chain behind it. It must therefore never be called in the foreground.
# shellcheck disable=SC2329  # handed to the runners as an argument and launched from run_engine_forwarding
run_sandbox_engine_with_closed_fds() {
  # shellcheck disable=SC2016  # expanded by the fixed inner Bash, not this one
  # A queued INT rides along as a path: SCODE_PENDING_INT_FILE names the
  # per-run file forward_or_note appends to whenever an INT arrives
  # before the engine's dispositions are known-good -- before the launch,
  # between the fork and the engine pid being recorded, and through the
  # SIG_IGN window. The inner interpreter reads it once SIG_DFL is restored,
  # which is what makes the file work where an environment snapshot
  # cannot: the trap writes to this process's copy of the parent's
  # variables, and a child that forked before the write inherits the old
  # copy, but a file is shared state both sides can see.
  # SCODE_TRAP_BUSY carries the handshake path: while the trap's
  # classification is still running its mark directory exists, and the
  # read below waits (bounded) for it to disappear so a record being
  # written right now is not read as an empty file. Any content
  # means deliver one INT: the chain never launches and the run exits
  # with the conventional 128+n. Every branch removes the paths before
  # the exec, so the engine's environment stays clean.
  SCODE_TRAP_BUSY="${_SCODE_TRAP_BUSY:-}" SCODE_PENDING_INT_FILE="${_SCODE_PENDING_INT_FILE:-}" exec /usr/bin/env "PATH=${SCODE_CALLER_PATH}" /bin/bash -p -c '
    for fd_path in /dev/fd/[0-9]*; do
      fd=${fd_path##*/}
      case "$fd" in 0|1|2) continue ;; esac
      [[ "$fd" =~ ^[0-9]+$ ]] || continue
      eval "exec ${fd}>&-"
    done
    # Bash started this chain from an asynchronous command, and with job
    # control off Bash applies SIG_IGN to SIGINT and SIGQUIT in the child;
    # the ignored disposition survives every exec that follows, so the
    # engine would ignore Ctrl-C and the terminal group SIGINT entirely.
    # Bash itself cannot undo this (a signal ignored on entry cannot be
    # trapped or reset), but python3 can: it restores SIG_DFL before the
    # final exec, returning the engine to the dispositions it had when
    # Bash ran it in the foreground. Two further signals are restored for
    # a different reason: CPython itself starts with SIGPIPE and SIGXFSZ
    # ignored, so a launcher that stopped at INT and QUIT would hand every
    # engine broken-pipe semantics -- a truncated yes | head would exit 1
    # with an error instead of dying with the conventional 141. -I
    # (isolated mode) is not optional here: with -c, CPython puts the
    # current directory first on sys.path, and this chain runs inside the
    # project -- without -I a project-local signal.py or enum.py would
    # execute with full host privileges before the sandbox starts. -I also
    # implies -E and -s, so inherited PYTHON* variables cannot reach this
    # interpreter either. The engine itself keeps the environment the
    # caller supplied, intact.
    if [[ -x /usr/bin/python3 ]]; then
      # On macOS /usr/bin/python3 is a shim that resolves the real
      # interpreter through xcrun and honors DEVELOPER_DIR before any
      # python code runs, so -I cannot help: the shim would execute
      # code from the pointed-at directory before the sandbox starts.
      # Move the variable aside for the shim and restore it for the
      # engine below, so the engine still receives the environment the
      # caller supplied, intact.
      _sc_dd="${DEVELOPER_DIR:-}"
      _sc_dd_set="${DEVELOPER_DIR+1}"
      export _sc_dd _sc_dd_set
      unset DEVELOPER_DIR
      # The CPython startup rewrites a C locale: with LC_ALL absent and
      # LC_CTYPE C or POSIX, PEP 538 coercion sets LC_CTYPE=C.UTF-8 in
      # the environment, and the exec below would hand that rewrite to
      # the engine. The chain captures the three locale variables and
      # the program puts them back before the exec, so the engine gets
      # the environment the caller supplied, intact. Perl performs no
      # such rewrite; only this branch needs the dance.
      _sc_lc_all="${LC_ALL:-}" _sc_lc_all_set="${LC_ALL+1}"
      _sc_lc_ctype="${LC_CTYPE:-}" _sc_lc_ctype_set="${LC_CTYPE+1}"
      _sc_lang="${LANG:-}" _sc_lang_set="${LANG+1}"
      export _sc_lc_all _sc_lc_all_set _sc_lc_ctype _sc_lc_ctype_set
      export _sc_lang _sc_lang_set
      # xcrun, behind the python3 shim, injects SDKROOT, CPATH, and
      # LIBRARY_PATH when the caller left them unset -- a compiler
      # environment the caller never chose, handed to the engine with
      # the rest of the environment. The same carrier dance restores
      # the exact caller state before the exec.
      _sc_sdkroot="${SDKROOT:-}" _sc_sdkroot_set="${SDKROOT+1}"
      _sc_cpath="${CPATH:-}" _sc_cpath_set="${CPATH+1}"
      _sc_lpath="${LIBRARY_PATH:-}" _sc_lpath_set="${LIBRARY_PATH+1}"
      export _sc_sdkroot _sc_sdkroot_set _sc_cpath _sc_cpath_set
      export _sc_lpath _sc_lpath_set
      exec /usr/bin/python3 -I -c "
import os, signal, sys, time
signal.signal(signal.SIGINT, signal.SIG_DFL)
signal.signal(signal.SIGQUIT, signal.SIG_DFL)
signal.signal(signal.SIGPIPE, signal.SIG_DFL)
signal.signal(signal.SIGXFSZ, signal.SIG_DFL)
pending = os.environ.pop(\"SCODE_PENDING_INT_FILE\", \"\")
busy = os.environ.pop(\"SCODE_TRAP_BUSY\", \"\")
_dd_set = os.environ.pop(\"_sc_dd_set\", \"\")
_dd = os.environ.pop(\"_sc_dd\", \"\")
if _dd_set:
    os.environ[\"DEVELOPER_DIR\"] = _dd

# PEP 538: with LC_ALL absent the interpreter rewrote a C locale to
# C.UTF-8 in this environment at startup. Put the three locale
# variables back as the caller had them (present, absent, or empty)
# before the exec.
_lcs = ((\"LC_ALL\", \"_sc_lc_all\", \"_sc_lc_all_set\"),
        (\"LC_CTYPE\", \"_sc_lc_ctype\", \"_sc_lc_ctype_set\"),
        (\"LANG\", \"_sc_lang\", \"_sc_lang_set\"))
for _name, _carrier, _bit in _lcs:
    _had = os.environ.pop(_bit, \"\")
    _value = os.environ.pop(_carrier, \"\")
    if _had:
        os.environ[_name] = _value
    else:
        os.environ.pop(_name, None)
# The xcrun shim behind /usr/bin/python3 injects SDKROOT, CPATH, and
# LIBRARY_PATH when they are absent. Put the compiler environment back
# as the caller had it before the exec.
_build = ((\"SDKROOT\", \"_sc_sdkroot\", \"_sc_sdkroot_set\"),
          (\"CPATH\", \"_sc_cpath\", \"_sc_cpath_set\"),
          (\"LIBRARY_PATH\", \"_sc_lpath\", \"_sc_lpath_set\"))
for _name, _carrier, _bit in _build:
    _had = os.environ.pop(_bit, \"\")
    _value = os.environ.pop(_carrier, \"\")
    if _had:
        os.environ[_name] = _value
    else:
        os.environ.pop(_name, None)
if pending:
    queued = None
    settle = time.monotonic() + 2.0
    while True:
        # The mark is a directory the trap removes when its
        # classification and record are done; wait for it to disappear
        # so the read below cannot slip past the append.
        while busy and time.monotonic() < settle and os.path.isdir(busy):
            time.sleep(0.001)
        try:
            with open(pending, \"rb\") as f:
                queued = f.read(1)
        except OSError:
            queued = None
        if queued:
            break
        # A trap may have created the mark during the read; if one is
        # still set, loop and read again. Past the deadline, proceed.
        if not (busy and time.monotonic() < settle and os.path.isdir(busy)):
            break
    if queued:
        os.kill(os.getpid(), signal.SIGINT)
try:
    os.execvp(sys.argv[2], sys.argv[2:])
except OSError as exc:
    sys.exit(\"scode: engine exec failed: %s\" % exc)
" -- "$@"
    fi
    # Without python3 the restore still cannot happen inside bash -- a
    # signal ignored on entry stays ignored -- but perl can restore the
    # same four dispositions and perform the same pending-INT read, and it
    # ships on macOS and nearly every Linux host. The path is absolute
    # like the python3 path: a PATH lookup here would run a project-supplied
    # perl with host privileges, because this chain still runs before
    # the sandbox starts. Only a host with neither interpreter loses a
    # queued startup cancellation and keeps the ignored dispositions.
    if [[ -x /usr/bin/perl ]]; then
      printf "scode: /usr/bin/python3 is missing; restoring engine signals with perl\n" >&2 || true
      # perl reads PERL5OPT, PERL5LIB, PERLLIB, and PERL5DB at startup,
      # before any of the program below runs, so inherited values could
      # load a module from the project with host privileges before the
      # sandbox starts. The chain moves them to carrier names perl does
      # not read, and the program restores them before the exec, so the
      # engine still gets the environment the caller supplied, intact.
      _sc_p5opt="${PERL5OPT:-}" _sc_p5lib="${PERL5LIB:-}"
      _sc_plib="${PERLLIB:-}" _sc_p5db="${PERL5DB:-}"
      # An empty value and an unset one both collapse to "" above, but
      # they are different environment entries and the engine can tell
      # them apart. The _set carriers carry the presence bit.
      _sc_p5opt_set="${PERL5OPT+1}" _sc_p5lib_set="${PERL5LIB+1}"
      _sc_plib_set="${PERLLIB+1}" _sc_p5db_set="${PERL5DB+1}"
      export _sc_p5opt _sc_p5lib _sc_plib _sc_p5db
      export _sc_p5opt_set _sc_p5lib_set _sc_plib_set _sc_p5db_set
      unset PERL5OPT PERL5LIB PERLLIB PERL5DB
      exec /usr/bin/perl -e "
\$SIG{INT} = \"DEFAULT\";
\$SIG{QUIT} = \"DEFAULT\";
\$SIG{PIPE} = \"DEFAULT\";
\$SIG{XFSZ} = \"DEFAULT\";
my \$pending = delete \$ENV{\"SCODE_PENDING_INT_FILE\"};
my \$busy = delete \$ENV{\"SCODE_TRAP_BUSY\"};
if (\$pending) {
    my \$queued = 0;
    my \$settle = time() + 2;
    while (1) {
        # The mark is a directory the trap removes when its
        # classification and record are done; wait for it to disappear
        # so the read below cannot slip past the append.
        while (\$busy && time() < \$settle && -d \$busy) {
            select(undef, undef, undef, 0.001);
        }
        my \$n = undef;
        if (open(my \$fh, \"<\", \$pending)) {
            \$n = read(\$fh, my \$byte, 1);
            close(\$fh);
        }
        \$queued = 1 if defined(\$n) && \$n > 0;
        last if \$queued;
        # A trap may have created the mark during the read; if one is
        # still set, loop and read again. Past the deadline, proceed.
        last if !(\$busy && time() < \$settle && -d \$busy);
    }
    if (\$queued) {
        kill(\"INT\", \$\$);
    }
 } # indented: the launcher test extracts this function up to a line that starts with }
# The chain moved the startup-injection variables to carrier names
# (perl reads them before this program runs); restore them so the
# engine gets the environment the caller supplied, intact.
foreach my \$p ([\"PERL5OPT\", \"_sc_p5opt\", \"_sc_p5opt_set\"], [\"PERL5LIB\", \"_sc_p5lib\", \"_sc_p5lib_set\"], [\"PERLLIB\", \"_sc_plib\", \"_sc_plib_set\"], [\"PERL5DB\", \"_sc_p5db\", \"_sc_p5db_set\"]) {
    if (length(\$ENV{\$p->[2]})) {
        \$ENV{\$p->[0]} = delete \$ENV{\$p->[1]};
    } else {
        delete \$ENV{\$p->[1]};
    }
    delete \$ENV{\$p->[2]};
 } # indented: the launcher test extracts this function up to a line that starts with }
exec { \$ARGV[0] } @ARGV or die \"scode: engine exec failed: \$!\\n\";
" -- "$@"
    fi
    # Nothing on this host can restore the engine signal
    # dispositions (bash cannot un-ignore an inherited SIG_IGN), so
    # the engine runs with Ctrl-C and broken-pipe signals ignored.
    printf "scode: /usr/bin/python3 and perl are missing; the sandboxed command will ignore Ctrl-C and broken-pipe signals\n" >&2
    unset SCODE_PENDING_INT_FILE SCODE_TRAP_BUSY
    exec "$@"
  ' scode-fd-guard "$@"
}

# Check if arg is a known harness
is_known_harness() {
  local cmd="${1##*/}"
  # npm-installed harnesses can ship a .exe launcher even on POSIX: Claude Code
  # resolves through /opt/homebrew/bin/claude to .../bin/claude.exe. Callers
  # that resolve symlinks therefore hand us a name no entry matches, and the
  # harness loses its state auto-allow, which shows up as the harness reporting
  # that it is not logged in.
  cmd="${cmd%.exe}"
  for h in "${KNOWN_HARNESSES[@]}"; do
    [[ "$cmd" == "$h" ]] && return 0
  done
  return 1
}

_strip_outer_quotes() {
  local tok="$1"
  if [[ ${#tok} -ge 2 ]]; then
    local first="${tok:0:1}"
    local last="${tok: -1}"
    if [[ ("$first" == '"' && "$last" == '"') || ("$first" == "'" && "$last" == "'") ]]; then
      printf '%s\n' "${tok:1:${#tok}-2}"
      return
    fi
  fi
  printf '%s\n' "$tok"
}

_is_assignment_token() {
  local tok
  tok="$(_strip_outer_quotes "$1")"
  [[ "$tok" =~ ^[A-Za-z_][A-Za-z_0-9]*=.*$ ]]
}

_is_timeout_duration_token() {
  local tok="$1"
  [[ "$tok" =~ ^([0-9]+([.][0-9]+)?|[.][0-9]+)[sSmMhHdD]?$ || "$tok" =~ ^inf(inity)?$ ]]
}

_is_taskset_mask_token() {
  local tok="$1"
  [[ "$tok" =~ ^0x[0-9A-Fa-f]+$ || "$tok" =~ ^[0-9]+$ || "$tok" =~ ^[0-9]+(-[0-9]+)?(,[0-9]+(-[0-9]+)?)*$ ]]
}

_should_consume_wrapper_positional() {
  local wrapper="$1"
  local tok="$2"
  case "$wrapper" in
    nice)
      [[ "$tok" =~ ^[-+]?[0-9]+$ ]]
      ;;
    timeout)
      _is_timeout_duration_token "$tok"
      ;;
    taskset)
      _is_taskset_mask_token "$tok"
      ;;
    *)
      return 1
      ;;
  esac
}

# Split a shell command string into tokens without executing it.
# Handles quotes, backslash escapes, and shell control operators.
SHELL_SPLIT_WORDS=()
_shell_split_words() {
  local input="$1"
  SHELL_SPLIT_WORDS=()
  local token=""
  local in_single=0
  local in_double=0
  local escaped=0
  local i ch next

  for (( i=0; i<${#input}; i++ )); do
    ch="${input:$i:1}"

    if [[ "$escaped" -eq 1 ]]; then
      token+="$ch"
      escaped=0
      continue
    fi

    if [[ "$in_single" -eq 1 ]]; then
      token+="$ch"
      [[ "$ch" == "'" ]] && in_single=0
      continue
    fi

    if [[ "$in_double" -eq 1 ]]; then
      token+="$ch"
      if [[ "$ch" == "\\" ]]; then
        escaped=1
      elif [[ "$ch" == '"' ]]; then
        in_double=0
      fi
      continue
    fi

    case "$ch" in
      [[:space:]])
        if [[ -n "$token" ]]; then
          SHELL_SPLIT_WORDS+=("$token")
          token=""
        fi
        ;;
      "'")
        token+="$ch"
        in_single=1
        ;;
      '"')
        token+="$ch"
        in_double=1
        ;;
      "\\")
        token+="$ch"
        escaped=1
        ;;
      "&"|"|")
        if [[ -n "$token" ]]; then
          SHELL_SPLIT_WORDS+=("$token")
          token=""
        fi
        next="${input:$((i + 1)):1}"
        if [[ "$next" == "$ch" ]]; then
          SHELL_SPLIT_WORDS+=("${ch}${ch}")
          (( i++ ))
        else
          SHELL_SPLIT_WORDS+=("$ch")
        fi
        ;;
      ";"|"("|")")
        if [[ -n "$token" ]]; then
          SHELL_SPLIT_WORDS+=("$token")
          token=""
        fi
        SHELL_SPLIT_WORDS+=("$ch")
        ;;
      *)
        token+="$ch"
        ;;
    esac
  done

  if [[ -n "$token" ]]; then
    SHELL_SPLIT_WORDS+=("$token")
  fi
}

# Detect harness from argv-like tokens. Checks argv[0] first; if it is a
# transparent wrapper (env, timeout, etc.) it resolves the wrapped command.
# Does NOT scan arbitrary arguments — `echo claude` won't trigger.
_detect_harness_from_args() {
  local -a argv=("$@")
  [[ ${#argv[@]} -eq 0 ]] && return 1

  # Skip leading passthrough shell keywords and assignment prefixes.
  local start=0
  while [[ $start -lt ${#argv[@]} ]]; do
    local tok
    tok="$(_strip_outer_quotes "${argv[$start]}")"
    if [[ "$tok" == "--" ]]; then
      (( start++ )); continue
    fi
    if [[ "$tok" == "exec" ]]; then
      (( start++ )); continue
    fi
    _is_assignment_token "$tok" && { (( start++ )); continue; }
    break
  done
  [[ $start -ge ${#argv[@]} ]] && return 1

  # Rebuild argv past any exec/assignment prefix
  if [[ $start -gt 0 ]]; then
    argv=("${argv[@]:$start}")
  fi

  local base
  base="$(_strip_outer_quotes "${argv[0]}")"
  base="${base##*/}"
  if is_known_harness "$base"; then
    echo "$base"
    return 0
  fi

  # Shell wrappers execute the argument following a -c-style flag. Resolve
  # that command string here so wrapper recursion (env/nice -> shell) works.
  case "$base" in
    sh|bash|zsh|dash|ksh)
      local shell_i
      for (( shell_i=1; shell_i<${#argv[@]}; shell_i++ )); do
        local shell_tok="${argv[$shell_i]}"
        if [[ "$shell_tok" =~ ^-[A-Za-z]*c[A-Za-z]*$ ]]; then
          local shell_cmd_i=$((shell_i + 1))
          if [[ "$shell_cmd_i" -lt ${#argv[@]} && "${argv[$shell_cmd_i]}" == "--" ]]; then
            (( shell_cmd_i++ ))
          fi
          [[ "$shell_cmd_i" -ge ${#argv[@]} ]] && break
          _shell_split_words "${argv[$shell_cmd_i]}"
          if [[ ${#SHELL_SPLIT_WORDS[@]} -gt 0 ]] && \
             _detect_harness_from_shell_words "${SHELL_SPLIT_WORDS[@]}"; then
            return 0
          fi
          break
        fi
      done
      ;;
  esac

  # Transparent wrappers: the real command is the next positional arg.
  # Skip flags, assignments, and wrapper-specific positional args to find it.
  case "$base" in
    env)
      # env supports KEY=VALUE, flags, and flags-with-values (-u VAR, -S STR).
      local i
      for (( i=1; i<${#argv[@]}; i++ )); do
        local tok
        tok="$(_strip_outer_quotes "${argv[$i]}")"
        if [[ "$tok" == "--" ]]; then
          (( i++ ))
          if [[ $i -lt ${#argv[@]} ]]; then
            if _detect_harness_from_args "${argv[@]:$i}"; then
              return 0
            fi
          fi
          break
        fi
        case "$tok" in -u|--unset|-S|--split-string) (( i++ )); continue ;; esac
        [[ "$tok" == -* ]] && continue
        _is_assignment_token "$tok" && continue
        if _detect_harness_from_args "${argv[@]:$i}"; then
          return 0
        fi
        break
      done
      ;;
    nice|time|timeout|stdbuf|command|ionice|taskset)
      # Wrappers that may take flags-with-values or a positional arg before
      # the real command. Mirror the logic in no-sandbox.js.
      local i consumed_positional=0
      for (( i=1; i<${#argv[@]}; i++ )); do
        local tok
        tok="$(_strip_outer_quotes "${argv[$i]}")"
        if [[ "$tok" == "--" ]]; then
          (( i++ ))
          # timeout and taskset still require their duration/mask positional
          # after the option delimiter.
          if [[ $i -lt ${#argv[@]} && ( "$base" == "timeout" || "$base" == "taskset" ) ]] && \
             _should_consume_wrapper_positional "$base" "$(_strip_outer_quotes "${argv[$i]}")"; then
            (( i++ ))
          fi
          if [[ $i -lt ${#argv[@]} ]]; then
            if _detect_harness_from_args "${argv[@]:$i}"; then
              return 0
            fi
          fi
          break
        fi
        # ionice: -c/--class/--classdata take a value argument
        case "$base" in
          ionice) case "$tok" in -c|--class|--classdata) (( i++ )); continue ;; esac ;;
        esac
        # Common wrapper flags with values (-n, -k, -s, etc.)
        # Note: -p is NOT here — command/time/timeout treat -p as boolean.
        # sudo has its own handling in its dedicated case branch.
        case "$tok" in -n|--adjustment|-k|--kill-after|-s|--signal) (( i++ )); continue ;; esac
        [[ "$tok" == -* ]] && continue
        if [[ "$consumed_positional" -eq 0 ]] && _should_consume_wrapper_positional "$base" "$tok"; then
          consumed_positional=1
          continue
        fi
        if _detect_harness_from_args "${argv[@]:$i}"; then
          return 0
        fi
        break
      done
      ;;
  esac

  return 1
}

# Detect harness in shell command words by scanning each command segment
# separated by shell control operators (&&, ||, ;, |, &, parentheses).
_detect_harness_from_shell_words() {
  local -a words=("$@")
  [[ ${#words[@]} -eq 0 ]] && return 1

  local -a segment=()
  local tok
  for tok in "${words[@]}"; do
    if [[ "$tok" == "&&" || "$tok" == "||" || "$tok" == "|" || "$tok" == ";" || "$tok" == "&" || "$tok" == "(" || "$tok" == ")" ]]; then
      if [[ ${#segment[@]} -gt 0 ]]; then
        if _detect_harness_from_args "${segment[@]}"; then
          return 0
        fi
        segment=()
      fi
      continue
    fi
    segment+=("$tok")
  done

  if [[ ${#segment[@]} -gt 0 ]]; then
    if _detect_harness_from_args "${segment[@]}"; then
      return 0
    fi
  fi
  return 1
}

# Detect harness from COMMAND. Checks direct/wrapper forms, and shell wrappers
# (bash/sh/zsh -c "...") so strict auto-allow works for common launch patterns.
detect_harness() {
  if _detect_harness_from_args "${COMMAND[@]}"; then
    return 0
  fi

  local base="${COMMAND[0]##*/}"
  case "$base" in
    sh|bash|zsh|dash|ksh)
      local i
      for (( i=1; i<${#COMMAND[@]}; i++ )); do
        local tok="${COMMAND[$i]}"
        # Shell command string flag forms: -c, -lc, -ic, etc.
        if [[ "$tok" =~ ^-[A-Za-z]*c[A-Za-z]*$ ]]; then
          local cmd_idx=$((i + 1))
          # Skip optional -- between -c and the command string
          if [[ "$cmd_idx" -lt ${#COMMAND[@]} && "${COMMAND[$cmd_idx]}" == "--" ]]; then
            (( cmd_idx++ ))
          fi
          [[ "$cmd_idx" -ge ${#COMMAND[@]} ]] && break
          local shell_cmd="${COMMAND[$cmd_idx]}"
          _shell_split_words "$shell_cmd"
          if [[ ${#SHELL_SPLIT_WORDS[@]} -gt 0 ]]; then
            if _detect_harness_from_shell_words "${SHELL_SPLIT_WORDS[@]}"; then
              return 0
            fi
          fi
          break
        fi
      done
      ;;
  esac

  return 1
}

# Populate HARNESS_CONFIG_PATHS with a harness's default user config/state paths.
get_harness_config_paths() {
  HARNESS_CONFIG_PATHS=()
  case "$1" in
    opencode)     HARNESS_CONFIG_PATHS=("$HOME/.config/opencode" "$HOME/.local/share/opencode") ;;
    claude)       HARNESS_CONFIG_PATHS=("$HOME/.claude") ;;
    codex)        HARNESS_CONFIG_PATHS=("$HOME/.codex") ;;
    goose)        HARNESS_CONFIG_PATHS=("$HOME/.config/goose") ;;
    gemini)       HARNESS_CONFIG_PATHS=("$HOME/.gemini") ;;
    droid)        HARNESS_CONFIG_PATHS=("$HOME/.factory") ;;
    qwen)         HARNESS_CONFIG_PATHS=("$HOME/.qwen") ;;
    codemux)      HARNESS_CONFIG_PATHS=("$HOME/.codemux" "$HOME/.config/codemux") ;;
    pi)           HARNESS_CONFIG_PATHS=("$HOME/.pi/agent") ;;
    aider)        HARNESS_CONFIG_PATHS=("$HOME/.aider" "$HOME/.aider.conf.yml") ;;
    amp)          HARNESS_CONFIG_PATHS=("$HOME/.config/amp" "$HOME/.amp") ;;
    crush)        HARNESS_CONFIG_PATHS=("$HOME/.config/crush" "$HOME/.local/share/crush") ;;
    cursor-agent) HARNESS_CONFIG_PATHS=("$HOME/.cursor") ;;
    copilot)      HARNESS_CONFIG_PATHS=("$HOME/.copilot" "$HOME/.cache/copilot") ;;
    cn)           HARNESS_CONFIG_PATHS=("$HOME/.continue") ;;
    kimi)         HARNESS_CONFIG_PATHS=("$HOME/.kimi-code" "$HOME/.kimi") ;;
    openhands)    HARNESS_CONFIG_PATHS=("$HOME/.openhands") ;;
    cline)        HARNESS_CONFIG_PATHS=("$HOME/.cline") ;;
    kiro-cli)     HARNESS_CONFIG_PATHS=("$HOME/.kiro") ;;
    auggie)       HARNESS_CONFIG_PATHS=("$HOME/.augment") ;;
    # Environment-controlled config roots are not auto-allowed: GROK_HOME=/
    # must never turn strict mode into a full-filesystem allow. A non-default
    # location requires an explicit --allow from the caller.
    grok)         HARNESS_CONFIG_PATHS=("$HOME/.grok") ;;
    *)            return 1 ;;
  esac
}

_contains_control_character() {
  local LC_ALL=C
  [[ "$1" =~ [[:cntrl:]] ]]
}

# Validate a path is safe for use in sandbox profiles and terminal output.
# NUL bytes cannot exist in bash variables; all other control bytes are rejected.
validate_path() {
  local p="$1"
  if [[ -z "$p" ]]; then
    error "invalid path (empty)"
    exit 1
  fi
  if _contains_control_character "$p"; then
    error "invalid path (contains control characters)"
    exit 1
  fi
}

# Escape a path for safe interpolation into SBPL (sandbox-exec) profiles.
# SBPL strings are "double-quoted"; backslash and double-quote need escaping.
sbpl_escape() {
  local p="$1"
  validate_path "$p"
  p="${p//\\/\\\\}"
  p="${p//\"/\\\"}"
  printf '%s\n' "$p"
}

# Expand ~ and resolve path in the current shell context.
# Used for --cwd, --config, --log, and SCODE_CONFIG.
expand_path() {
  local p="$1"
  validate_path "$p"
  if [[ "$p" =~ ^~(/|$) ]]; then
    p="${HOME}${p:1}"
  fi
  if [[ "$p" != /* ]]; then
    p="${PWD}/${p}"
  fi
  _realpath "$p"
}

# Resolve an output path without following its final component. Log creation
# must be able to replace a pre-existing symlink instead of truncating its target.
expand_output_path() {
  local p="$1"
  validate_path "$p"
  if [[ "$p" =~ ^~(/|$) ]]; then
    p="${HOME}${p:1}"
  fi
  if [[ "$p" != /* ]]; then
    p="${PWD}/${p}"
  fi
  local parent base
  parent="$(_realpath "$(dirname "$p")")"
  base="$(basename "$p")"
  printf '%s/%s\n' "${parent%/}" "$base"
}

# Resolve sandbox access paths (--block/--allow and config blocked/allowed).
# Relative paths are anchored to PROJECT_DIR so results do not depend on caller PWD.
resolve_access_path() {
  local p="$1"
  local base_dir="$2"
  validate_path "$p"
  if [[ "$p" =~ ^~(/|$) ]]; then
    p="${HOME}${p:1}"
  elif [[ "$p" != /* ]]; then
    p="${base_dir}/${p}"
  fi
  p="$(_realpath "$p")"
  normalize_match_path "$p"
}

# Parse a scalar/list YAML value with optional inline comments.
# Rules:
# - Unquoted: strip " <spaces>#comment" and trailing whitespace.
# - Double-quoted: keep literal content (including " # "), allow trailing comment.
# - Single-quoted: keep literal content (including " # "), allow trailing comment.
# Returns non-zero for malformed quoted values.
parse_yaml_value() {
  local raw="$1"
  local double_quoted_re='^"(([^"\\]|\\.)*)"[[:space:]]*(#.*)?$'
  local single_quoted_re="^'(([^']|'')*)'[[:space:]]*(#.*)?$"

  # Keep behavior stable for list parsing where leading whitespace can be present.
  raw="${raw#"${raw%%[![:space:]]*}"}"

  if [[ "$raw" == \"* ]]; then
    if [[ "$raw" =~ $double_quoted_re ]]; then
      printf '%s\n' "${BASH_REMATCH[1]}"
      return 0
    fi
    return 1
  fi

  if [[ "$raw" == \'* ]]; then
    if [[ "$raw" =~ $single_quoted_re ]]; then
      local _sqval="${BASH_REMATCH[1]}"
      _sqval="$(printf '%s' "$_sqval" | /usr/bin/sed "s/''/'/g")"
      printf '%s\n' "$_sqval"
      return 0
    fi
    return 1
  fi

  raw="${raw%%[[:space:]]#*}"
  raw="${raw%"${raw##*[![:space:]]}"}"
  printf '%s\n' "$raw"
}

# Parse YAML config (simple key: value and list parsing).
# Usage: parse_config <file> <prefix>
#   Writes scalars to <PREFIX>_NET, <PREFIX>_STRICT, etc.
#   Appends list items to <PREFIX>_BLOCKED and <PREFIX>_ALLOWED arrays.
# Safety: eval is used below to set dynamic variables (for example,
# CONFIG_NET or PROJECT_STRICT). The prefix is always a hardcoded literal
# ("CONFIG" or "PROJECT") passed by the
# caller, and val/value are validated against fixed sets or path-sanitized.
# No user-controlled data reaches the eval target variable name.
parse_config() {
  local cfg_file="$1"
  local prefix="$2"
  local cfg_fd="${3:-}"
  local cfg_input="$cfg_file"

  if [[ -z "$cfg_fd" && ! -f "${cfg_file}" ]]; then
    return
  fi
  if [[ -n "$cfg_fd" ]]; then
    cfg_input="/dev/fd/${cfg_fd}"
  fi

  local cfg_size
  if [[ -n "$cfg_fd" ]]; then
    cfg_size="$(_stat_field size "$cfg_input")"
  else
    cfg_size="$(/usr/bin/wc -c < "${cfg_file}" | tr -d '[:space:]')"
  fi
  if [[ ! "$cfg_size" =~ ^[0-9]+$ || "$cfg_size" -gt "$MAX_CONFIG_FILE_BYTES" ]]; then
    error "config file exceeds ${MAX_CONFIG_FILE_BYTES} bytes: ${cfg_file}"
    exit 1
  fi

  local current_section=""
  local line_no=0
  while IFS= read -r line || [[ -n "$line" ]]; do
    line_no=$((line_no + 1))
    # Strip trailing carriage return (CRLF files)
    line="${line%$'\r'}"
    [[ "$line" =~ ^[[:space:]]*# ]] && continue
    [[ -z "${line//[[:space:]]/}" ]] && continue

    if [[ "$line" =~ ^[[:space:]]*([a-z_]+):[[:space:]]*(#.*)?$ ]]; then
      current_section="${BASH_REMATCH[1]}"
      case "$current_section" in
        blocked|allowed) ;;
        *)
          error "invalid config at line ${line_no}: unknown section '${current_section}' (${cfg_file})"
          exit 1
          ;;
      esac
      continue
    fi

    # Scalar key: value (e.g., net: off, strict: true)
    # Parsed regardless of current_section so scalars work after list blocks.
    if [[ "$line" =~ ^[[:space:]]*([a-z_]+):[[:space:]]+(.+)$ ]]; then
      local key="${BASH_REMATCH[1]}"
      local val="${BASH_REMATCH[2]}"
      if ! val="$(parse_yaml_value "$val")"; then
        error "invalid config at line ${line_no}: malformed quoted value (${cfg_file})"
        exit 1
      fi
      case "$key" in
        net)
          case "$val" in
            on|off) eval "${prefix}_NET=\"$val\"" ;;
            *) error "invalid config: net: $val (expected 'on' or 'off') (${cfg_file})"; exit 1 ;;
          esac
          ;;
        fs_mode)
          case "$val" in
            rw|ro) eval "${prefix}_FS_MODE=\"$val\"" ;;
            *) error "invalid config: fs_mode: $val (expected 'rw' or 'ro') (${cfg_file})"; exit 1 ;;
          esac
          ;;
        strict)
          case "$val" in
            true|false)
              if [[ "$val" == "true" ]]; then
                eval "${prefix}_STRICT=1"
              else
                eval "${prefix}_STRICT=0"
              fi
              ;;
            *) error "invalid config: strict: $val (expected 'true' or 'false') (${cfg_file})"; exit 1 ;;
          esac
          ;;
        scrub_env)
          case "$val" in
            true|false)
              if [[ "$val" == "true" ]]; then
                eval "${prefix}_SCRUB_ENV=1"
              else
                eval "${prefix}_SCRUB_ENV=0"
              fi
              ;;
            *) error "invalid config: scrub_env: $val (expected 'true' or 'false') (${cfg_file})"; exit 1 ;;
          esac
          ;;
        grok_defense)
          case "$val" in
            true|false)
              if [[ "$val" == "true" ]]; then
                eval "${prefix}_GROK_DEFENSE=1"
              else
                eval "${prefix}_GROK_DEFENSE=0"
              fi
              ;;
            *) error "invalid config: grok_defense: $val (expected 'true' or 'false') (${cfg_file})"; exit 1 ;;
          esac
          ;;
        *)
          error "invalid config at line ${line_no}: unknown key '${key}' (${cfg_file})"
          exit 1
          ;;
      esac
      current_section=""
      continue
    fi

    if [[ "$line" =~ ^[[:space:]]*-[[:space:]]*(.+)$ ]]; then
      if [[ -z "$current_section" ]]; then
        error "invalid config at line ${line_no}: list item outside a section (${cfg_file})"
        exit 1
      fi
      local value="${BASH_REMATCH[1]}"
      # Trim leading whitespace first so comment-only list items are detected.
      value="${value#"${value%%[![:space:]]*}"}"
      if [[ "$value" =~ ^# ]]; then
        value=""
      else
        if [[ "$value" != \"* && "$value" != \'* && "$value" == *[[:space:]]#* ]]; then
          error "invalid config at line ${line_no}: unquoted list item contains ' #' (quote the value to include '#') (${cfg_file})"
          exit 1
        fi
        if ! value="$(parse_yaml_value "$value")"; then
          error "invalid config at line ${line_no}: malformed quoted list item (${cfg_file})"
          exit 1
        fi
      fi
      if [[ -z "$value" ]]; then
        error "invalid config at line ${line_no}: empty list item (${cfg_file})"
        exit 1
      fi
      validate_path "$value"
      # Safe: \$value defers expansion past eval; value is never interpolated during eval.
      # Scalars above are validated against fixed sets before eval.
      case "$current_section" in
        blocked)
          eval "${prefix}_BLOCKED+=(\"\$value\")"
          ;;
        allowed)
          eval "${prefix}_ALLOWED+=(\"\$value\")"
          ;;
      esac
      continue
    fi

    error "invalid config at line ${line_no}: unsupported syntax (${cfg_file})"
    exit 1
  done < "${cfg_input}"
}

# Check whether a path is covered by an allow list.
# Firewall-style behavior: allowing a parent path allows all descendants.
is_allowed_in_list() {
  local check="$1"
  shift
  local a
  for a in "$@"; do
    [[ -z "$a" ]] && continue
    if is_same_or_descendant_path "$check" "$a"; then
      return 0
    fi
  done
  return 1
}

# Any allow (config or CLI)
is_allowed() {
  [[ ${ALL_ALLOWED[0]+_} ]] || return 1
  is_allowed_in_list "$1" "${ALL_ALLOWED[@]}"
}

# CLI allow only (used to keep CLI --block higher precedence than config allows)
is_cli_allowed() {
  [[ ${#RESOLVED_CLI_ALLOWED[@]} -eq 0 ]] && return 1
  is_allowed_in_list "$1" "${RESOLVED_CLI_ALLOWED[@]}"
}

# Scrub sensitive env vars
scrub_env() {
  local scrubbed=()
  local varname pattern
  while IFS= read -r varname; do
    [[ -z "$varname" ]] && continue
    for pattern in "${SCRUB_PATTERNS[@]}"; do
      # shellcheck disable=SC2053
      [[ "$varname" == $pattern ]] || continue
      local already=0 existing
      for existing in "${scrubbed[@]+"${scrubbed[@]}"}"; do
        if [[ "$existing" == "$varname" ]]; then
          already=1
          break
        fi
      done
      if [[ "$already" -eq 0 ]]; then
        scrubbed+=("$varname")
        unset "$varname" 2>/dev/null || true
      fi
      break
    done
  done < <(compgen -e || true)
  if [[ ${#scrubbed[@]} -gt 0 ]]; then
    warning "scrubbed env vars: ${scrubbed[*]}"
  fi
}

# Escape a string for JSON value embedding (no surrounding quotes).
# Handles backslash, double quote, and C0 control characters (U+0001–U+001F)
# as required by RFC 8259 §7. U+0000 (NUL) cannot appear in bash strings.
json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"        # backslash first (before other escapes add backslashes)
  s="${s//\"/\\\"}"        # double quote
  s="${s//$'\n'/\\n}"      # newline
  s="${s//$'\r'/\\r}"      # carriage return
  s="${s//$'\t'/\\t}"      # tab
  s="${s//$'\b'/\\b}"      # backspace
  s="${s//$'\f'/\\f}"      # form feed
  # Remaining C0 controls (0x00-0x1F) that lack short escapes → \uXXXX
  local result="" i ch ord hex
  for (( i=0; i<${#s}; i++ )); do
    ch="${s:i:1}"
    printf -v ord '%d' "'$ch"
    if (( ord >= 0 && ord <= 0x1F )); then
      printf -v hex '\\u%04x' "$ord"
      result+="$hex"
    else
      result+="$ch"
    fi
  done
  printf '%s' "$result"
}

# Escape controls for the human-readable single-line log header without
# otherwise changing ordinary quotes or backslashes.
legacy_log_escape() {
  terminal_escape "$1"
}

# Write a JSON header line to the log file, followed by the legacy comment
# header. The JSON line is prefixed with `#json:` so it's treated as a comment
# by the legacy parser (starts with `#`, not matching any metadata pattern).
# External tools can read it with: head -1 log | sed 's/^#json://' | jq .
#
# Usage: write_log_header_json <log_file> [extra_comment_lines...]
# Expects these globals: REQUESTED_COMMAND[], PROJECT_DIR, ALL_BLOCKED[],
# ALL_BLOCKED_SOURCES[], ALL_ALLOWED[], HARNESS_STRICT_RO[]
write_log_header_json() {
  local log_file="$1"
  shift
  local timestamp command_str command_legacy cwd_str log_dir tmp_log

  timestamp="$(date '+%Y-%m-%dT%H:%M:%S%z')"
  command_str="$(json_escape "${REQUESTED_COMMAND[*]}")"
  command_legacy="$(legacy_log_escape "${REQUESTED_COMMAND[*]}")"
  cwd_str="$(json_escape "${PROJECT_DIR}")"

  log_dir="$(dirname "${log_file}")"
  if ! tmp_log="$(umask 077; mktemp "${log_dir}/.scode-log.XXXXXX")"; then
    error "failed to create log file in: ${log_dir}"
    return 1
  fi

  if ! {
    # JSON header line
    printf '#json:{"version":1,"session":"%s","command":"%s","argv":[' \
      "$timestamp" "$command_str"
    local argv_first=1
    for _arg in "${REQUESTED_COMMAND[@]}"; do
      [[ "$argv_first" -eq 1 ]] && argv_first=0 || printf ','
      printf '"%s"' "$(json_escape "$_arg")"
    done
    printf '],"cwd":"%s"' "$cwd_str"

    # blocked array
    printf ',"blocked":['
    local first=1
    for _i in "${!ALL_BLOCKED[@]}"; do
      [[ "$first" -eq 1 ]] && first=0 || printf ','
      printf '{"source":"%s","path":"%s"}' \
        "$(json_escape "${ALL_BLOCKED_SOURCES[$_i]}")" \
        "$(json_escape "${ALL_BLOCKED[$_i]}")"
    done
    printf ']'

    # allowed array
    printf ',"allowed":['
    first=1
    for _i in "${!ALL_ALLOWED[@]}"; do
      [[ "$first" -eq 1 ]] && first=0 || printf ','
      printf '"%s"' "$(json_escape "${ALL_ALLOWED[$_i]}")"
    done
    for _i in "${!HARNESS_STRICT_RO[@]}"; do
      [[ "$first" -eq 1 ]] && first=0 || printf ','
      printf '"%s"' "$(json_escape "${HARNESS_STRICT_RO[$_i]}")"
    done
    printf ']'

    printf '}\n'

    # Legacy comment header (human-readable, parsed by audit_log/audit_watch)
    echo "# scode session: ${timestamp}"
    echo "# command: ${command_legacy}"
    echo "# cwd: ${PROJECT_DIR}"
    for _i in "${!ALL_BLOCKED[@]}"; do
      echo "# blocked: ${ALL_BLOCKED_SOURCES[$_i]} ${ALL_BLOCKED[$_i]}"
    done
    for _i in "${!ALL_ALLOWED[@]}"; do
      echo "# allowed: ${ALL_ALLOWED[$_i]}"
    done
    for _i in "${!HARNESS_STRICT_RO[@]}"; do
      echo "# allowed: ${HARNESS_STRICT_RO[$_i]}"
    done

    # Extra comment lines (e.g. profile dump, bwrap args)
    for _line in "$@"; do
      echo "$_line"
    done

    echo "#---"
  } > "$tmp_log"; then
    rm -f "$tmp_log"
    error "failed to write log header: ${log_file}"
    return 1
  fi

  if ! chmod 600 "$tmp_log"; then
    rm -f "$tmp_log"
    error "failed to secure log file permissions: ${log_file}"
    return 1
  fi
  # Keep an append descriptor on the exact inode that will become log_file.
  # This removes the path lookup between header installation and stderr
  # streaming, closing the symlink-replacement race against the child process.
  if ! exec 9>>"$tmp_log"; then
    rm -f "$tmp_log"
    error "failed to open log file: ${log_file}"
    return 1
  fi
  # GNU mv uses -T and BSD mv uses -h to replace a destination symlink itself
  # instead of treating its target as the destination.
  if mv -fT "$tmp_log" "$log_file" 2>/dev/null; then
    :
  elif mv -fh "$tmp_log" "$log_file" 2>/dev/null; then
    :
  else
    exec 9>&-
    rm -f "$tmp_log"
    error "failed to install log file: ${log_file}"
    return 1
  fi
  if [[ ! -f "$log_file" || -L "$log_file" ]]; then
    exec 9>&-
    error "log destination changed during installation: ${log_file}"
    return 1
  fi
}

# Extract a denied path from a single log line. Prints the path on match,
# nothing on no match. Shared by audit_log and audit_watch.
_extract_denied_path() {
  local line="$1"
  # macOS sandbox-exec: deny(file-read-data) /path/to/file
  if [[ "$line" =~ deny\(file-[a-z*-]+\)[[:space:]]+(.+) ]]; then
    printf '%s\n' "${BASH_REMATCH[1]}"
  # Generic Unix:
  #   /path/to/file: Permission denied
  #   cat: /path/to/file: Permission denied
  elif [[ "$line" =~ ^(([^:]+):[[:space:]]+)?(.+):[[:space:]]*Permission\ denied$ ]]; then
    printf '%s\n' "${BASH_REMATCH[3]}"
  # Generic Unix:
  #   /path/to/file: Operation not permitted
  #   tool: /path/to/file: Operation not permitted
  elif [[ "$line" =~ ^(([^:]+):[[:space:]]+)?(.+):[[:space:]]*Operation\ not\ permitted$ ]]; then
    printf '%s\n' "${BASH_REMATCH[3]}"
  # Node.js EACCES: permission denied, open '/path/to/file'
  elif [[ "$line" =~ permission\ denied,\ [a-z]+\ \'(.+)\' ]]; then
    printf '%s\n' "${BASH_REMATCH[1]}"
  # Python OSError: Permission denied: '/path/to/file'
  elif [[ "$line" =~ Permission\ denied:\ \'(.+)\' ]]; then
    printf '%s\n' "${BASH_REMATCH[1]}"
  fi
}

# Normalize denied paths for audit categorization:
# - trims surrounding whitespace
# - resolves relative paths against log header "# cwd:" when available
_normalize_denied_path() {
  local path="$1"
  local log_cwd="${2:-}"

  path="${path#"${path%%[![:space:]]*}"}"
  path="${path%"${path##*[![:space:]]}"}"
  [[ -z "$path" ]] && return 1
  _contains_control_character "$path" && return 1

  if [[ "$path" =~ ^~(/|$) ]]; then
    path="${HOME}${path:1}"
  fi
  if [[ "$path" != /* ]]; then
    [[ -n "$log_cwd" && "$log_cwd" == /* ]] || return 1
    if [[ "$path" == ./* ]]; then
      path="${path#./}"
    fi
    path="${log_cwd%/}/${path}"
  fi
  _contains_control_character "$path" && return 1
  _realpath "$path"
}

# Parse denial patterns from a log file, categorize against blocked lists,
# and suggest --allow flags. Uses indexed arrays only (bash 3.2 compat).
# If the log contains "# blocked:" metadata, uses that for categorization
# instead of built-in defaults, enabling policy-aware audit output.
audit_log() {
  local log_file="$1"
  if [[ ! -f "$log_file" ]]; then
    error "log file not found: $log_file"
    return 1
  fi
  if [[ ! -s "$log_file" ]]; then
    error "log file is empty: $log_file"
    return 1
  fi

  # Collect unique denied paths
  local denied_paths=()
  local seen_paths=()
  local line _cwd_candidate _aval

  # Parse "# blocked:" metadata from log header (if present)
  local log_blocked_cats=()
  local log_allowed=()
  local has_log_blocked=0
  local log_cwd=""
  while IFS= read -r line; do
    # Stop scanning at the header delimiter
    [[ "$line" == "#---" ]] && break
    # Stop at first non-comment line
    [[ "$line" != \#* ]] && break
    if [[ "$line" =~ ^#\ cwd:\ (.+)$ ]]; then
      _cwd_candidate="${BASH_REMATCH[1]}"
      if [[ "$_cwd_candidate" == /* ]] && ! _contains_control_character "$_cwd_candidate"; then
        log_cwd="$_cwd_candidate"
      fi
    fi
    if [[ "$line" =~ ^#\ blocked:\ (default|platform|config|project|cli|defense)\ (.+)$ ]]; then
      local src="${BASH_REMATCH[1]}"
      local bpath="${BASH_REMATCH[2]}"
      [[ "$bpath" == /* ]] || continue
      _contains_control_character "$bpath" && continue
      bpath="$(_realpath "$bpath")"
      # Map config/project/cli sources to "custom" category
      local cat="$src"
      if [[ "$src" == "config" || "$src" == "project" || "$src" == "cli" || "$src" == "defense" ]]; then
        cat="custom"
      fi
      log_blocked_cats+=("${cat}:${bpath}")
      has_log_blocked=1
    fi
    if [[ "$line" =~ ^#\ allowed:\ (.+)$ ]]; then
      _aval="${BASH_REMATCH[1]}"
      [[ "$_aval" == /* ]] || continue
      _contains_control_character "$_aval" && continue
      _aval="${_aval%/}"
      _aval="$(_realpath "$_aval")"
      log_allowed+=("$_aval")
    fi
  done < "$log_file"

  while IFS= read -r line; do
    local path=""
    path="$(_extract_denied_path "$line")"

    # Skip empty/invalid paths.
    [[ -z "$path" ]] && continue
    path="$(_normalize_denied_path "$path" "$log_cwd")" || continue

    local already_seen=0
    for s in "${seen_paths[@]+"${seen_paths[@]}"}"; do
      if [[ "$s" == "$path" ]]; then
        already_seen=1
        break
      fi
    done
    [[ "$already_seen" -eq 1 ]] && continue

    seen_paths+=("$path")
    denied_paths+=("$path")
  done < "$log_file"

  if [[ ${#denied_paths[@]} -eq 0 ]]; then
    info "no denial patterns found in $log_file"
    return 0
  fi

  # Build combined blocked list for categorization.
  # If log has "# blocked:" metadata, use it; otherwise fall back to built-in defaults.
  local all_blocked_cats=()
  if [[ "$has_log_blocked" -eq 1 ]]; then
    all_blocked_cats=("${log_blocked_cats[@]}")
  else
    for dir in "${DEFAULT_BLOCKED[@]}"; do
      all_blocked_cats+=("default:$dir")
    done
    if [[ "$PLATFORM" == "darwin" ]]; then
      for dir in "${DARWIN_EXTRA_BLOCKED[@]}"; do
        all_blocked_cats+=("platform:$dir")
      done
    elif [[ "$PLATFORM" == "linux" ]]; then
      for dir in "${LINUX_EXTRA_BLOCKED[@]}"; do
        all_blocked_cats+=("platform:$dir")
      done
    fi
  fi

  # Categorize each denied path
  local cat_default=()
  local cat_custom=()
  local uncategorized=()
  for path in "${denied_paths[@]}"; do
    # Prefer custom policy matches over default/platform matches.
    # Within each class, use the most specific (longest) matching parent.
    local matched_custom=""
    local matched_default_parent=""
    local matched_default_cat=""
    for entry in "${all_blocked_cats[@]}"; do
      local cat="${entry%%:*}"
      local bdir="${entry#*:}"
      if is_same_or_descendant_path "$path" "$bdir"; then
        if [[ "$cat" == "custom" ]]; then
          if [[ -z "$matched_custom" || ${#bdir} -gt ${#matched_custom} ]]; then
            matched_custom="$bdir"
          fi
        else
          if [[ -z "$matched_default_parent" || ${#bdir} -gt ${#matched_default_parent} ]]; then
            matched_default_parent="$bdir"
            matched_default_cat="$cat"
          fi
        fi
      fi
    done

    # If metadata says this path is allowed, do not classify it as blocked by
    # default/platform ancestors. Keep custom-block precedence.
    if [[ "$has_log_blocked" -eq 1 && ${#log_allowed[@]} -gt 0 ]]; then
      if [[ -z "$matched_custom" ]] && is_allowed_in_list "$path" "${log_allowed[@]}"; then
        uncategorized+=("$path")
        continue
      fi
    fi

    if [[ -n "$matched_custom" ]]; then
      cat_custom+=("custom${AUDIT_RECORD_SEPARATOR}${matched_custom}${AUDIT_RECORD_SEPARATOR}${path}")
    elif [[ -n "$matched_default_parent" ]]; then
      cat_default+=("${matched_default_cat}${AUDIT_RECORD_SEPARATOR}${matched_default_parent}${AUDIT_RECORD_SEPARATOR}${path}")
    else
      uncategorized+=("$path")
    fi
  done

  # Print summary
  echo ""
  echo "=== scode audit: ${#denied_paths[@]} unique denied path(s) ==="
  echo ""

  if [[ ${#cat_default[@]} -gt 0 ]]; then
    echo "Blocked by scode defaults:"
    # Group by blocked parent (global dedup, not just adjacent)
    local seen_default_parents=()
    for entry in "${cat_default[@]}"; do
      local cat parent path
      IFS="$AUDIT_RECORD_SEPARATOR" read -r cat parent path <<< "$entry"
      local parent_seen=0
      for s in "${seen_default_parents[@]+"${seen_default_parents[@]}"}"; do
        [[ "$s" == "$parent" ]] && { parent_seen=1; break; }
      done
      if [[ "$parent_seen" -eq 0 ]]; then
        echo "  ${parent} (${cat}):"
        seen_default_parents+=("$parent")
      fi
      echo "    $path"
    done
    echo ""
    echo "Suggested --allow flags:"
    for dir in "${seen_default_parents[@]}"; do
      printf '  --allow %q\n' "$dir"
    done
  fi

  if [[ ${#cat_custom[@]} -gt 0 ]]; then
    echo ""
    echo "Blocked by custom policy:"
    local seen_custom_parents=()
    for entry in "${cat_custom[@]}"; do
      local _category parent path
      IFS="$AUDIT_RECORD_SEPARATOR" read -r _category parent path <<< "$entry"
      local parent_seen=0
      for s in "${seen_custom_parents[@]+"${seen_custom_parents[@]}"}"; do
        [[ "$s" == "$parent" ]] && { parent_seen=1; break; }
      done
      if [[ "$parent_seen" -eq 0 ]]; then
        echo "  ${parent}:"
        seen_custom_parents+=("$parent")
      fi
      echo "    $path"
    done
    # No --allow suggestions for custom-blocked paths — the user blocked them intentionally.
  fi

  if [[ ${#uncategorized[@]} -gt 0 ]]; then
    echo ""
    echo "Not covered by scode defaults (sandbox or OS-level denials):"
    for path in "${uncategorized[@]}"; do
      echo "  $path"
    done
    echo ""
    echo "Suggested --allow flags:"
    for path in "${uncategorized[@]}"; do
      printf '  --allow %q\n' "$path"
    done
  fi

  if [[ ${#uncategorized[@]} -gt 0 ]]; then
    echo ""
    if [[ "$has_log_blocked" -eq 1 ]]; then
      echo "Note: these paths were not in the logged blocked list. They may be"
      echo "OS-level denials or the log metadata may be incomplete."
    else
      echo "Note: audit only considers scode built-in defaults. If you intentionally"
      echo "blocked custom paths (via --block or config), review suggestions carefully."
    fi
  fi

  echo ""
  return 0
}

# Watch a log file for denial patterns in real-time.
# Deduplicates paths across the session; Ctrl-C to stop.
audit_watch() {
  local log_file="$1"
  if [[ ! -f "$log_file" ]]; then
    error "log file not found: $log_file"
    return 1
  fi

  # Snapshot before parsing metadata so a line appended during parsing is not
  # mistaken for pre-existing content and skipped.
  local initial_line_count
  initial_line_count="$(wc -l < "$log_file" | tr -d '[:space:]')"
  [[ "$initial_line_count" =~ ^[0-9]+$ ]] || initial_line_count=0

  # Parse "# cwd:" metadata from log header (same as audit_log).
  local log_cwd=""
  local line
  while IFS= read -r line; do
    [[ "$line" == "#---" ]] && break
    [[ "$line" != \#* ]] && break
    if [[ "$line" =~ ^#\ cwd:\ (.+)$ ]]; then
      log_cwd="${BASH_REMATCH[1]}"
    fi
  done < "$log_file"

  local seen_paths=()
  local count=0
  info "watching $log_file for denial patterns (Ctrl-C to stop)..."
  echo ""

  # Follow only lines appended after the snapshot above. `tail -n 0` has a
  # race between metadata parsing and opening the file; starting at the first
  # post-snapshot line closes that gap. -F follows rotation by name.
  tail -n "+$((initial_line_count + 1))" -F "$log_file" | while IFS= read -r line; do
    local path=""
    path="$(_extract_denied_path "$line")"

    [[ -z "$path" ]] && continue
    path="$(_normalize_denied_path "$path" "$log_cwd")" || continue

    local already_seen=0
    for s in "${seen_paths[@]+"${seen_paths[@]}"}"; do
      if [[ "$s" == "$path" ]]; then
        already_seen=1
        break
      fi
    done
    [[ "$already_seen" -eq 1 ]] && continue

    seen_paths+=("$path")
    count=$((count + 1))
    echo "[${count}] DENIED: ${path}"
  done
}

